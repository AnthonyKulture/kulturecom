---
import type { Lang } from "~/i18n/ui";
import { getAllServicePages } from "~/lib/service-pages";
import CTA from "~/components/CTA.astro";
import { fromPrice } from "~/lib/facts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isFr = lang === "fr";
const services = getAllServicePages(lang);

// "Par où commencer ?" — the visitor picks their situation, not a service
// name; each card leads to the right service page with its starting price.
const l = isFr
  ? {
      h1: "Par où commencer ?",
      lead: "Choisissez la situation qui vous ressemble : je vous montre la bonne formule et son prix.",
      situations: {
        web: "Je n'ai pas de site, ou il ne me ressemble plus",
        seo: "Mon site existe, mais personne ne le trouve",
        apps: "Je perds du temps sur des tâches répétitives",
        brand: "Je lance ou je modernise ma marque",
      } as Record<string, string>,
      unsure: "Vous hésitez ?",
      unsureBody: "Demandez le check-up visibilité IA offert : je regarde où vous en êtes et je vous dis par quoi commencer.",
      unsureCta: "Demander le check-up",
    }
  : {
      h1: "Where to start?",
      lead: "Pick the situation that sounds like you: I'll show you the right package and its price.",
      situations: {
        web: "I have no website, or it no longer looks like me",
        seo: "My website exists, but nobody finds it",
        apps: "I lose time on repetitive tasks",
        brand: "I'm launching or refreshing my brand",
      } as Record<string, string>,
      unsure: "Not sure?",
      unsureBody: "Ask for the free AI visibility check-up: I'll look at where you stand and tell you where to start.",
      unsureCta: "Ask for the check-up",
    };
// Same order as the home doors.
const order = ["seo", "web", "apps", "brand"];
const cards = order.map((id) => services.find((s) => s.id === id)!);
---

<main id="main-content" class="bg-[var(--color-bg)] text-[var(--color-ink)]">

  <section class="px-4 pb-12 pt-24 sm:px-6 md:px-12 md:pb-16 md:pt-32">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <h1 data-vapor class="font-display text-[clamp(34px,4.4vw,60px)] leading-[1.08]">{l.h1}</h1>
      <p class="mt-4 max-w-[56ch] text-[clamp(18px,1.5vw,21px)] leading-[1.5] text-[var(--color-ink-muted)]">{l.lead}</p>
    </div>
  </section>

  <section class="px-4 pb-16 sm:px-6 md:px-12 md:pb-24">
    <div class="mx-auto grid w-full max-w-[var(--container-wide)] gap-4 md:grid-cols-2">
      {cards.map((s) => (
        <a href={s.path} class="hub-card marks group">
          <h2 class="font-display text-[clamp(22px,2vw,28px)] leading-[1.2]">{l.situations[s.id]}</h2>
          <p class="mb-6 mt-3 max-w-[52ch] text-[17px] leading-[1.55] text-[var(--color-ink-muted)]">{s.lead}</p>
          <span class="mt-auto flex items-center justify-between gap-4 border-t border-[var(--color-border)] pt-5">
            <span class="flex flex-col">
              <span class="text-[17px] font-medium">{s.name}</span>
              {fromPrice(s.id, lang) && <span class="text-[16px] font-medium text-[var(--color-accent)]">{fromPrice(s.id, lang)}</span>}
            </span>
            <span aria-hidden="true" class="hub-arrow">→</span>
          </span>
        </a>
      ))}
    </div>
    <div class="mx-auto mt-4 flex w-full max-w-[var(--container-wide)] flex-wrap items-center justify-between gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-shade)] p-6 md:p-8">
      <div class="max-w-[60ch]">
        <h2 class="text-[20px] font-medium">{l.unsure}</h2>
        <p class="mt-1 text-[17px] text-[var(--color-ink-muted)]">{l.unsureBody}</p>
      </div>
      <a href="#contact" data-project-open="checkup" class="btn btn-primary">{l.unsureCta}</a>
    </div>
  </section>

  <CTA lang={lang} />
</main>

<style>
  .hub-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease-power3),
      box-shadow 0.25s var(--ease-power3);
  }
  @media (min-width: 768px) {
    .hub-card {
      padding: 32px;
    }
  }
  .hub-card:hover,
  .hub-card:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    box-shadow: 0 18px 40px -24px rgb(16 37 70 / 0.35);
  }
  .hub-arrow {
    font-size: 22px;
    color: var(--color-accent);
    transition: transform 0.3s var(--ease-power3);
  }
  .hub-card:hover .hub-arrow {
    transform: translateX(4px);
  }
</style>

---
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import { SERVICE_PAGES, getServicePage } from "~/lib/service-pages";
import GoogleRating from "~/components/GoogleRating.astro";
import LakeScene from "~/components/LakeScene.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const contactHref = lang === "fr" ? "/contact/" : "/en/contact/";
const workHref = lang === "fr" ? "/projets/" : "/en/work/";
const servicesHref = lang === "fr" ? "/services/" : "/en/services/";
const aboutHref = lang === "fr" ? "/a-propos/" : "/en/about/";
const blogHref = lang === "fr" ? "/blog/" : "/en/blog/";
const mentionsHref = lang === "fr" ? "/mentions-legales/" : "/en/legal-notice/";
const privacyHref = lang === "fr" ? "/confidentialite/" : "/en/privacy/";

const services = SERVICE_PAGES.map((sp) => ({
  name: getServicePage(sp.id, lang)!.content.name,
  href: sp.path[lang],
}));

const linkedinUrl = "https://www.linkedin.com/in/anthony-profit/";
const instagramUrl = "https://www.instagram.com/antho_profit/";
const behanceUrl = "https://www.behance.net/anthonyprofit";

const currentYear = "2026";
const navLabels = lang === "en"
  ? { projects: "WORK", services: "SERVICES", about: "ABOUT", journal: "GUIDES", contact: "CONTACT" }
  : { projects: "RÉALISATIONS", services: "SERVICES", about: "À PROPOS", journal: "GUIDES", contact: "CONTACT" };
---

<footer
  data-site-footer
  data-surface="tint"
  class="relative overflow-hidden bg-[var(--color-bg)] text-[var(--color-ink)]"
  aria-label="Pied de page"
>
  <div class="relative mx-auto flex w-full max-w-[var(--container-wide)] flex-col px-4 pt-14 sm:px-6 sm:pt-16 md:px-12 md:pt-20">

    {/* TOP ROW — 3 columns: left = contact + year, center = social,
        right = nav. Each item has an inline transition-delay for the
        cascade reveal once `[data-top-revealed]` is set on the footer. */}
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4 font-label text-[13px] uppercase tracking-[0.06em] sm:text-[14px]">

      {/* Left : email + copyright */}
      <div class="flex flex-col gap-1.5">
        <a
          data-footer-top
          style="transition-delay:0ms"
          href={`mailto:${t.footer["contact.email"]}?subject=${encodeURIComponent(t.nav["cta.subject"])}`}
          class="lowercase tracking-[0.05em] text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >{t.footer["contact.email"]}</a>
        <p
          data-footer-top
          style="transition-delay:120ms"
          class="text-[var(--color-ink)]/70"
        >© {currentYear} Anthony Profit · Kulturecom<br />{lang === "fr" ? "Nice, Côte d'Azur" : "Nice, French Riviera"}</p>
        <GoogleRating lang={lang} data-footer-top style="transition-delay:160ms" class="mt-2 text-[var(--color-ink)]" />
        <a
          data-footer-top
          style="transition-delay:200ms"
          href={mentionsHref}
          class="mt-2 text-[var(--color-ink)]/70 no-underline hover:text-[var(--color-ink)] hover:underline underline-offset-4"
        >{t.footer["legal.mentions"]}</a>
        <a
          data-footer-top
          style="transition-delay:260ms"
          href={privacyHref}
          class="text-[var(--color-ink)]/70 no-underline hover:text-[var(--color-ink)] hover:underline underline-offset-4"
        >{t.footer["legal.privacy"]}</a>
      </div>

      {/* Services : the 4 service pages (internal links on every page). */}
      <div class="flex flex-col gap-1.5">
        {services.map((sv, i) => (
          <a
            data-footer-top
            style={`transition-delay:${120 + i * 60}ms`}
            href={sv.href}
            class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
          >{sv.name}</a>
        ))}
      </div>

      {/* Social */}
      <div class="flex flex-col gap-1.5 lg:items-center">
        <a
          data-footer-top
          style="transition-delay:240ms"
          href={instagramUrl}
          rel="noopener"
          target="_blank"
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >INSTAGRAM</a>
        <a
          data-footer-top
          style="transition-delay:360ms"
          href={linkedinUrl}
          rel="noopener"
          target="_blank"
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >LINKEDIN</a>
        <a
          data-footer-top
          style="transition-delay:480ms"
          href={behanceUrl}
          rel="noopener"
          target="_blank"
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >BEHANCE</a>
      </div>

      {/* Right : nav — Work · Services · About · Contact. */}
      <div class="flex flex-col gap-1.5 lg:items-end">
        <a
          data-footer-top
          style="transition-delay:600ms"
          href={workHref}
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >{navLabels.projects}</a>
        <a
          data-footer-top
          style="transition-delay:680ms"
          href={servicesHref}
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >{navLabels.services}</a>
        <a
          data-footer-top
          style="transition-delay:760ms"
          href={aboutHref}
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >{navLabels.about}</a>
        <a
          data-footer-top
          style="transition-delay:820ms"
          href={blogHref}
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >{navLabels.journal}</a>
        <a
          data-footer-top
          style="transition-delay:900ms"
          href={contactHref}
          class="text-[var(--color-ink)] no-underline hover:underline underline-offset-4"
        >{navLabels.contact}</a>
      </div>
    </div>

    <div class="mt-16 md:mt-24" />

    {/* HUGE NAME */}
    <h2 data-footer-name class="relative z-10 flex flex-wrap items-baseline gap-x-[0.25em] font-display text-[clamp(52px,14vw,210px)] leading-[1.05] tracking-[-0.035em]">
      <span>Anthony</span>
      <span class="whitespace-nowrap">Profit</span>
    </h2>
  </div>

  {/* The lake view closes the page, edge to edge; the name sits in its sky. */}
  <div class="-mt-[6vw]">
    <LakeScene />
  </div>
</footer>

<style is:global>
  [data-footer-top] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    will-change: opacity, transform;
  }
  [data-site-footer][data-top-revealed="true"] [data-footer-top] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-footer-top] {
      transform: none !important;
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>

<noscript>
  <style>
    [data-footer-top] { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<script>
  import { vaporType } from "~/lib/vapor-type";

  // IntersectionObserver-driven reveal. Two-stage:
  //   1. footer crosses ~50% visibility   → the name condenses out of vapor
  //      (canvas, see vapor-type.ts; plain text under reduced motion)
  //   2. footer crosses ~70% visibility   → top items cascade reveal
  //      (was 0.95, but the footer is h-[100lvh]; on mobile the visible viewport
  //       is shorter than lvh when the URL bar shows, so 95% was unreachable and
  //       the links never revealed — only the name. 0.7 is reachable everywhere.)
  // No GSAP, no ScrollTrigger, no pin. DOM + CSS + one canvas — no timing conflicts
  // with the rest of the page's GSAP work.
  const footer = document.querySelector<HTMLElement>("[data-site-footer]");
  const name = document.querySelector<HTMLElement>("[data-footer-name]");
  const vapor =
    name && !matchMedia("(prefers-reduced-motion: reduce)").matches
      ? vaporType(name, getComputedStyle(document.documentElement).getPropertyValue("--color-accent"))
      : null;
  if (footer) {
    let nameRevealed = false;
    let topRevealed = false;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const ratio = entry.intersectionRatio;
          if (!nameRevealed && ratio >= 0.5) {
            vapor?.start();
            nameRevealed = true;
          }
          if (!topRevealed && ratio >= 0.7) {
            footer.dataset.topRevealed = "true";
            topRevealed = true;
          }
          if (nameRevealed && topRevealed) {
            observer.disconnect();
          }
        }
      },
      {
        // Many thresholds so the callback fires at every meaningful step.
        threshold: [0, 0.25, 0.5, 0.7, 0.85, 0.95, 1.0],
      }
    );
    observer.observe(footer);
  }
</script>

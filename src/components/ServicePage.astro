---
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import type { ServiceId } from "~/lib/service-pages";
import { getServicePage } from "~/lib/service-pages";
import { getCaseStudy, caseStudyPath } from "~/lib/case-studies";
import CTA from "~/components/CTA.astro";
import Eyebrow from "~/components/Eyebrow.astro";
import ServiceDrawing from "~/components/ServiceDrawing.astro";
import { AREA_SERVED } from "~/lib/schema";
import { getPosts, postPath } from "~/lib/blog";
import { PRICE, formatPrice, fromPrice } from "~/lib/facts";

interface Props {
  lang: Lang;
  id: ServiceId;
}

const { lang, id } = Astro.props;
const t = ui[lang];
const sp = getServicePage(id, lang);
if (!sp) throw new Error(`Unknown service page id: ${id}`);

const c = sp.content;
const isFr = lang === "fr";
const pathname = sp.path[lang];
const canonical = new URL(pathname, Astro.site).toString();
const homeUrl = new URL(isFr ? "/" : "/en/", Astro.site).toString();

// Resolve the featured case studies (proof).
const proof = sp.proofSlugs
  .map((slug) => getCaseStudy(t, slug))
  .filter((x): x is NonNullable<typeof x> => x !== null);

const labels = isFr
  ? {
      breadcrumb: "Fil d'Ariane",
      home: "Accueil",
      place: "Nice et à distance",
      callback: "Être rappelé",
      cta: "Décrire mon projet",
      response: "Réponse sous 48 h",
      delivered: "Livré en",
      offers: "Les formules",
      offersNote: "Prix nets (TVA non applicable), confirmés par écrit avec le délai après un premier échange.",
      offersNoteQuote: "Chaque formule est chiffrée sur mesure après un premier échange, avec le délai, par écrit.",
      delay: "Délai",
      from: "dès",
      choose: "Choisir cette formule",
      onQuote: "Sur devis",
      more: "En savoir plus :",
      guides: "Guides liés",
    }
  : {
      breadcrumb: "Breadcrumb",
      home: "Home",
      place: "Nice and remote",
      callback: "Get a call back",
      cta: "Tell me about your project",
      response: "Reply within 2 business days",
      delivered: "Delivered in",
      offers: "Packages",
      offersNote: "Net prices (no VAT charged), confirmed in writing with the timeline after a first call.",
      offersNoteQuote: "Each package is quoted to measure after a first call, with the timeline, in writing.",
      delay: "Timeline",
      from: "from",
      choose: "Choose this package",
      onQuote: "On quote",
      more: "More about",
      guides: "Related guides",
    };

// Price label of a formula: "390 €", "dès 1 690 €", "dès 490 €/mois".
const offerPrice = (o: (typeof c.offers)[number]): { from: string; amount: string } =>
  o.price
    ? { from: o.from ? labels.from : "", amount: `${formatPrice(PRICE[o.price], lang)}${o.unit ?? ""}` }
    : { from: "", amount: labels.onQuote };
const startingPrice = fromPrice(id, lang);
const sheet = (n: string, fr: string, en: string): string => (isFr ? `Planche ${n} · ${fr}` : `Sheet ${n} · ${en}`);
const h2 = "font-display text-[clamp(26px,2.8vw,40px)] leading-[1.15] text-[var(--color-ink)]";

// Blog articles that support this service (frontmatter `pillar`) — the
// topic-cluster link from the service page down to its guides.
const guides = (await getPosts(lang)).filter((p) => p.data.pillar === id);

// Structured data — Service + FAQPage + 2-level breadcrumb. Joined to the global
// graph (BaseLayout) by @id: the business (#service) provides the service.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      "name": c.name,
      "serviceType": c.name,
      "url": canonical,
      "description": c.lead,
      // The global business entity (BaseLayout, every page) provides the
      // service, and lists it back in its hasOfferCatalog.
      "provider": { "@id": `${Astro.site}#service` },
      "areaServed": AREA_SERVED,
      "isPartOf": { "@id": `${Astro.site}#website` },
      "inLanguage": isFr ? "fr-FR" : "en-US",
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      "inLanguage": isFr ? "fr-FR" : "en-US",
      "mainEntity": c.faq.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": isFr ? "Accueil" : "Home", "item": homeUrl },
        { "@type": "ListItem", "position": 2, "name": c.name, "item": canonical },
      ],
    },
  ],
};
---

<main id="main-content" class="bg-[var(--color-bg)] text-[var(--color-ink)]">

  {/* Funnel: what it is → what you get → what it costs → how it works →
      proof → doubts (FAQ) → contact. The long explanation stays on the page,
      folded under "En savoir plus" (read by search engines and LLMs). */}

  {/* ========== 1. HERO — what it is, price, how to start ========== */}
  <section class="px-4 pb-14 pt-24 sm:px-6 md:px-12 md:pb-20 md:pt-32">
    <div class="mx-auto grid w-full max-w-[var(--container-wide)] gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
      <div class="lg:col-span-7">
      <nav aria-label={labels.breadcrumb} class="text-[15px] text-[var(--color-ink-muted)]">
        <a href={isFr ? "/" : "/en/"} class="underline-offset-4 hover:underline">{labels.home}</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-[var(--color-ink)]">{c.name}</span>
      </nav>
      <h1 class="mt-5 max-w-[20ch] font-display text-[clamp(34px,4.4vw,60px)] leading-[1.08] text-balance">
        {c.h1Lines.map((line, i) => (
          <span class:list={[i > 0 && "text-[var(--color-ink-muted)]"]}>{line}{i < c.h1Lines.length - 1 ? " " : ""}</span>
        ))}
      </h1>
      <p class="mt-5 max-w-[56ch] text-[clamp(18px,1.5vw,21px)] leading-[1.5] text-[var(--color-ink-muted)]">
        {c.lead}
      </p>
      <ul class="mt-7 flex flex-wrap gap-2 text-[15px]" aria-label={labels.offers}>
        {startingPrice && <li class="fact fact--accent">{startingPrice}</li>}
        <li class="fact">{labels.delivered} {c.offers[0].delay}</li>
        <li class="fact">{labels.response}</li>
        <li class="fact">{labels.place}</li>
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="#contact" class="group btn btn-primary">
          {labels.cta}
          <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-1">→</span>
        </a>
        <button type="button" data-callback-open class="text-[16px] font-medium text-[var(--color-ink)] underline underline-offset-4 hover:text-[var(--color-accent)]">
          {labels.callback}
        </button>
      </div>
      </div>
      <figure class="marks mx-auto w-full max-w-[420px] lg:col-span-5 lg:max-w-none">
        <ServiceDrawing id={id} lang={lang} />
      </figure>
    </div>
  </section>

  {/* ========== 2. WHAT YOU GET ========== */}
  <section class="px-4 py-16 sm:px-6 md:px-12 md:py-24">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={sheet("01", "Livrables", "Deliverables")} class="mb-6 md:mb-8" />
      <h2 class={h2}>{c.includesTitle}</h2>
      <ul class="mt-8 grid gap-x-12 gap-y-4 sm:grid-cols-2 md:mt-10">
        {c.includes.map((item) => (
          <li class="flex items-start gap-3 text-[17px] leading-[1.5] md:text-[18px]">
            <span aria-hidden="true" class="check"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ========== 3. PACKAGES — the decision point ========== */}
  <section data-surface="tint" class="bg-[var(--color-bg)] px-4 py-16 sm:px-6 md:px-12 md:py-24">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={sheet("02", "Formules", "Packages")} class="mb-6 md:mb-8" />
      <h2 class={h2}>{labels.offers}</h2>
      <p class="mt-3 max-w-[60ch] text-[16px] text-[var(--color-ink-muted)]">{c.offers.some((o) => o.price) ? labels.offersNote : labels.offersNoteQuote}</p>
      <div class:list={["mt-8 grid gap-4 md:mt-10", c.offers.length > 2 ? "lg:grid-cols-3" : "md:grid-cols-2"]}>
        {c.offers.map((o) => {
          const price = offerPrice(o);
          return (
            <article class="offer marks">
              <h3 class="text-[20px] font-medium leading-snug md:text-[22px]">{o.name}</h3>
              <p class="mt-3 flex items-baseline gap-2">
                {price.from && <span class="text-[16px] text-[var(--color-ink-muted)]">{price.from}</span>}
                <span class="font-display text-[clamp(32px,3vw,40px)] leading-none text-[var(--color-accent)]">{price.amount}</span>
              </p>
              <p class="mt-2 text-[15px] text-[var(--color-ink-muted)]">{labels.delay} : {o.delay}</p>
              <ul class="mt-5 flex flex-col gap-2.5 border-t border-[var(--color-border)] pt-5">
                {o.items.map((it) => (
                  <li class="flex items-start gap-3 text-[16px] leading-[1.45]">
                    <span aria-hidden="true" class="check"></span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
              <a href="#contact" data-need={id} class="btn btn-secondary mt-6 self-start">{labels.choose}</a>
            </article>
          );
        })}
      </div>
      {c.offersPerk && (
        <p class="offers-perk">
          <span aria-hidden="true" class="sheet-diamond"></span>
          {c.offersPerk}
        </p>
      )}
    </div>
  </section>

  {/* ========== 4. HOW IT WORKS ========== */}
  <section class="px-4 py-16 sm:px-6 md:px-12 md:py-24">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={sheet("03", "Méthode", "Method")} class="mb-6 md:mb-8" />
      <h2 class={h2}>{c.methodTitle}</h2>
      <ol class="mt-8 grid gap-8 sm:grid-cols-2 md:mt-10 lg:grid-cols-4 lg:gap-6">
        {c.method.map((step) => (
          <li class="border-t-2 border-[var(--color-accent)] pt-5">
            <span class="font-display text-[18px] text-[var(--color-accent)]">{step.n}</span>
            <h3 class="mt-2 text-[19px] font-medium leading-snug md:text-[20px]">{step.title}</h3>
            <p class="mt-2 text-[16px] leading-[1.55] text-[var(--color-ink-muted)]">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ========== 5. PROOF — featured case studies ========== */}
  <section class="px-4 py-16 sm:px-6 md:px-12 md:py-24">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={sheet("04", "Références", "References")} class="mb-6 md:mb-8" />
      <h2 class={h2}>{c.proofTitle}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3 sm:gap-5 md:mt-10">
        {proof.map((p) => (
          <a href={caseStudyPath(p.slug, lang)} class="marks group flex flex-col no-underline">
            <div class="relative aspect-[4/3] overflow-hidden rounded-[var(--radius-card)] bg-[var(--color-bg-shade)]">
              <img
                src={p.image}
                alt={`${p.title} : ${p.headline}`}
                width="500"
                height="375"
                loading="lazy"
                class="absolute inset-0 block h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              />
            </div>
            <h3 class="mt-4 text-[19px] font-medium text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">
              {p.title}
            </h3>
            <span class="mt-1 text-[15px] text-[var(--color-ink-muted)]">{p.headline}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ========== 6. FAQ — questions visible, answers on demand ========== */}
  <section data-surface="tint" class="bg-[var(--color-bg)] px-4 py-16 sm:px-6 md:px-12 md:py-24">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={sheet("05", "Questions", "Questions")} class="mb-6 md:mb-8" />
    </div>
    <div class="mx-auto grid w-full max-w-[var(--container-wide)] gap-8 md:grid-cols-12 md:gap-10">
      <h2 class:list={[h2, "md:col-span-4"]}>{c.faqTitle}</h2>
      <div class="md:col-span-8">
        {c.faq.map((f) => (
          <details class="qa">
            <summary>
              <h3 class="text-[18px] font-medium leading-snug md:text-[19px]">{f.q}</h3>
              <span class="qa-icon" aria-hidden="true"></span>
            </summary>
            <p class="max-w-[65ch] pb-6 text-[17px] leading-[1.6] text-[var(--color-ink-muted)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ========== 7. MORE — full explanation (folded), guides, other services ========== */}
  <section class="px-4 pt-16 sm:px-6 md:px-12 md:pt-20">
    <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-10">
      <details class="more">
        <summary class="text-[18px] font-medium">
          {labels.more} {c.name}
          <span class="qa-icon" aria-hidden="true"></span>
        </summary>
        <div class="mt-5 max-w-[65ch] space-y-5 text-[17px] leading-[1.65] md:text-[18px]">
          {c.intro.map((p) => <p>{p}</p>)}
        </div>
      </details>

      {guides.length > 0 && (
        <div>
          <h2 class="text-[22px] font-medium">{labels.guides}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {guides.map((g) => (
              <li>
                <a href={postPath(g)} class="link-card group">
                  <span class="text-[17px] font-medium leading-snug">{g.data.title}</span>
                  <span aria-hidden="true" class="text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h2 class="text-[22px] font-medium">{c.relatedTitle}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-3">
          {sp.related.map((r) => (
            <li>
              <a href={r.path} class="link-card group">
                <span class="flex flex-col">
                  <span class="text-[18px] font-medium">{r.name}</span>
                  {fromPrice(r.id, lang) && <span class="text-[15px] text-[var(--color-ink-muted)]">{fromPrice(r.id, lang)}</span>}
                </span>
                <span aria-hidden="true" class="text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* Contact — the form opens on the budget step, need pre-selected. */}
  <CTA lang={lang} need={id} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</main>

<style>
  .fact {
    padding: 7px 14px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .fact--accent {
    border-color: transparent;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    font-weight: 500;
  }
  /* Check mark drawn with borders (no icon font). */
  .check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 0.2em;
    border-radius: 0;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    position: relative;
  }
  .check::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 3.5px;
    width: 5px;
    height: 9px;
    border: solid var(--color-accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .offer {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .offer {
      padding: 28px;
    }
  }
  /* "Offert avec votre site": a ruled note under the packages, accent diamond. */
  .offers-perk {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 16px;
    padding: 16px 20px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: color-mix(in srgb, var(--color-accent) 5%, #ffffff);
    font-size: 17px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--color-ink);
  }
  .offers-perk .sheet-diamond {
    color: var(--color-accent);
    background: currentColor;
    transform: translateY(-1px) rotate(45deg);
  }
  .qa {
    border-bottom: 1px solid var(--color-border);
  }
  .qa summary,
  .more summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
  }
  .more summary {
    justify-content: flex-start;
    padding: 0;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .qa summary::-webkit-details-marker,
  .more summary::-webkit-details-marker {
    display: none;
  }
  .qa-icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-top: 6px;
  }
  .qa-icon::before,
  .qa-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-power3);
  }
  .qa-icon::after {
    transform: rotate(90deg);
  }
  details[open] > summary .qa-icon::after {
    transform: rotate(0deg);
  }
  .link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-power3);
  }
  .link-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }
</style>

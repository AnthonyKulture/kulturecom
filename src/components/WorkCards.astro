---
// Recent work as cards, images always in view: the first project large, the
// four others in a 2×2 beside it (wide screens), each with its name and its
// result under the image. Hovering only zooms the image a little inside its
// frame: nothing moves, wherever the pointer comes in. The home's entrance
// (HomeSections.astro) wipes each image up and brings its caption in.
// Phones: four projects, one under the other. In the page with the home's
// sequences, each card comes in as it comes onto the screen.
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import { caseStudyPath } from "~/lib/case-studies";
import { getProjects } from "~/lib/projects-data";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = getProjects(ui[lang]);
---

<ol class="cards" data-cards>
  {projects.map((p, i) => (
    <li class:list={["card", i === 0 && "card--lead"]} style={`--i:${i}`} data-card>
      <a href={caseStudyPath(p.slug, lang)} class="card-link">
        <span class="card-media" data-card-media>
          <img src={p.image} alt="" loading="lazy" decoding="async" width="800" height="1000" />
        </span>
        <span class="card-text" data-card-text>
          <span class="card-num font-label text-small" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="card-title font-display">{p.title}</span>
          {i === 0 && <span class="card-desc text-body">{p.summary}</span>}
          <span class="card-meta font-label text-small uppercase tracking-[0.06em]">{p.metric}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
  }
  .card--lead {
    grid-column: 1 / -1;
  }
  @media (min-width: 1024px) {
    /* The lead card down the left, the others two by two on the right; the
       rows share what height the section gives them. */
    .cards {
      height: 100%;
      grid-template-columns: 1.15fr 1fr 1fr;
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
    }
    .card--lead {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
  .card {
    min-height: 0;
  }
  .card-link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: var(--color-ink);
    text-decoration: none;
  }
  .card-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .card--lead .card-media {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 1024px) {
    .card-media,
    .card--lead .card-media {
      flex: 1 1 0;
      min-height: 0;
      aspect-ratio: auto;
    }
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.9s var(--ease-power3);
  }
  .card-link:hover .card-media img,
  .card-link:focus-visible .card-media img {
    scale: 1.04;
  }
  .card-text {
    display: grid;
    gap: 4px;
    padding-top: 12px;
  }
  .card-title {
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.25;
  }
  .card--lead .card-title {
    font-size: var(--text-title);
    line-height: 1.1;
  }
  .card-desc {
    max-width: 44ch;
    color: var(--color-ink-muted);
  }
  .card-meta {
    color: var(--color-ink-muted);
    overflow-wrap: anywhere; /* long domain names stay in their column */
  }
  .card-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }
  .card-num {
    display: none;
  }
  @media (max-width: 767px) {
    /* One under the other, four of them. */
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .card:nth-child(n + 5) {
      display: none;
    }
    .card-media,
    .card--lead .card-media {
      aspect-ratio: 16 / 10;
    }
    .card-text {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 10px;
      padding-top: 10px;
    }
    .card-num {
      display: block;
      grid-row: span 2;
      padding-top: 0.15em;
      color: var(--color-ink-muted);
    }
    .card-title,
    .card--lead .card-title {
      font-size: var(--text-body);
      font-weight: 500;
      line-height: 1.25;
    }
    .card-desc {
      display: none;
    }
    /* The result on one line. */
    .card-meta {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
  /* In the page with the home's sequences (data-wait), each card comes in
     as it slides onto the screen (the home's script marks it data-in): its
     image wipes up out of a zoom, its caption rises after it; it goes back
     the same way below the screen. */
  .cards[data-wait] .card-media {
    transition: clip-path 0.9s var(--ease-power3);
  }
  .cards[data-wait] .card-media img {
    transition:
      scale 1.1s var(--ease-power3),
      opacity 0.6s var(--ease-power3);
  }
  .cards[data-wait] .card-text {
    transition:
      opacity 0.7s var(--ease-power3) 0.18s,
      translate 0.7s var(--ease-power3) 0.18s;
  }
  .cards[data-wait] .card:not([data-in]) .card-media {
    clip-path: inset(100% 0 0 0);
  }
  .cards[data-wait] .card:not([data-in]) .card-media img {
    scale: 1.18;
  }
  .cards[data-wait] .card:not([data-in]) .card-text {
    opacity: 0;
    translate: 0 12px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card-media img {
      transition: none;
    }
  }
</style>

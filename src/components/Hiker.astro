---
// The hiker who stands for me in the illustrations, seen from behind: legs,
// arms (a trekking pole in the right hand), jacket, head, then the backpack
// with its rolled mat over it all. Drawn in figure units, feet at the origin,
// about 95 tall: the parent places and scales it, and sets --k to keep the
// ink weight even when it is drawn bigger.
// `gait` picks the loop, which only runs once the parent svg has [data-live]:
// walking (the hero) or standing still, breathing.
interface Props {
  gait: "walk" | "stand";
}

const { gait } = Astro.props;
---

<g class="hiker" data-gait={gait}>
  <g class="hk-sway">
    <g class="hk">
      <g class="hk-leg hk-leg--l">
        <path class="hk-fill" d="M-9.5 -41C-9.8 -30 -9 -18 -8.4 -7.5L-3.4 -7.5C-3 -18 -2.4 -30 -1.2 -41Z" />
        <path class="hk-fill" d="M-9.2 -8.5L-2.8 -8.5C-2.4 -5 -2 -2.5 -2.2 -1C-5 0.6 -8.4 0.6 -10.4 -0.6C-10.2 -3 -9.6 -5.5 -9.2 -8.5Z" />
      </g>
      <g class="hk-leg hk-leg--r">
        <path class="hk-fill" d="M9.5 -41C9.8 -30 9 -18 8.4 -7.5L3.4 -7.5C3 -18 2.4 -30 1.2 -41Z" />
        <path class="hk-fill" d="M9.2 -8.5L2.8 -8.5C2.4 -5 2 -2.5 2.2 -1C5 0.6 8.4 0.6 10.4 -0.6C10.2 -3 9.6 -5.5 9.2 -8.5Z" />
      </g>
      <g class="hk-arm hk-arm--l">
        <path class="hk-tube" d="M-10 -69C-14 -63 -15.2 -55 -14.6 -47" />
        <path class="hk-tube-in" d="M-10 -69C-14 -63 -15.2 -55 -14.6 -47" />
        <circle class="hk-fill" cx="-14.6" cy="-45.2" r="2.3" />
      </g>
      <g class="hk-arm hk-arm--r">
        <path class="hk-line" d="M14.8 -47.5L19.6 0.5" />
        <path class="hk-tube" d="M10 -69C14 -63 15.2 -55 14.6 -47" />
        <path class="hk-tube-in" d="M10 -69C14 -63 15.2 -55 14.6 -47" />
        <circle class="hk-fill" cx="14.6" cy="-45.2" r="2.3" />
      </g>
      <path class="hk-fill" d="M-11.4 -43C-12.4 -52 -12.2 -62 -10 -71C-6 -73.5 6 -73.5 10 -71C12.2 -62 12.4 -52 11.4 -43C4 -40.6 -4 -40.6 -11.4 -43Z" />
      <circle class="hk-fill" cx="0" cy="-87.5" r="6.2" />
      <path class="hk-line" d="M-6 -88.4C-5.6 -94.8 5.6 -94.8 6 -88.4M-3.6 -92.6l-1 2.4M0 -93.6v2.6M3.6 -92.6l1 2.4M-6.1 -87.2q-1.7 0.4 -0.5 2.7M6.1 -87.2q1.7 0.4 0.5 2.7" />
      <path class="hk-fill" d="M-12.4 -47.5C-13.2 -56 -13.4 -68 -12 -76C-11.2 -80.5 -7 -82 0 -82C7 -82 11.2 -80.5 12 -76C13.4 -68 13.2 -56 12.4 -47.5C5 -45 -5 -45 -12.4 -47.5Z" />
      <path class="hk-fill" d="M-11 -86.4h22a3.3 3.3 0 0 1 0 6.6h-22a3.3 3.3 0 0 1 0 -6.6Z" />
      <path class="hk-fill" d="M12.4 -59.5h3.2v10.5q0 1.4 -1.4 1.4h-1.8Z" />
      <path class="hk-line" d="M-6 -86.4v6.6M6 -86.4v6.6M-11.6 -73C-6 -76 6 -76 11.6 -73M-7.6 -63h15.2v10q0 2 -2 2h-11.2q-2 0 -2 -2ZM-1.6 -63v3.2h3.2v-3.2M-9.2 -80.2C-10.8 -78 -11.6 -75 -11.2 -71M9.2 -80.2C10.8 -78 11.6 -75 11.2 -71M-12.9 -60.5h-1.8" />
    </g>
  </g>
</g>

<style>
  /* White shapes outlined in ink; arms are ink tubes with a white core. */
  .hk-fill {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: calc(1.15px * var(--k, 1));
    stroke-linejoin: round;
  }
  .hk-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: calc(1px * var(--k, 1));
    stroke-linecap: round;
  }
  .hk-tube {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 5.2;
    stroke-linecap: round;
  }
  .hk-tube-in {
    fill: none;
    stroke: var(--color-bg);
    stroke-width: calc(5.2px - 2.2px * var(--k, 1));
    stroke-linecap: round;
  }

  .hk,
  .hk-sway,
  .hk-leg,
  .hk-arm {
    transform-box: fill-box;
  }
  .hk-leg,
  .hk-arm {
    transform-origin: 50% 0;
  }

  /* Walking. */
  :global([data-live]) .hiker[data-gait="walk"] .hk {
    animation: hk-bob 0.55s ease-in-out infinite;
  }
  :global([data-live]) .hiker[data-gait="walk"] .hk-sway {
    animation: hk-sway 1.1s ease-in-out infinite;
  }
  :global([data-live]) .hiker[data-gait="walk"] .hk-leg {
    animation: hk-step 1.1s ease-in-out infinite;
  }
  :global([data-live]) .hiker[data-gait="walk"] .hk-leg--r {
    animation-delay: -0.55s;
  }
  :global([data-live]) .hiker[data-gait="walk"] .hk-arm {
    animation: hk-swing 1.1s ease-in-out infinite;
  }
  :global([data-live]) .hiker[data-gait="walk"] .hk-arm--l {
    animation-delay: -0.55s;
  }

  /* Standing still: slow breaths (rising from the feet) and a slight sway. */
  .hiker[data-gait="stand"] .hk {
    transform-origin: 50% 100%;
  }
  :global([data-live]) .hiker[data-gait="stand"] .hk {
    animation: hk-breathe 4.2s ease-in-out infinite;
  }
  :global([data-live]) .hiker[data-gait="stand"] .hk-sway {
    animation: hk-sway 7s ease-in-out infinite;
  }

  @keyframes hk-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-1.4px);
    }
  }
  /* Seen from behind, a step reads as the leg shortening (foot lifted, knee
     bent) then landing. */
  @keyframes hk-step {
    0%,
    55%,
    100% {
      transform: scaleY(1);
    }
    25% {
      transform: scaleY(0.8) translateX(0.8px);
    }
  }
  @keyframes hk-swing {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(6deg);
    }
  }
  /* Weight shifting from one leg to the other. */
  @keyframes hk-sway {
    0%,
    100% {
      transform: translateX(-0.9px) rotate(-0.6deg);
    }
    50% {
      transform: translateX(0.9px) rotate(0.6deg);
    }
  }
  @keyframes hk-breathe {
    0%,
    100% {
      transform: scaleY(1);
    }
    45% {
      transform: scaleY(1.012);
    }
  }
</style>

---
// The hero scene in dots (hero-scene.ts world, hero-halftone.ts tones), drawn
// over the whole hero and filmed by a camera (camera.ts). At rest the camera
// frames the scene in the drawing's place (the .hero-visual box); as the page
// scrolls through the theatre (home-seq.ts plays the dive), the title and
// logos clear away, the frame opens to the whole screen and the camera dives
// into the hiker's backpack until it fills the screen. Section 2 starts from
// that same backpack (WaterfallDots.astro). Still frame in its box under
// reduced motion.
---

<canvas class="hero-dots" data-hero-dots data-intro-item style="--i:4" aria-hidden="true"></canvas>

<script>
  import { PACK, boxIn, clamp01, film, frame, lerpBox, smooth, type Box } from "~/lib/camera";
  import type { HikerState } from "~/lib/halftone-ink";
  import { runDots } from "~/lib/halftone";
  import { drawHeroTone } from "~/lib/hero-halftone";
  import { CX, FEET_Y, VIEW, advance, createScene } from "~/lib/hero-scene";
  import { scenes } from "~/lib/home-seq";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-dots]");
  const stage = canvas?.closest<HTMLElement>("[data-home-hero]");
  const visual = stage?.querySelector<HTMLElement>(".hero-visual");
  const fading = stage ? [...stage.querySelectorAll<HTMLElement>("[data-hero-fade]")] : [];
  if (canvas && stage && visual) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Style writes only when a value changes.
    const last = new Map<HTMLElement, string>();
    const set = (el: HTMLElement, opacity: string, transform: string, events: string): void => {
      const key = `${opacity}|${transform}|${events}`;
      if (last.get(el) === key) return;
      last.set(el, key);
      el.style.opacity = opacity;
      el.style.transform = transform;
      el.style.pointerEvents = events;
    };

    const scene = createScene();
    const hiker: HikerState = { x: CX, y: FEET_Y, s: 1.3, phase: 0, amp: still ? 0 : 1, masked: false };
    const focus = { x: CX, y: FEET_Y + PACK.y * hiker.s };
    let pace = 1;
    let q = 0; // the dive (home-seq.ts plays it)
    // Measured with the layout (home-seq.ts), in the canvas' terms: the
    // drawing's place at rest, and the screen (the theatre's box).
    let measured = false;
    let rest: Box = { x: 0, y: 0, w: 0, h: 0 };
    let screen: Box = rest;
    let wide = false;
    // The frame opens to the whole screen.
    const opening = (): { open: number; box: Box } => {
      const open = smooth(0.04, 0.36, q);
      return { open, box: lerpBox(rest, screen, open) };
    };

    const dots = runDots(
      canvas,
      VIEW,
      (tone, cols, rows, dt, px) => {
        if (!measured) return false;
        const { open, box } = opening();
        // The camera goes into the pack, faster and faster, filling the screen
        // only at the very end: the cut to section 2 is a flash.
        const dive = clamp01((q - 0.24) / 0.76) ** 1.6;

        // He stops walking as the camera comes up to him; the world stops with him.
        pace += (1 - smooth(0.04, 0.3, q) - pace) * Math.min(1, dt * 6);
        advance(scene, dt, pace);
        hiker.phase += dt / 1.1;
        hiker.amp = still ? 0 : 1 - smooth(0.16, 0.42, q);

        film(tone, VIEW, box, PACK.dive ** dive, focus, smooth(0.24, 0.7, q), screen, px);
        drawHeroTone(tone, scene, hiker, cols, rows);
        // At rest the drawing melts into the page on its edges (left on wide
        // screens), as its frame did; the edges go as the frame opens.
        const edges = 1 - open;
        frame(tone, box, { left: wide ? 0.24 * edges : 0, top: 0.12 * edges, bottom: 0.14 * edges }, px, cols, rows);
        return { x: box.x * px, y: box.y * px, w: box.w * px, h: box.h * px }; // only the frame holds dots
      },
      still,
      2, // as fine on phones as on wide screens: coarser, the drawing no longer reads
      true,
    );

    scenes.hero = {
      el: stage,
      measure(m) {
        rest = boxIn(visual, stage.getBoundingClientRect());
        screen = { x: 0, y: 0, w: m.vw, h: m.vh };
        wide = m.wide;
        measured = true;
      },
      apply(v) {
        q = v;
        // Title and logos fade as they're pushed away, out to the left: as far
        // as the opening frame's edge goes (on phones, where it opens upward
        // and downward, a third of the screen's width).
        const clear = smooth(0.06, 0.3, q);
        const { open, box } = opening();
        const push = wide ? rest.x - box.x : open * screen.w * 0.34;
        for (const el of fading) {
          set(
            el,
            clear ? (1 - clear).toFixed(3) : "",
            push > 0.5 ? `translateX(${(-push).toFixed(1)}px)` : "",
            clear > 0.5 ? "none" : "",
          );
        }
      },
      draw: dots.draw,
      dots,
    };
  }
</script>

<style>
  .hero-dots {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-accent); /* the dots' ink */
    pointer-events: none;
  }
  /* In the theatre (HomeContent.astro) the hero only reaches the foot of the
     screen with its toolbars showing; the dots run on to its full height, so
     they cover the whole theatre whatever the toolbars do. */
  :global([data-theatre-wrap][data-seq="on"]) .hero-dots {
    bottom: auto;
    height: 100vh;
    height: 100lvh;
  }
</style>

---
import type { Lang } from "~/i18n/ui";
import { getFormContent } from "~/lib/home-content";
import { CONTACT } from "~/lib/facts";
import Eyebrow from "~/components/Eyebrow.astro";
import GoogleRating from "~/components/GoogleRating.astro";

interface Props {
  lang: Lang;
  // h2 under a page's own h1; h1 on the standalone /contact/ page. Same
  // classes, only the semantic tag differs.
  headingLevel?: 1 | 2;
  // Pre-selected need (a service page passes its id): the form then opens on
  // the contact step, one click shorter.
  need?: string;
}

const { lang, headingLevel = 2, need } = Astro.props;
const f = getFormContent(lang);
const Heading = `h${headingLevel}` as "h1" | "h2";

const mailtoHref = `mailto:${CONTACT.email}?subject=${encodeURIComponent(f.mailSubject)}`;
const whatsappHref = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(f.whatsappMessage)}`;

// Strings the client script needs (labels for the prefilled fallback message,
// validation errors, step counter).
const clientStrings = {
  step: f.step,
  sending: f.sending,
  submit: f.submit,
  invalid: f.invalid,
  needs: Object.fromEntries(f.needs.map((n) => [n.value, n.label])),
  labels: { name: f.name, email: f.email, phone: f.phone, message: f.message },
  mailSubject: f.mailSubject,
  email: CONTACT.email,
  whatsapp: CONTACT.whatsapp,
  whatsappMessage: f.whatsappMessage,
};
---

<section
  id="contact"
  data-cta
  class="relative scroll-mt-16 bg-[var(--color-bg)] px-4 py-20 text-[var(--color-ink)] sm:px-6 md:px-12 md:py-28"
  aria-labelledby="contact-title"
>
  <div class="mx-auto w-full max-w-[var(--container-wide)]">
    <Eyebrow label={lang === "fr" ? "Dernière planche · Contact" : "Last sheet · Contact"} class="mb-8 md:mb-10" />
  </div>
  {/* 30 / 70: the form gets most of the width. */}
  <div class="mx-auto grid w-full max-w-[var(--container-wide)] gap-10 lg:grid-cols-[3fr_7fr] lg:gap-14">
    <div>
      <Heading id="contact-title" class="cta-in font-display text-title text-[var(--color-ink)]" style="--i:0">
        <span class="block">{f.title[0]}</span>
        <span class="block text-[var(--color-ink-muted)]">{f.title[1]}</span>
      </Heading>
      <div class="cta-in" style="--i:1">
        <GoogleRating lang={lang} class="mt-5 text-small text-[var(--color-ink)]" />
      </div>

      <div class="cta-in mt-8 hidden flex-col gap-3 lg:flex" style="--i:2">
        <p class="font-label text-small uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">{f.orWrite}</p>
        <a href={mailtoHref} class="alt-contact">{f.emailLabel} <span>{CONTACT.email}</span></a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="alt-contact">{f.whatsappLabel} <span>{CONTACT.phoneDisplay}</span></a>
        <button type="button" data-callback-open class="alt-contact text-left">{f.callbackLabel} <span aria-hidden="true">→</span></button>
      </div>
    </div>

    <div class="cta-in" style="--i:1">
      <form
        data-lead-form
        data-need={need}
        action="/api/lead"
        method="post"
        novalidate
        class="lead-form"
        data-strings={JSON.stringify(clientStrings)}
      >
        <input type="hidden" name="type" value="project" />
        <input type="hidden" name="lang" value={lang} />
        {/* Honeypot — invisible to people, filled by naive bots. */}
        <div class="lf-hp" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="lf-head">
          <span data-lf-count class="font-label text-small uppercase tracking-[0.06em]">{f.step} 1/2</span>
          <span class="lf-bar" aria-hidden="true"><span data-lf-bar></span></span>
          <button type="button" data-lf-back class="lf-back" hidden>{f.back}</button>
        </div>

        <fieldset data-step="1" class="lf-step">
          <legend class="lf-q">{f.needQ}</legend>
          <div class="lf-chips">
            {f.needs.map((n, i) => (
              <label class="lf-chip" style={`--n:${i}`}>
                <input type="radio" name="need" value={n.value} checked={need === n.value} />
                <span>{n.label}</span>
              </label>
            ))}
          </div>
          <button type="button" data-lf-next class="lf-next">OK <span aria-hidden="true">→</span></button>
        </fieldset>

        <fieldset data-step="2" class="lf-step">
          <legend class="lf-q">{f.contactQ}</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="lf-field">
              <label for="lf-name">{f.name}</label>
              <input id="lf-name" name="name" type="text" autocomplete="given-name" maxlength="80" required aria-describedby="lf-name-err" />
              <p id="lf-name-err" class="lf-err" hidden></p>
            </div>
            <div class="lf-field">
              <label for="lf-email">{f.email}</label>
              <input id="lf-email" name="email" type="email" autocomplete="email" maxlength="160" required aria-describedby="lf-email-err" />
              <p id="lf-email-err" class="lf-err" hidden></p>
            </div>
            <div class="lf-field">
              <label for="lf-phone">{f.phone}</label>
              <input id="lf-phone" name="phone" type="tel" autocomplete="tel" maxlength="24" aria-describedby="lf-phone-hint lf-phone-err" />
              <p id="lf-phone-hint" class="lf-hint">{f.phoneHint}</p>
              <p id="lf-phone-err" class="lf-err" hidden></p>
            </div>
            <div class="lf-field sm:col-span-2">
              <label for="lf-message">{f.message}</label>
              <textarea id="lf-message" name="message" rows="2" maxlength="1000" aria-describedby="lf-message-hint"></textarea>
              <p id="lf-message-hint" class="lf-hint">{f.messageHint}</p>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <p class="text-small text-[var(--color-ink-muted)]">
              {f.consent} <a href={f.privacyHref} class="underline underline-offset-2">{f.privacy}</a>
            </p>
            <button type="submit" data-lf-submit class="lf-submit">
              <span data-lf-submit-label>{f.submit}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </fieldset>

        <div data-lf-success class="lf-done" role="status" hidden>
          <p class="font-display text-title">{f.successTitle}</p>
          <p class="mt-3 text-body text-[var(--color-ink-muted)]">{f.successBody}</p>
        </div>

        <div data-lf-error class="lf-done" role="alert" hidden>
          <p class="font-display text-title">{f.errorTitle}</p>
          <p class="mt-3 text-body text-[var(--color-ink-muted)]">{f.errorBody}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a data-lf-mail href={mailtoHref} class="lf-submit">{f.emailLabel}</a>
            <a data-lf-wa href={whatsappHref} target="_blank" rel="noopener noreferrer" class="lf-submit lf-submit--ghost">{f.whatsappLabel}</a>
          </div>
        </div>
      </form>

      <div class="mt-8 flex flex-col gap-3 lg:hidden">
        <p class="font-label text-small uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">{f.orWrite}</p>
        <a href={mailtoHref} class="alt-contact">{f.emailLabel} <span>{CONTACT.email}</span></a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="alt-contact">{f.whatsappLabel} <span>{CONTACT.phoneDisplay}</span></a>
        <button type="button" data-callback-open class="alt-contact text-left">{f.callbackLabel} <span aria-hidden="true">→</span></button>
      </div>
    </div>
  </div>
</section>

<style>
  .alt-contact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    font-size: var(--text-body);
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s var(--ease-power3);
  }
  .alt-contact span {
    font-weight: 400;
    color: var(--color-ink-muted);
  }
  .alt-contact:hover,
  .alt-contact:hover span {
    color: var(--color-accent);
  }

  /* Pared back: no tinted box, a hairline on top, fields underlined. */
  .lead-form {
    position: relative;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .lf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .lf-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }
  .lf-bar {
    position: relative;
    flex: 1;
    height: 1px;
    border-radius: 0;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .lf-bar span {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(0.333);
    transform-origin: left;
    transition: transform 0.5s var(--ease-power3);
  }
  .lf-back {
    font-size: var(--text-body);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .lf-step {
    min-width: 0;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .lf-q {
    margin-bottom: 18px;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  /* Choices: one column on a narrow form, two from 600px wide, all the same
     height (the tallest sets it). The text size follows the form's width so
     the longest choice stays on one line, down to 13px (one column) or 14px
     (two); below that it may wrap. */
  .lead-form {
    container-type: inline-size;
  }
  .lf-chips {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 8px;
  }
  @container (min-width: 600px) {
    .lf-chips {
      grid-template-columns: 1fr 1fr;
    }
  }
  .lf-chip {
    position: relative;
    display: block;
    cursor: pointer;
  }
  /* The step 1 choices come in one by one when the form scrolls into view
     (only once the script has armed it: visible without JS). */
  .lf-chips[data-chips-wait] .lf-chip {
    opacity: 0;
    transform: translateY(14px);
  }
  .lf-chips[data-chips-in] .lf-chip {
    animation: chip-in 0.6s var(--ease-power3) both;
    animation-delay: calc(var(--n, 0) * 90ms);
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .lf-chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .lf-chip span {
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    border-radius: 0;
    background: transparent;
    font-size: var(--text-body);
    transition:
      background-color 0.2s var(--ease-power3),
      color 0.2s var(--ease-power3),
      border-color 0.2s var(--ease-power3),
      transform 0.2s var(--ease-power3);
  }
  .lf-chip:hover span {
    border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
  }
  .lf-chip input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .lf-chip input:checked + span {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
  }
  .lf-chip:active span {
    transform: scale(0.985);
  }
  .lf-next {
    margin-top: 16px;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .lf-next:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .lf-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lf-field label {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .lf-field input,
  .lf-field textarea {
    width: 100%;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    background: transparent;
    font-size: var(--text-body);
    color: var(--color-ink);
    border-radius: 0;
    transition: border-color 0.2s var(--ease-power3);
  }
  .lf-field textarea {
    resize: vertical;
  }
  .lf-field input:focus,
  .lf-field textarea:focus {
    border-color: var(--color-accent);
    outline: none;
    box-shadow: 0 1px 0 var(--color-accent);
  }
  .lf-field [aria-invalid="true"] {
    border-color: #9f2f2d;
  }
  .lf-hint {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .lf-err {
    font-size: var(--text-small);
    color: #9f2f2d;
  }
  .lf-submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 0;
    background: var(--color-accent);
    color: #ffffff;
    font-size: var(--text-body);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-power3),
      transform 0.2s var(--ease-power3);
  }
  .lf-submit:hover {
    background: var(--color-accent-strong);
  }
  .lf-submit:active {
    transform: scale(0.98);
  }
  .lf-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .lf-submit--ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-border);
  }
  .lf-submit--ghost:hover {
    background: transparent;
    border-color: var(--color-ink);
  }

  /* JS on: one step at a time, sliding in. Without JS every field shows and
     the form posts natively to /api/lead. */
  .lead-form[data-js] .lf-step {
    display: none;
  }
  .lead-form[data-js] .lf-step[data-current] {
    display: block;
    animation: lf-in 0.45s var(--ease-power3) both;
  }
  .lead-form:not([data-js]) .lf-step + .lf-step {
    margin-top: 28px;
  }
  .lead-form:not([data-js]) .lf-head,
  .lead-form:not([data-js]) .lf-next {
    display: none;
  }
  .lead-form[data-done] .lf-head,
  .lead-form[data-done] .lf-step {
    display: none !important;
  }
  .lf-done:not([hidden]) {
    animation: lf-in 0.45s var(--ease-power3) both;
  }
  @keyframes lf-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  /* Entry: title, rating, contact links and form rise in one after the other
     when the block reaches the screen (armed by the script: visible without
     JS). */
  [data-cta][data-cta-wait] .cta-in {
    opacity: 0;
    translate: 0 18px;
  }
  [data-cta][data-cta-in] .cta-in {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.8s var(--ease-power3) calc(var(--i) * 120ms),
      translate 0.8s var(--ease-power3) calc(var(--i) * 120ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .lf-bar span,
    .lf-chip span,
    .lf-submit {
      transition: none;
    }
    .lead-form[data-js] .lf-step[data-current],
    .lf-done:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { initLeadForms } from "~/lib/lead-form";
  initLeadForms();

  // Entry of the contact block (see `.cta-in`). A block already on screen at
  // load is left as it is, so nothing visible blinks out.
  if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-cta]").forEach((block) => {
      if (block.getBoundingClientRect().top < window.innerHeight) return;
      block.setAttribute("data-cta-wait", "");
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          block.setAttribute("data-cta-in", "");
          block.removeAttribute("data-cta-wait");
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      io.observe(block);
    });
  }

  // Step 1 choices come in one by one when the form reaches the screen. The
  // form is observed, not the choices: on a service page the form opens on
  // step 2 and the choices only show after "Back".
  if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
      const chips = form.querySelector<HTMLElement>(".lf-chips");
      if (!chips) return;
      chips.setAttribute("data-chips-wait", "");
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          chips.removeAttribute("data-chips-wait");
          chips.setAttribute("data-chips-in", "");
        },
        { threshold: 0.25 },
      );
      io.observe(form);
    });
  }
</script>

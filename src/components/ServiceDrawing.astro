---
import type { Lang } from "~/i18n/ui";
import type { ServiceId } from "~/lib/service-pages";

// Architect drawing for each service page hero ("planche"): thin ink lines,
// dashed construction lines, dimensions, labels and a title block, with one
// element in the accent blue. Lines draw themselves on load (stroke-dashoffset
// on pathLength=1); labels, hatching and guides fade in after. Static with
// reduced motion or without JS.
interface Props {
  id: ServiceId;
  lang: Lang;
}

const { id, lang } = Astro.props;
const fr = lang === "fr";
const t = {
  web: { n: "01", title: fr ? "Élévation · page d'accueil" : "Elevation · home page", aria: fr ? "Dessin d'architecte : élévation d'une page web, avec ses cotes et ses blocs." : "Architect drawing: elevation of a web page, with dimensions and blocks." },
  seo: { n: "02", title: fr ? "Plan de visibilité" : "Visibility plan", aria: fr ? "Dessin d'architecte : une recherche, le premier résultat et une réponse d'IA qui le cite." : "Architect drawing: a search, the first result and an AI answer citing it." },
  brand: { n: "03", title: fr ? "Tracé régulateur" : "Construction grid", aria: fr ? "Dessin d'architecte : tracé de construction d'un logo, lignes typographiques et nuancier." : "Architect drawing: logo construction lines, type guides and colour swatches." },
  apps: { n: "04", title: fr ? "Schéma de principe" : "System diagram", aria: fr ? "Dessin d'architecte : vos données, l'IA, vos outils et une application reliés." : "Architect drawing: your data, AI, your tools and an app, connected." },
}[id];
const p = `sd-${id}`; // unique ids for patterns / markers
const L = (frText: string, enText: string): string => (fr ? frText : enText);
---

<svg
  class="drawing"
  viewBox="0 0 480 600"
  role="img"
  aria-label={t.aria}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <pattern id={`${p}-grid`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" class="grid" />
    </pattern>
    <pattern id={`${p}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" class="hatch" />
    </pattern>
    <marker id={`${p}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L8 4L0 8" fill="none" class="arrow" />
    </marker>
  </defs>

  {/* Sheet: drafting grid, border, title block */}
  <rect class="soft" x="0" y="0" width="480" height="552" fill={`url(#${p}-grid)`} />
  <rect class="frame" x="0.5" y="0.5" width="479" height="599" fill="none" />
  <g class="soft">
    <line class="frame" x1="0" y1="552" x2="480" y2="552" />
    <line class="frame" x1="96" y1="552" x2="96" y2="600" />
    <line class="frame" x1="380" y1="552" x2="380" y2="600" />
    <text class="lbl" x="16" y="580">{L("PL.", "SH.")} {t.n}</text>
    <text class="lbl lbl-ink" x="112" y="580">{t.title}</text>
    <text class="lbl" x="396" y="580">{L("ÉCH. 1:1", "SCALE 1:1")}</text>
  </g>

  {id === "web" && (
    <g>
      {/* Browser */}
      <rect class="ink" pathLength="1" x="60" y="70" width="360" height="430" />
      <line class="ink" pathLength="1" x1="60" y1="94" x2="420" y2="94" />
      <circle class="ink thin" pathLength="1" cx="76" cy="82" r="3.5" />
      <circle class="ink thin" pathLength="1" cx="88" cy="82" r="3.5" />
      <circle class="ink thin" pathLength="1" cx="100" cy="82" r="3.5" />
      <rect class="ink thin" pathLength="1" x="150" y="76" width="180" height="12" />
      {/* Nav */}
      <rect class="ink thin" pathLength="1" x="78" y="108" width="44" height="10" />
      <line class="ink thin" pathLength="1" x1="226" y1="113" x2="256" y2="113" />
      <line class="ink thin" pathLength="1" x1="266" y1="113" x2="296" y2="113" />
      <line class="ink thin" pathLength="1" x1="306" y1="113" x2="336" y2="113" />
      <rect class="accent" pathLength="1" x="350" y="106" width="52" height="14" />
      {/* Hero */}
      <rect class="ink" pathLength="1" x="78" y="142" width="236" height="20" style={`fill:url(#${p}-hatch)`} />
      <rect class="ink" pathLength="1" x="78" y="168" width="176" height="20" style={`fill:url(#${p}-hatch)`} />
      <line class="ink thin" pathLength="1" x1="78" y1="204" x2="300" y2="204" />
      <line class="ink thin" pathLength="1" x1="78" y1="214" x2="262" y2="214" />
      <rect class="accent" pathLength="1" x="78" y="230" width="100" height="26" />
      <line class="accent" pathLength="1" x1="96" y1="243" x2="152" y2="243" />
      {/* Cards with image plates */}
      {[78, 190, 302].map((x) => (
        <g>
          <rect class="ink" pathLength="1" x={x} y="282" width="100" height="112" />
          <rect class="ink thin" pathLength="1" x={x + 8} y="290" width="84" height="56" />
          <line class="ink thin" pathLength="1" x1={x + 8} y1="290" x2={x + 92} y2="346" />
          <line class="ink thin" pathLength="1" x1={x + 92} y1="290" x2={x + 8} y2="346" />
          <line class="ink thin" pathLength="1" x1={x + 8} y1="362" x2={x + 74} y2="362" />
          <line class="ink thin" pathLength="1" x1={x + 8} y1="374" x2={x + 56} y2="374" />
        </g>
      ))}
      <line class="ink thin" pathLength="1" x1="78" y1="418" x2="402" y2="418" />
      <line class="ink thin" pathLength="1" x1="78" y1="430" x2="330" y2="430" />
      <rect class="ink" pathLength="1" x="60" y="456" width="360" height="44" style={`fill:url(#${p}-hatch)`} />
      {/* Dimensions */}
      <g class="soft">
        <line class="dim" x1="60" y1="44" x2="420" y2="44" marker-start={`url(#${p}-arrow)`} marker-end={`url(#${p}-arrow)`} />
        <rect class="tag-bg" x="212" y="37" width="56" height="14" />
        <text class="lbl lbl-ink" x="240" y="48" text-anchor="middle">1440 PX</text>
        <line class="dim" x1="36" y1="94" x2="36" y2="270" marker-start={`url(#${p}-arrow)`} marker-end={`url(#${p}-arrow)`} />
        <text class="lbl" x="30" y="182" text-anchor="middle" transform="rotate(-90 30 182)">{L("PREMIER ÉCRAN", "FIRST SCREEN")}</text>
        <line class="guide" x1="40" y1="270" x2="440" y2="270" />
        <line class="leader" x1="402" y1="113" x2="446" y2="140" />
        <text class="lbl lbl-accent" x="446" y="152" text-anchor="end">CTA</text>
        <text class="lbl" x="60" y="530">LIGHTHOUSE ≥ 95 · WCAG AA · CORE WEB VITALS</text>
      </g>
    </g>
  )}

  {id === "seo" && (
    <g>
      {/* Search bar */}
      <rect class="ink" pathLength="1" x="60" y="66" width="360" height="40" />
      <circle class="ink" pathLength="1" cx="86" cy="85" r="8" />
      <line class="ink" pathLength="1" x1="92" y1="91" x2="99" y2="98" />
      <line class="ink thin" pathLength="1" x1="112" y1="86" x2="300" y2="86" />
      {/* Results: the first one is ours */}
      <rect class="accent" pathLength="1" x="48" y="128" width="384" height="70" />
      {[140, 234, 302].map((y, i) => (
        <g>
          <line class={i === 0 ? "accent" : "ink"} pathLength="1" x1="66" y1={y + 6} x2={i === 0 ? 262 : 240} y2={y + 6} />
          <line class="ink thin" pathLength="1" x1="66" y1={y + 22} x2="190" y2={y + 22} />
          <line class="ink thin" pathLength="1" x1="66" y1={y + 36} x2="400" y2={y + 36} />
          <line class="ink thin" pathLength="1" x1="66" y1={y + 46} x2="350" y2={y + 46} />
        </g>
      ))}
      {/* AI answer citing the source */}
      <path class="ink" pathLength="1" d="M130 372h276a14 14 0 0 1 14 14v84a14 14 0 0 1-14 14H190l-22 18v-18h-38a14 14 0 0 1-14-14v-84a14 14 0 0 1 14-14z" />
      <path class="accent" pathLength="1" d="M146 396l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" />
      <line class="ink thin" pathLength="1" x1="168" y1="402" x2="390" y2="402" />
      <line class="ink thin" pathLength="1" x1="146" y1="420" x2="396" y2="420" />
      <line class="ink thin" pathLength="1" x1="146" y1="434" x2="360" y2="434" />
      <rect class="accent" pathLength="1" x="290" y="450" width="110" height="20" />
      <line class="accent" pathLength="1" x1="302" y1="460" x2="388" y2="460" />
      <path class="link" d="M432 162c38 0 40 120 0 190-16 28-30 60-42 96" marker-end={`url(#${p}-arrow)`} />
      {/* Annotations */}
      <g class="soft">
        <circle class="accent-fill" cx="30" cy="163" r="11" />
        <text class="lbl lbl-on" x="30" y="167" text-anchor="middle">01</text>
        <line class="leader" x1="300" y1="86" x2="446" y2="44" />
        <text class="lbl" x="446" y="38" text-anchor="end">{L("REQUÊTE", "QUERY")}</text>
        <text class="lbl lbl-accent" x="60" y="218">{L("POSITION 01 · GOOGLE", "POSITION 01 · GOOGLE")}</text>
        <text class="lbl" x="116" y="362">{L("RÉPONSE IA · SOURCE CITÉE", "AI ANSWER · SOURCE CITED")}</text>
        <text class="lbl" x="60" y="530">SEO · GEO · CHATGPT ADS</text>
      </g>
    </g>
  )}

  {id === "brand" && (
    <g>
      {/* Construction */}
      <g class="soft">
        <rect class="guide" x="110" y="50" width="260" height="260" />
        <line class="guide" x1="110" y1="50" x2="370" y2="310" />
        <line class="guide" x1="370" y1="50" x2="110" y2="310" />
        <line class="guide" x1="240" y1="40" x2="240" y2="320" />
        <line class="guide" x1="100" y1="180" x2="380" y2="180" />
        <circle class="guide" cx="240" cy="180" r="130" />
        <circle class="guide" cx="240" cy="180" r="80" />
      </g>
      {/* The mark */}
      <path class="ink thick" pathLength="1" d="M240 74L346 262H134Z" />
      <circle class="accent thick" pathLength="1" cx="240" cy="204" r="52" />
      <line class="ink thick" pathLength="1" x1="170" y1="204" x2="310" y2="204" />
      {/* Type guides */}
      <g class="soft">
        <line class="guide" x1="56" y1="368" x2="270" y2="368" />
        <line class="guide" x1="56" y1="392" x2="270" y2="392" />
        <line class="guide" x1="56" y1="436" x2="270" y2="436" />
        <line class="guide" x1="56" y1="454" x2="270" y2="454" />
        <text class="specimen" x="64" y="436">Aa</text>
        <text class="lbl" x="276" y="371">CAP</text>
        <text class="lbl" x="276" y="395">X</text>
        <text class="lbl" x="276" y="439">{L("BASE", "BASE")}</text>
      </g>
      {/* Swatches */}
      <rect class="swatch-ink" x="330" y="360" width="34" height="90" />
      <rect class="swatch-accent" x="372" y="360" width="34" height="90" />
      <rect class="ink thin" pathLength="1" x="414" y="360" width="34" height="90" />
      {/* Dimensions */}
      <g class="soft">
        <line class="dim" x1="134" y1="290" x2="346" y2="290" marker-start={`url(#${p}-arrow)`} marker-end={`url(#${p}-arrow)`} />
        <rect class="tag-bg" x="222" y="283" width="36" height="14" />
        <text class="lbl lbl-ink" x="240" y="294" text-anchor="middle">1 U</text>
        <line class="leader" x1="277" y1="167" x2="420" y2="120" />
        <text class="lbl lbl-accent" x="420" y="112" text-anchor="end">R 0,4 U</text>
        <path class="dim" d="M160 262a26 26 0 0 0-8-18" />
        <text class="lbl" x="104" y="252">60°</text>
        <text class="lbl" x="330" y="468">#10151D</text>
        <text class="lbl" x="60" y="530">{L("LOGO · CHARTE · TYPOGRAPHIE", "LOGO · GUIDELINES · TYPE")}</text>
      </g>
    </g>
  )}

  {id === "apps" && (
    <g>
      {/* Nodes */}
      <rect class="ink" pathLength="1" x="56" y="72" width="120" height="54" />
      <rect class="ink" pathLength="1" x="304" y="72" width="120" height="54" />
      <rect class="ink" pathLength="1" x="56" y="300" width="120" height="54" />
      <circle class="accent thick" pathLength="1" cx="240" cy="212" r="44" />
      <path class="accent" pathLength="1" d="M240 194l5 13 13 5-13 5-5 13-5-13-13-5 13-5z" />
      {/* Connections */}
      <path class="ink" pathLength="1" d="M176 99h40v68" marker-end={`url(#${p}-arrow)`} />
      <path class="ink" pathLength="1" d="M284 212h80v-86" marker-end={`url(#${p}-arrow)`} />
      <path class="ink" pathLength="1" d="M216 252v75h-40" marker-end={`url(#${p}-arrow)`} />
      <path class="ink" pathLength="1" d="M264 252v130" marker-end={`url(#${p}-arrow)`} />
      {/* App screen */}
      <rect class="ink" pathLength="1" x="186" y="392" width="220" height="128" />
      <line class="ink thin" pathLength="1" x1="236" y1="392" x2="236" y2="520" />
      <line class="ink thin" pathLength="1" x1="198" y1="410" x2="224" y2="410" />
      <line class="ink thin" pathLength="1" x1="198" y1="422" x2="220" y2="422" />
      <line class="ink thin" pathLength="1" x1="198" y1="434" x2="224" y2="434" />
      <polyline class="accent" pathLength="1" points="250,494 280,470 306,480 336,446 366,456 392,420" />
      <line class="ink thin" pathLength="1" x1="250" y1="506" x2="394" y2="506" />
      {/* Labels */}
      <g class="soft">
        <text class="lbl lbl-ink" x="116" y="103" text-anchor="middle">{L("VOS DONNÉES", "YOUR DATA")}</text>
        <text class="lbl lbl-ink" x="364" y="103" text-anchor="middle">{L("VOS OUTILS", "YOUR TOOLS")}</text>
        <text class="lbl lbl-ink" x="116" y="331" text-anchor="middle">CRM · ERP</text>
        <text class="lbl lbl-accent" x="240" y="276" text-anchor="middle">{L("IA", "AI")}</text>
        <text class="lbl" x="222" y="150">API</text>
        <text class="lbl" x="300" y="204">N8N</text>
        <text class="lbl" x="272" y="372">{L("APPLICATION", "APP")}</text>
        <circle class="guide" cx="240" cy="212" r="62" />
        <text class="lbl" x="60" y="530">CLAUDE · OPENAI · SUPABASE</text>
      </g>
    </g>
  )}
</svg>

<script is:inline>
  // Arm the drawing before first paint (hidden strokes), then draw it.
  (function () {
    var svg = document.currentScript && document.currentScript.previousElementSibling;
    if (!svg || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    svg.classList.add("draw-ready");
    var go = function () { svg.classList.add("is-drawn"); };
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (e) {
        if (e[0].isIntersecting) { io.disconnect(); setTimeout(go, 150); }
      }, { threshold: 0.2 });
      io.observe(svg);
    } else go();
  })();
</script>

<style>
  .drawing {
    color: var(--color-ink);
    display: block;
    width: 100%;
    height: auto;
    max-height: 640px;
    background: #ffffff;
  }
  .drawing :global(.grid) {
    stroke: color-mix(in srgb, var(--color-ink) 5%, transparent);
    stroke-width: 1;
  }
  .drawing :global(.hatch) {
    stroke: color-mix(in srgb, var(--color-ink) 22%, transparent);
    stroke-width: 1;
  }
  .drawing :global(.frame) {
    stroke: var(--color-line);
    stroke-width: 1;
    fill: none;
  }
  .drawing :global(.ink) {
    stroke: var(--color-ink);
    stroke-width: 1.3;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .drawing :global(.ink.thin) {
    stroke-width: 0.9;
    stroke: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  .drawing :global(.ink.thick),
  .drawing :global(.accent.thick) {
    stroke-width: 2;
  }
  .drawing :global(.accent) {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .drawing :global(.accent-fill) {
    fill: var(--color-accent);
  }
  .drawing :global(.swatch-ink) {
    fill: var(--color-ink);
  }
  .drawing :global(.swatch-accent) {
    fill: var(--color-accent);
  }
  .drawing :global(.guide) {
    stroke: color-mix(in srgb, var(--color-ink) 30%, transparent);
    stroke-width: 0.8;
    stroke-dasharray: 3 4;
    fill: none;
  }
  .drawing :global(.dim) {
    stroke: color-mix(in srgb, var(--color-ink) 55%, transparent);
    stroke-width: 0.8;
    fill: none;
  }
  .drawing :global(.leader) {
    stroke: color-mix(in srgb, var(--color-ink) 45%, transparent);
    stroke-width: 0.8;
    stroke-dasharray: 2 3;
  }
  .drawing :global(.link) {
    stroke: var(--color-accent);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
    fill: none;
  }
  .drawing :global(.arrow) {
    stroke: currentColor;
    stroke-width: 1;
  }
  .drawing :global(.tag-bg) {
    fill: #ffffff;
  }
  .drawing :global(.lbl) {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--color-ink-muted);
  }
  .drawing :global(.lbl-ink) {
    fill: var(--color-ink);
    font-weight: 500;
  }
  .drawing :global(.lbl-accent) {
    fill: var(--color-accent);
    font-weight: 600;
  }
  .drawing :global(.lbl-on) {
    fill: #ffffff;
    font-weight: 600;
  }
  .drawing :global(.specimen) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 96px;
    fill: var(--color-ink);
  }

  /* Drawing animation: strokes trace in, the rest fades in after. */
  .drawing.draw-ready :global(.ink),
  .drawing.draw-ready :global(.accent) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .drawing.draw-ready :global(.soft),
  .drawing.draw-ready :global(.swatch-ink),
  .drawing.draw-ready :global(.swatch-accent),
  .drawing.draw-ready :global(.link) {
    opacity: 0;
  }
  .drawing.draw-ready.is-drawn :global(.ink),
  .drawing.draw-ready.is-drawn :global(.accent) {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .drawing.draw-ready.is-drawn :global(.accent) {
    transition-delay: 0.5s;
  }
  .drawing.draw-ready.is-drawn :global(.soft),
  .drawing.draw-ready.is-drawn :global(.swatch-ink),
  .drawing.draw-ready.is-drawn :global(.swatch-accent),
  .drawing.draw-ready.is-drawn :global(.link) {
    opacity: 1;
    transition: opacity 0.9s var(--ease-power3) 1.1s;
  }
</style>

---
// Blog index body, shared by /blog/ and /en/blog/: header with the theme
// index, the latest guide laid out wide, the other guides in a grid, then the
// entry offer (SEO & GEO audit). Riviera direction: white sheet, drafting
// lines, one blue accent.
import type { Lang } from "~/i18n/ui";
import PostCard from "~/components/blog/PostCard.astro";
import Eyebrow from "~/components/Eyebrow.astro";
import { getPosts, getTags, tagPath } from "~/lib/blog";
import { PRICE, DELAY, formatPrice } from "~/lib/facts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fr = lang === "fr";
const posts = await getPosts(lang);
const tags = await getTags(lang);
const [latest, ...rest] = posts;

const c = fr
  ? {
      sheet: "Planche 00 · Guides",
      title: "Être trouvé sur Google et cité par les IA",
      lead: "Des guides concrets sur le référencement local, le GEO et ChatGPT Ads, écrits depuis Nice pour les entreprises de Nice, Cannes et Monaco. Les méthodes valent aussi ailleurs en France.",
      themes: "Thèmes",
      count: (n: number) => `${n} guide${n > 1 ? "s" : ""}`,
      latest: "Dernier guide",
      all: "Tous les guides",
      empty: "Premiers guides à venir.",
      ctaSheet: "Planche 99 · Audit",
      ctaTitle: "Votre entreprise est-elle citée par ChatGPT ?",
      ctaBody: `Audit visibilité Google + IA : ce que Google, ChatGPT et Perplexity disent de vous, et les actions à mener en priorité. ${formatPrice(PRICE.seoAudit, lang)}, livré en ${DELAY.seoAudit.fr}.`,
      ctaPrimary: "Voir l'offre SEO & GEO",
      ctaPrimaryHref: "/seo-geo/",
      ctaSecondary: "Me contacter",
      ctaSecondaryHref: "/contact/",
    }
  : {
      sheet: "Sheet 00 · Guides",
      title: "Get found on Google and cited by AI",
      lead: "Practical guides on local SEO, GEO and ChatGPT Ads, written in Nice for businesses in Nice, Cannes and Monaco. The methods work anywhere else too.",
      themes: "Topics",
      count: (n: number) => `${n} guide${n > 1 ? "s" : ""}`,
      latest: "Latest guide",
      all: "All guides",
      empty: "First guides coming soon.",
      ctaSheet: "Sheet 99 · Audit",
      ctaTitle: "Does ChatGPT mention your business?",
      ctaBody: `Google + AI visibility audit: what Google, ChatGPT and Perplexity say about you, and what to fix first. ${formatPrice(PRICE.seoAudit, lang)}, delivered in ${DELAY.seoAudit.en}.`,
      ctaPrimary: "See the SEO & GEO offer",
      ctaPrimaryHref: "/en/seo-geo/",
      ctaSecondary: "Get in touch",
      ctaSecondaryHref: "/en/contact/",
    };
---

<main id="main-content" class="bg-[var(--color-bg)] text-[var(--color-ink)]">
  {/* Header: title + lead on the left, theme index on the right. */}
  <section class="px-4 pt-28 pb-14 sm:px-6 sm:pt-36 md:px-12 md:pt-44 md:pb-20">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={c.sheet} class="mb-6 md:mb-8" />
      <div class="grid gap-10 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-7">
          <h1 class="max-w-[18ch] text-balance font-display text-[clamp(34px,4.6vw,60px)]">{c.title}</h1>
          <p class="mt-6 max-w-[56ch] text-pretty text-[17px] leading-[1.6] text-[var(--color-ink-muted)] md:text-[18px]">{c.lead}</p>
        </div>
        {tags.length > 0 && (
          <nav aria-label={c.themes} class="md:col-span-4 md:col-start-9 md:self-end">
            <p class="font-label mb-3 text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-subtle)]">{c.themes}</p>
            <ol class="border-t border-[var(--color-ink)]/15">
              {tags.map((t, i) => (
                <li class="border-b border-[var(--color-ink)]/15">
                  <a href={tagPath(lang, t.slug)} class="theme-link group flex items-baseline gap-4 py-3 text-[var(--color-ink)] no-underline">
                    <span class="font-label text-[13px] tabular-nums text-[var(--color-ink-subtle)]">{String(i + 1).padStart(2, "0")}</span>
                    <span class="flex-1 text-[17px] font-medium transition-colors group-hover:text-[var(--color-accent)]">{t.name}</span>
                    <span class="font-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-subtle)]">{c.count(t.count)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </div>
    </div>
  </section>

  {latest ? (
    <>
      {/* Latest guide, wide. */}
      <section class="px-4 py-14 sm:px-6 md:px-12 md:py-20">
        <div class="mx-auto w-full max-w-[var(--container-wide)]">
          <h2 class="font-label mb-8 text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">{c.latest}</h2>
          <PostCard post={latest} lang={lang} featured headingLevel={3} />
        </div>
      </section>

      {/* Every other guide. */}
      {rest.length > 0 && (
        <section class="px-4 py-14 sm:px-6 md:px-12 md:py-20">
          <div class="mx-auto w-full max-w-[var(--container-wide)]">
            <h2 class="font-display mb-10 text-[clamp(26px,2.8vw,40px)] md:mb-14">{c.all}</h2>
            <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16">
              {rest.map((post) => <PostCard post={post} lang={lang} headingLevel={3} />)}
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="px-4 pb-24 sm:px-6 md:px-12">
      <p class="mx-auto w-full max-w-[var(--container-wide)] text-[var(--color-ink-muted)]">{c.empty}</p>
    </section>
  )}

  {/* Entry offer. */}
  <section class="px-4 py-20 sm:px-6 md:px-12 md:py-28" data-surface="tint" style="background: var(--color-bg)">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <Eyebrow label={c.ctaSheet} class="mb-6 md:mb-8" />
      <div class="grid gap-8 md:grid-cols-12 md:items-end md:gap-10">
        <div class="md:col-span-7">
          <h2 class="max-w-[26ch] text-balance font-display text-[clamp(26px,2.8vw,40px)]">{c.ctaTitle}</h2>
          <p class="mt-5 max-w-[56ch] text-pretty text-[17px] leading-[1.6] text-[var(--color-ink-muted)]">{c.ctaBody}</p>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href={c.ctaPrimaryHref} class="btn btn-primary">{c.ctaPrimary}</a>
          <a href={c.ctaSecondaryHref} class="btn btn-secondary">{c.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </section>
</main>

---
// Section 2's scene in dots (waterfall-scene.ts geometry, waterfall-halftone.ts
// tones), drawn over the whole section and filmed by a camera (camera.ts).
// The section is a scroll sequence picking up where the hero's ends: pinned,
// it opens inside the hiker's backpack, then the camera pulls back from it to
// show him at the foot of the waterfall, the scene settles in its place (the
// .approach-visual box) and the text fades in. Where the section is taller
// than the screen (phones), its content then slides up under the pin, as far
// as a scroll would take it, so the three words come into view. Last, still
// pinned, the water rises in dots (flood.ts, on the .flood canvas) and fills
// the screen with the projects' blue. The timeline is in pixels of scroll,
// so the slide costs exactly the scroll it shows. At rest, or under reduced
// motion, the scene simply sits in its box.
---

<canvas class="waterfall-dots" data-waterfall-dots aria-hidden="true"></canvas>

<script>
  import { Hold, boxIn, clamp01, film, follow, frame, lerpBox, screenIn, smooth } from "~/lib/camera";
  import type { HikerState } from "~/lib/halftone-ink";
  import { drawFlood } from "~/lib/flood";
  import { runDots } from "~/lib/halftone";
  import { drawWaterfallTone } from "~/lib/waterfall-halftone";
  import { HIKER, VIEW } from "~/lib/waterfall-scene";

  const DIVE = 75; // as deep in the pack as the hero's dive ends
  const PACK_Y = -68; // the pack, between its lid and its pocket (figure units)
  // The timeline, in screen heights of scroll: the way in, then the slide
  // (as long as what it uncovers), then the water.
  const ARRIVE = { phone: 1.12, wide: 1.49 };
  const WATER = { phone: 0.34, wide: 0.26 };
  // A pause once the last word (Cité) and its line are in, before the water:
  // time to read it (longer on phones, where it comes last with the slide).
  const READ = { phone: 0.45, wide: 0.1 };
  const BAR = 112; // phones: the call bar at the foot of the screen, and a margin
  // Each part takes its time, however fast the page is scrolled (seconds,
  // either way): the way in, the slide, the water.
  const TIME = { arrive: 1.8, slide: 0.7, water: window.innerWidth < 768 ? 1.4 : 1 };

  const canvas = document.querySelector<HTMLCanvasElement>("[data-waterfall-dots]");
  const stage = canvas?.closest<HTMLElement>("[data-approach]");
  const wrap = stage?.closest<HTMLElement>("[data-approach-seq]");
  const spacer = wrap?.querySelector<HTMLElement>("[data-seq-spacer]");
  const visual = stage?.querySelector<HTMLElement>(".approach-visual");
  const items = stage ? [...stage.querySelectorAll<HTMLElement>("[data-seq-item]")] : [];
  const flood = stage?.querySelector<HTMLCanvasElement>("[data-flood]");
  const content = stage?.querySelector<HTMLElement>("[data-approach-content]");
  if (canvas && stage && visual) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const seq = !still && !!wrap && !!spacer;
    if (seq) wrap.dataset.seq = "on";
    // Cut, not a crossing: when the hero plays its dive too, this section is
    // pulled up over the hero's last screen, so it pins the moment the hero's
    // dive ends, right on top of it (hidden until then).
    const hero = document.querySelector<HTMLElement>("[data-hero-seq]");
    const heroStage = hero?.querySelector<HTMLElement>("[data-home-hero]");
    const overlap = seq && hero?.dataset.seq === "on" && !!heroStage;
    const lift = (): void => {
      if (overlap) wrap.style.marginTop = `${-heroStage.offsetHeight}px`;
    };
    if (overlap) {
      wrap.dataset.overlap = "on";
      lift();
      window.addEventListener("resize", lift);
    }

    // Style writes only when a value changes.
    const last = new Map<HTMLElement, string>();
    const set = (el: HTMLElement, prop: "opacity" | "visibility", value: string): void => {
      const key = `${prop}:${value}`;
      if (last.get(el) === key) return;
      last.set(el, key);
      el.style[prop] = value;
    };

    // The water's canvas, in device pixels, the size of the section.
    const fctx = seq ? flood?.getContext("2d") : null;
    let fw = 0;
    let fh = 0;
    let fpx = 1;
    let drawn = -1; // the level last drawn (0: cleared)
    const fit = (): void => {
      if (!flood || !fctx) return;
      fpx = Math.min(window.devicePixelRatio || 1, 2);
      fw = flood.clientWidth;
      fh = flood.clientHeight;
      flood.width = Math.round(fw * fpx);
      flood.height = Math.round(fh * fpx);
      fctx.fillStyle = getComputedStyle(flood).color;
      drawn = -1;
    };
    if (fctx) {
      fit();
      window.addEventListener("resize", fit);
    }
    const phone = window.innerWidth < 768;

    // The timeline in pixels, measured from the layout (again on resize):
    // where the slide starts and how far it goes, where the water starts and
    // ends; the spacer is set to end with it.
    const tl = { arrive: 1, slide0: 0, slide: 0, water0: 0, water1: 1 };
    const measure = (): void => {
      if (!seq) return;
      const vh = window.innerHeight;
      if (content) content.style.translate = "";
      const top = stage.getBoundingClientRect().top;
      const lastItem = items[items.length - 1];
      const bottom = lastItem ? lastItem.getBoundingClientRect().bottom - top : 0;
      tl.arrive = (phone ? ARRIVE.phone : ARRIVE.wide) * vh;
      tl.slide0 = 0.75 * tl.arrive;
      tl.slide = Math.max(0, Math.round(bottom + (phone ? BAR : 48) - vh));
      tl.water0 = Math.max(0.88 * tl.arrive, tl.slide0 + tl.slide) + (phone ? READ.phone : READ.wide) * vh;
      tl.water1 = tl.water0 + (phone ? WATER.phone : WATER.wide) * vh;
      spacer.style.height = `${Math.round(tl.water1 + 0.03 * vh)}px`;
      shift = -1;
    };
    let shift = -1; // the slide last applied
    measure();
    window.addEventListener("resize", measure);
    document.fonts?.ready.then(measure); // the text's height once its font is in
    // Without the hero's dive before it, it does not open inside the pack.
    const dive = overlap ? DIVE : 1;

    // He stands on his boulder, breathing.
    const hiker: HikerState = { x: HIKER.x, y: HIKER.y, s: HIKER.scale, phase: 0, amp: 0, masked: false };
    const focus = { x: HIKER.x, y: HIKER.y + PACK_Y * HIKER.scale };
    let t = 0;
    let at = 0; // how far into the pin, in px of scroll, eased
    // Held on screen only when it falls well behind the scroll (a fast
    // flick), until it catches up; then too it waits for the hero's dive,
    // and the projects wait for it (data-filled).
    const hold = seq ? new Hold(stage, wrap) : null;
    const projects = document.querySelector<HTMLElement>("[data-work-seq]");
    const LAG = 0.1; // of a screen: how far behind counts as falling behind
    const heroDone = (): boolean => !overlap || hero.dataset.held !== "on";

    runDots(
      canvas,
      VIEW,
      (tone, cols, rows, dt, px) => {
        t += dt;
        // Nothing moves until the hero's dive is done (unless it is playing
        // back, held above its pin).
        const waiting = overlap && !heroDone() && !hold?.holdingUp();
        // And while the projects are on top of it (playing back, on the way
        // up), it waits for them rather than draining unseen.
        const raw = seq && !waiting ? Math.min(Math.max(0, -wrap.getBoundingClientRect().top), spacer.offsetHeight) : 0;
        const target = projects?.dataset.shown === "on" ? Math.max(raw, at) : raw;
        // At the pace of the part it is in.
        const rate = at < tl.arrive * 0.9 ? tl.arrive / TIME.arrive : at < tl.water0 ? Math.max(tl.slide / TIME.slide, 600) : (tl.water1 - tl.water0) / TIME.water;
        at = follow(at, target, dt, 0.12, rate, 0.5);
        const lag = LAG * window.innerHeight;
        const behind = hold ? hold.threshold(lag) : lag;
        if (hold?.update(dt, at < target - behind, at > target + behind)) at = target;
        // The way in, over the first part of the pin.
        const a = seq ? at / tl.arrive : 1;
        // Out of the pack, fast at first, then easing back to the whole scene.
        const back = 1 - (1 - clamp01(a / 0.5)) ** 2;
        const settle = smooth(0.45, 0.72, a); // the scene shrinks into its place

        // The content slides up under the pin, if it is taller than the
        // screen (1:1 with the scroll).
        if (content && seq && tl.slide) {
          const y = Math.round(clamp01((at - tl.slide0) / tl.slide) * tl.slide);
          if (y !== shift) {
            shift = y;
            content.style.translate = y ? `0 ${-y}px` : "";
          }
        }

        // Then the text fades in where it stands, one line after another, all
        // of it in by 90 % of the way in: the section holds still a moment.
        // A line still below the screen fades in as the slide brings it up.
        const vh = window.innerHeight;
        items.forEach((el, i) => {
          let v = seq ? smooth(0.58 + i * 0.045, 0.72 + i * 0.045, a) : 1;
          if (seq && tl.slide) v = Math.min(v, clamp01((vh - (phone ? BAR : 0) - el.getBoundingClientRect().top) / 160));
          set(el, "opacity", v < 1 ? v.toFixed(3) : "");
        });

        // Then, as soon as the text is in, the water rises, full just before
        // the section lets go: its edge climbs from the foot of the screen to
        // above its top, and each line of text goes under as the dots close
        // over it.
        const level = seq ? smooth(tl.water0, tl.water1, at) : 0;
        // The projects wait for the water, unless it is all but there
        // (HomeSections.astro).
        if (seq) wrap.dataset.filled = level >= 0.995 || !hold?.held() ? "on" : "";
        const band = Math.min(220, vh * 0.28);
        const edge = vh + 40 - level * (vh + band + 80);
        if (level > 0) {
          items.forEach((el) => {
            const under = clamp01((el.getBoundingClientRect().bottom - edge) / (band * 0.5));
            if (under > 0) set(el, "opacity", (1 - under).toFixed(3));
          });
        }
        if (fctx) {
          if (level > 0) {
            drawFlood(fctx, fw, fh, edge, t, phone ? 6 : 7, band, fpx);
            drawn = level;
          } else if (drawn !== 0) {
            fctx.setTransform(1, 0, 0, 1, 0, 0);
            fctx.clearRect(0, 0, flood!.width, flood!.height);
            drawn = 0;
          }
        }

        const root = stage.getBoundingClientRect();
        // Hidden (and not drawn) until it pins over the hero, once the dive
        // is done (or while it is held, playing back above its pin).
        const hidden = overlap && !hold?.holdingUp() && (root.top > 0.5 || !heroDone());
        if (overlap) {
          set(stage, "visibility", hidden ? "hidden" : "");
          wrap.dataset.shown = hidden ? "" : "on";
        }
        if (hidden || level >= 1) return false; // nothing of it shows
        const screen = screenIn(root);
        const box = lerpBox(screen, boxIn(visual, root), settle);
        film(tone, VIEW, box, dive ** (1 - back), focus, 1 - smooth(0.25, 0.6, a), screen, px);
        const breath = still ? 0 : 0.5 - 0.5 * Math.cos((2 * Math.PI * t) / 4.2);
        drawWaterfallTone(tone, t, hiker, breath, cols, rows);
        frame(tone, box, { left: 0, top: 0, bottom: 0 }, px, cols, rows);
        return { x: box.x * px, y: box.y * px, w: box.w * px, h: box.h * px }; // only the frame holds dots
      },
      still,
      2, // as fine on phones as on wide screens: coarser, the drawing no longer reads
    );
  }
</script>

<style>
  .waterfall-dots {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-accent); /* the dots' ink */
    pointer-events: none;
  }
</style>

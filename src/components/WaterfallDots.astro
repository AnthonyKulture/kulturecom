---
// Section 2's scene in dots (waterfall-scene.ts geometry, waterfall-halftone.ts
// tones), drawn over the whole section and filmed by a camera (camera.ts).
// The section is the theatre's second layer (home-seq.ts plays it), picking
// up where the hero's dive ends: it opens inside the hiker's backpack, then
// the camera pulls back from it to show him at the foot of the waterfall, the
// scene settles in its place (the .approach-visual box) and the text fades
// in, its three words condensing out of vapor. Where the section is taller
// than the screen (phones), its content then slides up, as far as a scroll
// would take it, so the three words come into view (plain words there, read
// as they come). Last the water rises in
// dots (flood.ts, on the .flood canvas) and fills the screen with the
// projects' blue. The timeline is in pixels of scroll, so the slide costs
// exactly the scroll it shows. At rest, or under reduced motion, the scene
// simply sits in its box.
---

<canvas class="waterfall-dots" data-waterfall-dots aria-hidden="true"></canvas>

<script>
  import { PACK, boxIn, clamp01, film, frame, lerpBox, smooth, type Box } from "~/lib/camera";
  import type { HikerState } from "~/lib/halftone-ink";
  import { drawFlood } from "~/lib/flood";
  import { runDots } from "~/lib/halftone";
  import { scenes } from "~/lib/home-seq";
  import { vaporType } from "~/lib/vapor-type";
  import { drawWaterfallTone } from "~/lib/waterfall-halftone";
  import { HIKER, VIEW } from "~/lib/waterfall-scene";

  // The timeline, in screen heights of scroll: the way in, then the slide
  // (as long as what it uncovers), then the water.
  const ARRIVE = { phone: 1.12, wide: 1.49 };
  const WATER = { phone: 0.34, wide: 0.26 };
  // A pause once the last word (Cité) and its line are in, before the water:
  // time to read it (longer on phones, where it comes last with the slide).
  const READ = { phone: 0.45, wide: 0.1 };
  const BAR = 112; // phones: the call bar at the foot of the screen, and a margin
  // Each part takes its time, however fast the page is scrolled (seconds,
  // either way): the way in, the water. The slide and the pause to read go
  // at the pace of an ordinary scroll (px a second), no faster, even when
  // the section is behind the scroll: each word stays on the screen long
  // enough to be read (a short one too, where the slide is long), and the
  // pause lasts what READ of such a scroll does.
  const TIME = { arrive: 1.8, water: { phone: 1.4, wide: 1 } };
  const SCROLL = 600;

  const canvas = document.querySelector<HTMLCanvasElement>("[data-waterfall-dots]");
  const stage = canvas?.closest<HTMLElement>("[data-approach]");
  const visual = stage?.querySelector<HTMLElement>(".approach-visual");
  const items = stage ? [...stage.querySelectorAll<HTMLElement>("[data-seq-item]")] : [];
  const flood = stage?.querySelector<HTMLCanvasElement>("[data-flood]");
  const content = stage?.querySelector<HTMLElement>("[data-approach-content]");
  const nav = document.querySelector<HTMLElement>("[data-nav-smart]");
  if (canvas && stage && visual) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Opacity writes only when a value changes.
    const last = new Map<HTMLElement, string>();
    const set = (el: HTMLElement, value: string): void => {
      if (last.get(el) === value) return;
      last.set(el, value);
      el.style.opacity = value;
    };

    // The three words condense out of vapor (vapor-type.ts) as each one
    // comes in, in the sequence: as its line starts to fade in on screen,
    // quickly enough to be whole when the water comes (see apply). Not on
    // phones, nor without the sequence (a phone held sideways, a screen too
    // short for it): there the slide, or the reader's own scroll, carries
    // each word across the screen faster than it would condense, so they are
    // plain words, to be read the moment their line is in. Checked with each
    // layout: a phone loaded in landscape and turned upright has plain words
    // too (and keeps them, turned back).
    const vapors = new Map<Element, ReturnType<typeof vaporType>>();
    const begun = new Set<Element>(); // words condensed, or plain: vapor no more
    const condense = (el: Element, share?: number): void => {
      const vapor = vapors.get(el);
      if (!vapor) return;
      vapors.delete(el);
      begun.add(el);
      vapor.start(share);
    };
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent");
    const vaporize = (plain: boolean): void => {
      for (const el of items) {
        const vapor = vapors.get(el);
        const word = el.querySelector<HTMLElement>("[data-vapor-seq]");
        if (plain) {
          vapor?.dispose();
          vapors.delete(el);
          begun.add(el);
        } else if (!vapor && word && !begun.has(el)) vapors.set(el, vaporType(word, accent));
      }
    };
    // (A word in vapor is all but whole, nine tenths of its ink, this long
    // after it starts at the usual pace, s: vapor-type.ts.)
    const FORM = 2.1;

    // The water's canvas, in device pixels, the size of the theatre (shown
    // only there).
    const fctx = flood?.getContext("2d") ?? null;
    let fw = 0;
    let fh = 0;
    let fpx = 1;
    let drawn = -1; // the level last drawn (0: cleared)
    const fit = (): void => {
      if (!flood || !fctx) return;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      if (flood.clientWidth === fw && flood.clientHeight === fh && ratio === fpx) return;
      fpx = ratio;
      fw = flood.clientWidth;
      fh = flood.clientHeight;
      flood.width = Math.round(fw * fpx);
      flood.height = Math.round(fh * fpx);
      fctx.fillStyle = getComputedStyle(flood).color;
      drawn = -1;
    };

    // Measured with the layout (home-seq.ts): the timeline in pixels, where
    // the slide starts and how far it goes, where the water starts and ends;
    // and, in the section's terms, the screen (the theatre's box), the
    // drawing's place and each line's, where they stand before the slide.
    let measured = false;
    let on = false;
    let phone = false;
    let vh = 0;
    let svh = 0;
    const tl = { arrive: 1, slide0: 0, slide: 0, water0: 0, water1: 1 };
    let screen: Box = { x: 0, y: 0, w: 0, h: 0 };
    let place: Box = screen;
    let lines: { el: HTMLElement; top: number; bottom: number }[] = [];
    // Its pace in each part, px a second: [from, to, rate].
    let parts: [number, number, number][] = [];
    const rate = (v: number): number => (parts.find(([, to]) => v < to) ?? parts[parts.length - 1])[2];
    // How long it takes at its own pace from `a` to `b` (s).
    const span = (a: number, b: number): number => {
      const lo = Math.min(a, b);
      const hi = Math.max(a, b);
      let s = 0;
      for (const [from, to, r] of parts) s += Math.max(0, Math.min(hi, to) - Math.max(lo, from)) / r;
      return s;
    };

    // Where it is, set by apply(): how far into the timeline (px of scroll,
    // eased), the slide shown, the water's level and edge.
    let at = 0;
    let shift = 0;
    let level = 0;
    let band = 0;
    let edge = 0;

    // He stands on his boulder, breathing.
    const hiker: HikerState = { x: HIKER.x, y: HIKER.y, s: HIKER.scale, phase: 0, amp: 0, masked: false };
    const focus = { x: HIKER.x, y: HIKER.y + PACK.y * HIKER.scale };
    let t = 0;

    const dots = runDots(
      canvas,
      VIEW,
      (tone, cols, rows, dt, px) => {
        t += dt;
        if (!measured) return false;
        // The water, over everything; once full it no longer changes.
        if (fctx && on) {
          if (level > 0) {
            if (level < 1 || drawn < 1) {
              drawFlood(fctx, fw, fh, edge, t, phone ? 6 : 7, band, fpx);
              drawn = level;
            }
          } else if (drawn !== 0) {
            fctx.setTransform(1, 0, 0, 1, 0, 0);
            fctx.clearRect(0, 0, flood!.width, flood!.height);
            drawn = 0;
          }
        }
        if (level >= 1) return false; // nothing of it shows

        // The way in, over the first part of the timeline (without the dive
        // before it, at rest, it does not open inside the pack).
        const a = on ? at / tl.arrive : 1;
        // Out of the pack, fast at first, then easing back to the whole scene.
        const back = 1 - (1 - clamp01(a / 0.5)) ** 2;
        const settle = smooth(0.45, 0.72, a); // the scene shrinks into its place
        const box = lerpBox(screen, { ...place, y: place.y - shift }, settle);
        film(tone, VIEW, box, (on ? PACK.dive : 1) ** (1 - back), focus, 1 - smooth(0.25, 0.6, a), screen, px);
        const breath = still ? 0 : 0.5 - 0.5 * Math.cos((2 * Math.PI * t) / 4.2);
        drawWaterfallTone(tone, t, hiker, breath, cols, rows);
        frame(tone, box, { left: 0, top: 0, bottom: 0 }, px, cols, rows);
        return { x: box.x * px, y: box.y * px, w: box.w * px, h: box.h * px }; // only the frame holds dots
      },
      still,
      2, // as fine on phones as on wide screens: coarser, the drawing no longer reads
      true,
    );

    scenes.approach = {
      el: stage,
      measure(m) {
        if (!still) vaporize(m.phone || !m.on);
        on = m.on;
        phone = m.phone;
        vh = m.vh;
        svh = m.svh;
        // (The content is slid up by `shift` right now.)
        const root = stage.getBoundingClientRect();
        const box = boxIn(visual, root);
        place = { ...box, y: box.y + shift };
        lines = items.map((el) => {
          const r = el.getBoundingClientRect();
          return { el, top: r.top - root.top + shift, bottom: r.bottom - root.top + shift };
        });
        screen = { x: 0, y: 0, w: m.vw, h: m.vh };
        const bottom = lines.length ? lines[lines.length - 1].bottom : 0;
        tl.arrive = (phone ? ARRIVE.phone : ARRIVE.wide) * vh;
        tl.slide0 = 0.75 * tl.arrive;
        // As far as the last line clears the foot of the screen (and the
        // call bar), toolbars showing; and on, past a line of text the nav's
        // edge would cut there (that frame is held through the pause to
        // read), so that it goes under the nav whole. Nor does that frame
        // open on the tail of a block whose head (its word, or the title's
        // first line) is under the nav: that block goes under whole too
        // (not the last one, Cité's, which the pause is for).
        tl.slide = Math.max(0, Math.round(bottom + (phone ? BAR : 48) - svh));
        const navH = nav?.offsetHeight ?? 0;
        if (tl.slide && navH) {
          const range = document.createRange();
          const blocks = items.map((el) => {
            const rows: [number, number][] = [];
            const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
            for (let n = walk.nextNode(); n; n = walk.nextNode()) {
              if (!n.textContent?.trim()) continue;
              range.selectNodeContents(n);
              for (const r of range.getClientRects()) rows.push([r.top - root.top + shift, r.bottom - root.top + shift]);
            }
            rows.sort((p, q) => p[0] - q[0]);
            const word = el.querySelector("[data-vapor-seq]")?.getBoundingClientRect();
            const head: [number, number] | undefined = word ? [word.top - root.top + shift, word.bottom - root.top + shift] : rows[0];
            return { rows, head };
          });
          // (Cut: the edge across the line's letters, descenders included,
          // not just across the room the font leaves above them.)
          const under = ([t, b]: [number, number]): boolean => b - 0.05 * (b - t) - tl.slide <= navH;
          for (const [t, b] of blocks.flatMap((k) => k.rows).sort((p, q) => p[0] - q[0])) {
            if (t + 0.2 * (b - t) - tl.slide < navH && !under([t, b])) tl.slide = Math.ceil(b - navH);
          }
          for (const { rows, head } of blocks.slice(0, -1)) {
            if (head && under(head) && !rows.every(under)) tl.slide = Math.ceil(Math.max(...rows.map(([, b]) => b)) - navH);
          }
        }
        const pause = (phone ? READ.phone : READ.wide) * vh;
        tl.water0 = Math.max(0.88 * tl.arrive, tl.slide0 + tl.slide) + pause;
        tl.water1 = tl.water0 + (phone ? WATER.phone : WATER.wide) * vh;
        parts = [
          [0, tl.arrive * 0.9, tl.arrive / TIME.arrive],
          [tl.arrive * 0.9, tl.water0, SCROLL],
          [tl.water0, tl.water1, (tl.water1 - tl.water0) / (phone ? TIME.water.phone : TIME.water.wide)],
        ];
        if (on) fit();
        measured = true;
        return { end: tl.water1, len: Math.round(tl.water1 + 0.03 * vh) };
      },
      rate,
      time: span,
      apply(v, shown) {
        at = v;
        const a = on ? at / tl.arrive : 1;
        // The content slides up, if it is taller than the screen (1:1 with
        // the scroll).
        const y = on && tl.slide ? Math.round(clamp01((at - tl.slide0) / tl.slide) * tl.slide) : 0;
        if (y !== shift) {
          shift = y;
          if (content) content.style.translate = y ? `0 ${-y}px` : "";
        }
        // Then, as soon as the text is in, the water rises, full just before
        // the theatre lets go: its edge climbs from the foot of the screen to
        // above its top.
        level = on ? smooth(tl.water0, tl.water1, at) : 0;
        band = Math.min(220, vh * 0.28);
        edge = vh + 40 - level * (vh + band + 80);
        // The text fades in where it stands, one line after another, all of
        // it in by 90 % of the way in: the section holds still a moment. A
        // line still below the screen fades in as the slide brings it up,
        // all in once all of it is above the foot of the screen (and the
        // call bar), and each one goes under as the dots close over it.
        lines.forEach((l, i) => {
          const fade = on ? smooth(0.58 + i * 0.045, 0.72 + i * 0.045, a) : 1;
          let v = fade;
          if (on && tl.slide) v = Math.min(v, clamp01((svh - (phone ? BAR : 0) - (l.bottom - shift)) / 160 + 1));
          if (level > 0) v = Math.min(v, 1 - clamp01((l.bottom - shift - edge) / (band * 0.5)));
          set(l.el, v < 1 ? v.toFixed(3) : "");
          // Its word condenses as the line comes in, from the start of its
          // fade, once on the screen, and is to be read by the time the water
          // comes: it forms within the time left till then at the section's
          // own pace (the least it can be).
          if (shown && fade > 0 && l.top - shift < vh && vapors.has(l.el)) condense(l.el, Math.min(1, Math.max(0.15, span(Math.min(at, tl.water0), tl.water0) / FORM)));
        });
      },
      draw: dots.draw,
      dots,
    };
  }
</script>

<style>
  .waterfall-dots {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-accent); /* the dots' ink */
    pointer-events: none;
  }
  /* In the theatre (HomeContent.astro) the section is the screen, and so are
     its dots (a height in % comes out short of it in Safari, the section's
     padding off). */
  :global([data-theatre-wrap][data-seq="on"]) .waterfall-dots {
    height: 100vh;
    height: 100lvh;
  }
</style>

---
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import { getCaseStudy, caseStudyPath, CASE_STUDIES } from "~/lib/case-studies";
import { SERVICE_PAGES, getServicePage } from "~/lib/service-pages";
import CTA from "~/components/CTA.astro";

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = ui[lang];
const cs = getCaseStudy(t, slug);
// getStaticPaths only ever passes a known slug; fail loudly if that contract breaks.
if (!cs) throw new Error(`Unknown case study slug: ${slug}`);

const isFr = lang === "fr";
const pathname = caseStudyPath(slug, lang);
const canonical = new URL(pathname, Astro.site).toString();
const workIndexPath = isFr ? "/projets/" : "/en/work/";
const homeUrl = new URL(isFr ? "/" : "/en/", Astro.site).toString();
const workIndexUrl = new URL(workIndexPath, Astro.site).toString();
const heroImageAbs = new URL(cs.image, Astro.site).toString();

// Prev / next titles for the bottom pager.
const dict = t.projects as Record<string, string>;
const prevTitle = dict[`${cs.prev.key}.title`];
const nextTitle = dict[`${cs.next.key}.title`];

const liveHost = cs.liveUrl.replace(/^https?:\/\//, "").replace(/\/$/, "");
const total = String(CASE_STUDIES.length).padStart(2, "0");
// "A · B · C" strings become lists: the services as tags, the stack one per line.
const split = (s: string): string[] => s.split(" · ").map((x) => x.trim()).filter(Boolean);
// An engagement still running ("Accompagnement en cours", "Long-term SEO/GEO"…)
// gets the accent and a dot.
const ONGOING = /en cours|toujours actif|dans la durée|ongoing|still shipping|long-term/i;
const services = split(cs.subtitle).map((label) => ({ label, ongoing: ONGOING.test(label) }));
const stack = split(cs.stack);

// Services this case is proof for (the reverse of SERVICE_PAGES.proofSlugs):
// links each case study back to its service pages.
const relatedServices = SERVICE_PAGES.filter((m) => m.proofSlugs.includes(cs.slug)).map((m) => ({
  name: getServicePage(m.id, lang)!.content.name,
  path: m.path[lang],
}));

const l = isFr
  ? {
      eyebrow: "Étude de cas",
      back: "Tous les projets",
      breadcrumb: "Fil d'Ariane",
      client: "Client",
      role: "Rôle",
      stack: "Stack",
      live: "Site en ligne",
      result: "Le résultat en bref",
      services: "Services mobilisés",
      pager: "Autres études de cas",
      prev: "Précédent",
      next: "Suivant",
    }
  : {
      eyebrow: "Case study",
      back: "All projects",
      breadcrumb: "Breadcrumb",
      client: "Client",
      role: "Role",
      stack: "Stack",
      live: "Live site",
      result: "The outcome, in short",
      services: "Services involved",
      pager: "More case studies",
      prev: "Previous",
      next: "Next",
    };

// Self-contained structured data: a CreativeWork (Anthony as creator, the client
// as the entity it's `about`) + a 3-level breadcrumb. Lives in the body, which
// Google reads for JSON-LD just like the head.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CreativeWork",
      "@id": `${canonical}#case`,
      "name": `${cs.title} — ${l.eyebrow}`,
      "headline": cs.headline,
      "url": canonical,
      "inLanguage": isFr ? "fr-FR" : "en-US",
      "image": heroImageAbs,
      "keywords": cs.tag,
      "creator": {
        "@type": "Person",
        "name": "Anthony Profit",
        "url": new URL("/", Astro.site).toString(),
      },
      "about": {
        "@type": "Organization",
        "name": cs.title,
        "url": cs.liveUrl,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": isFr ? "Accueil" : "Home", "item": homeUrl },
        { "@type": "ListItem", "position": 2, "name": isFr ? "Projets" : "Work", "item": workIndexUrl },
        { "@type": "ListItem", "position": 3, "name": cs.title, "item": canonical },
      ],
    },
  ],
};

const mediaLabel = `${cs.title} — ${cs.tag}`;
---

<main id="main-content" class="bg-[var(--color-bg)] text-[var(--color-ink)]">

  {/* ========== HERO ==========
      A drawing sheet: the title and the services on the left; on the right,
      the title block (cartouche) of the sheet: client, role, stack, live site. */}
  <section class="cs-hero relative px-4 pt-32 pb-12 sm:px-6 sm:pt-40 sm:pb-16 md:px-12 md:pt-44 md:pb-20">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      {/* Back link + eyebrow with the sheet's position */}
      <nav aria-label={l.breadcrumb} class="mb-6">
        <a
          href={workIndexPath}
          class="font-label inline-flex items-center gap-2 text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-ink)]"
        >
          <span aria-hidden="true">←</span>{l.back}
        </a>
      </nav>

      <p class="sheet-label mb-10 sm:mb-14">
        <span class="sheet-diamond" aria-hidden="true"></span>
        <span>{l.eyebrow} · {cs.title}</span>
        <span class="sheet-leader" aria-hidden="true"></span>
        <span class="tabular-nums">{cs.num} / {total}</span>
      </p>

      <div class="cs-grid">
        <div class="cs-main">
          <h1 data-vapor class="cs-title font-display text-[var(--color-ink)]">
            {cs.headline}
          </h1>

          <ul class="cs-tags" aria-label={l.services}>
            {services.map((s) => (
              <li class:list={["cs-tag font-label", s.ongoing && "cs-tag--live"]}>
                {s.ongoing && <span class="cs-dot" aria-hidden="true"></span>}
                {s.label}
              </li>
            ))}
          </ul>
        </div>

        <dl class="cs-block marks">
          <div class="cs-row">
            <dt>{l.client}</dt>
            <dd>{cs.client}</dd>
          </div>
          <div class="cs-row">
            <dt>{l.role}</dt>
            <dd>{cs.roleMeta}</dd>
          </div>
          <div class="cs-row">
            <dt>{l.stack}</dt>
            <dd>
              <ul class="cs-stack">
                {stack.map((s) => <li>{s}</li>)}
              </ul>
            </dd>
          </div>
          <div class="cs-row">
            <dt>{l.live}</dt>
            <dd>
              <a href={cs.liveUrl} target="_blank" rel="noopener" class="cs-live">
                <span>{liveHost}</span><span aria-hidden="true" class="cs-live-arrow">↗</span>
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* ========== HERO MEDIA ========== */}
  <section class="px-4 sm:px-6 md:px-12">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <div class="relative aspect-[16/10] w-full overflow-hidden bg-[var(--color-border)] sm:aspect-[16/9]">
        {cs.video ? (
          <video
            src={cs.video}
            poster={cs.image}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={mediaLabel}
            class="absolute inset-0 block h-full w-full object-cover"
          />
        ) : (
          <img
            src={cs.image}
            alt={mediaLabel}
            width="1600"
            height="900"
            loading="eager"
            class="absolute inset-0 block h-full w-full object-cover"
          />
        )}
      </div>
    </div>
  </section>

  {/* ========== METRIC (proof strip) ========== */}
  <section class="px-4 sm:px-6 md:px-12">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <p class="flex items-center gap-3 border-b border-[var(--color-border)] py-8 font-display text-[clamp(20px,3vw,40px)] leading-[1.05] tracking-[-0.02em] text-[var(--color-ink)] sm:py-10">
        <span aria-hidden="true" class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
        {cs.metric}
      </p>
    </div>
  </section>

  {/* ========== NARRATIVE (context → challenge → role → approach → result) ========== */}
  <section class="relative px-4 py-20 sm:px-6 sm:py-28 md:px-12 md:py-32">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <ol class="flex flex-col gap-14 sm:gap-20">
        {cs.sections.map((s, i) => (
          <li class="grid grid-cols-1 gap-4 border-t border-[var(--color-border)] pt-8 sm:grid-cols-[220px_1fr] sm:gap-12">
            <div class="flex items-baseline gap-4 sm:flex-col sm:gap-2">
              <span class="font-display text-[20px] leading-none text-[var(--color-accent)]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h2 class="font-display text-[clamp(22px,2vw,28px)] leading-[1.2] text-[var(--color-ink)]">
                {s.label}
              </h2>
            </div>
            <p class="max-w-[620px] text-[clamp(17px,1.25vw,19px)] leading-[1.7] text-[var(--color-ink)]">
              {s.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ========== SERVICES INVOLVED ========== */}
  <section class="px-4 pb-12 sm:px-6 sm:pb-16 md:px-12">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <h2 class="font-label mb-6 text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
        {l.services}
      </h2>
      <div class="grid grid-cols-1 gap-px overflow-hidden border border-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3">
        {relatedServices.map((s) => (
          <a
            href={s.path}
            class="group flex items-center justify-between gap-4 bg-[var(--color-bg)] p-6 no-underline transition-colors hover:bg-[var(--color-border)]/40 sm:p-8"
          >
            <span class="font-display text-[clamp(20px,2.2vw,32px)] leading-[1] tracking-[-0.03em] text-[var(--color-ink)]">
              {s.name}
            </span>
            <span aria-hidden="true" class="font-label text-[var(--color-accent)]">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ========== PREV / NEXT PAGER ========== */}
  <section class="px-4 pb-20 sm:px-6 sm:pb-28 md:px-12 md:pb-32">
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <p class="font-label mb-6 text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-subtle)]">
        {l.pager}
      </p>
      <div class="grid grid-cols-1 gap-px overflow-hidden border border-[var(--color-border)] sm:grid-cols-2">
        <a
          href={caseStudyPath(cs.prev.slug, lang)}
          class="group flex flex-col gap-2 bg-[var(--color-bg)] p-6 no-underline transition-colors hover:bg-[var(--color-border)]/40 sm:p-8"
        >
          <span class="font-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
            <span aria-hidden="true">←</span> {l.prev}
          </span>
          <span class="font-display text-[clamp(22px,2.4vw,36px)] leading-[1] tracking-[-0.03em] text-[var(--color-ink)]">
            {prevTitle}
          </span>
        </a>
        <a
          href={caseStudyPath(cs.next.slug, lang)}
          class="group flex flex-col items-start gap-2 bg-[var(--color-bg)] p-6 no-underline transition-colors hover:bg-[var(--color-border)]/40 sm:items-end sm:p-8 sm:text-right"
        >
          <span class="font-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
            {l.next} <span aria-hidden="true">→</span>
          </span>
          <span class="font-display text-[clamp(22px,2.4vw,36px)] leading-[1] tracking-[-0.03em] text-[var(--color-ink)]">
            {nextTitle}
          </span>
        </a>
      </div>
    </div>
  </section>

  {/* Contact — same section as home / about for a consistent close. */}
  <CTA lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</main>

<style>
  .cs-grid {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .cs-grid {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
      gap: 64px;
      align-items: end;
    }
  }
  .cs-title {
    max-width: 19ch;
    font-size: clamp(36px, 5.2vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }
  .cs-tag {
    padding: 7px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
  .cs-tag--live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    color: var(--color-accent);
  }
  .cs-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: cs-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cs-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* Title block: dashed rows like a drawing's cartouche. */
  .cs-block {
    padding: 4px 20px;
    background: var(--color-bg-shade);
  }
  .cs-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
  }
  @media (min-width: 640px) {
    .cs-row {
      grid-template-columns: 104px minmax(0, 1fr);
    }
  }
  .cs-row + .cs-row {
    background: repeating-linear-gradient(to right, var(--color-line) 0 3px, transparent 3px 7px) 0 0 / 100% 1px no-repeat;
  }
  .cs-row dt {
    padding-top: 3px;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }
  .cs-row dd {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .cs-stack li + li {
    margin-top: 2px;
  }
  .cs-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: none;
  }
  .cs-live span:first-child {
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    transition: background-size 0.4s var(--ease-power3);
  }
  .cs-live:hover span:first-child {
    background-size: 0 1px;
  }
  .cs-live-arrow {
    transition: translate 0.4s var(--ease-power3);
  }
  .cs-live:hover .cs-live-arrow {
    translate: 2px -2px;
  }
  .cs-live:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-live span,
    .cs-live-arrow {
      transition: none;
    }
    .cs-dot {
      animation: none;
    }
  }
</style>

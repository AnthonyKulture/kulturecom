---
import type { Lang } from "~/i18n/ui";
import { POLAROIDS, getAboutMe } from "~/lib/about-me";
import Eyebrow from "~/components/Eyebrow.astro";

// About page hero: the personal text with polaroids scattered around it on a
// dotted drafting sheet. Everything fits the first screen on desktop; on
// phones and tablets the polaroids become a swipeable strip under the text.
// The blueprint entry animation (IntroBlueprint) draws over the [data-intro-*]
// hooks before the page appears.
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getAboutMe(lang);
---

<section data-intro-hero class="about-hero px-4 pb-12 pt-[88px] sm:px-6 md:px-12 md:pb-14 md:pt-24" aria-labelledby="about-title">
  <div class="mx-auto w-full max-w-[var(--container-wide)]">
    <Eyebrow label={c.sheet} class="mb-6" data-intro-item style="--i:1" />

    <div class="about-board">
      <div class="about-text">
        <h1 id="about-title" data-vapor data-intro-item data-intro-box="H1" data-intro-text style="--i:2" class="font-display text-[clamp(30px,3vw,44px)] leading-[1.12] text-balance">
          {c.title}
        </h1>
        <div class="mt-5 flex flex-col gap-3.5 text-[17px] leading-[1.6] text-[var(--color-ink-muted)]">
          {c.paragraphs.map((p, i) => (
            <p data-intro-item data-intro-box={`COPY 0${i + 1}`} data-intro-text style={`--i:${3 + i}`}>
              {p.strong && <strong class="font-medium text-[var(--color-ink)]">{p.strong} </strong>}{p.text}
            </p>
          ))}
        </div>
        <div data-intro-item style="--i:7" class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="#contact" data-project-open data-intro-box="CTA" class="btn btn-primary">{c.cta} <span aria-hidden="true">→</span></a>
          <button type="button" data-callback-open class="text-[16px] font-medium underline underline-offset-4 hover:text-[var(--color-accent)]">{c.callback}</button>
        </div>
      </div>

      <ul class="about-photos" aria-label="Photos">
        {POLAROIDS.map((ph, i) => (
          <li data-intro-item style={`--x:${ph.x}%;--y:${ph.y}%;--i:${4 + i}`}>
            <figure class="polaroid" style={`--r:${ph.r}deg`} data-intro-box={`PHOTO 0${i + 1}`} data-intro-rotate={ph.r}>
              <img
                data-intro-plate
                src={`/hero-slides/slide-${ph.slide}.webp`}
                alt={ph.caption[lang]}
                width="500"
                height={ph.height}
                decoding="async"
              />
              <figcaption>{ph.caption[lang]}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Phones / tablets: text, then a swipeable strip of polaroids. */
  .about-text {
    max-width: 620px;
  }
  .about-photos {
    display: flex;
    gap: 16px;
    margin: 32px calc(-1 * var(--page-pad)) 0;
    padding: 12px var(--page-pad) 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .about-photos::-webkit-scrollbar {
    display: none;
  }
  .about-photos > li {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }
  .polaroid {
    width: 132px;
    margin: 0;
    padding: 8px 8px 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 26px -16px rgb(16 37 70 / 0.35);
    transform: rotate(var(--r));
    transition:
      transform 0.45s var(--ease-power3),
      box-shadow 0.45s var(--ease-power3);
  }
  .polaroid img {
    display: block;
    width: 100%;
    height: auto;
  }
  .polaroid figcaption {
    padding: 8px 2px 10px;
    font-size: 13px;
    line-height: 1.3;
    color: var(--color-ink-muted);
  }

  /* Desktop: everything in the first screen, polaroids around the text. */
  @media (min-width: 1024px) {
    .about-hero {
      background-image: radial-gradient(var(--color-line) 1px, transparent 1.2px);
      background-size: 18px 18px;
    }
    .about-board {
      position: relative;
      height: clamp(560px, calc(100svh - 190px), 760px);
    }
    .about-text {
      position: relative;
      z-index: 2;
      margin-left: 24%;
      max-width: 37%;
      padding: 22px 28px;
      background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    }
    .about-photos {
      display: block;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .about-photos > li {
      position: absolute;
      left: var(--x);
      top: var(--y);
      z-index: 1;
    }
    .polaroid {
      width: clamp(118px, 10vw, 148px);
    }
    .about-photos > li:hover {
      z-index: 3;
    }
    .polaroid:hover {
      transform: rotate(0deg) scale(1.08);
      box-shadow: 0 22px 44px -20px rgb(16 37 70 / 0.5);
    }
  }

  /* Short laptop screens (≤ 820 px tall): a wider, slightly smaller text so
     the whole hero still fits. */
  @media (min-width: 1024px) and (max-height: 820px) {
    .about-hero {
      padding-top: 84px;
    }
    .about-text {
      margin-left: 22%;
      max-width: 40%;
      padding: 14px 24px;
    }
    .about-text p {
      font-size: 16px;
      line-height: 1.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid {
      transition: none;
    }
  }
</style>

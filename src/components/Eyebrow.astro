---
/**
 * Section eyebrow — architect sheet label: ◇ LABEL, then a dashed leader.
 *
 * Used at the top of major sections (styles: `.sheet-label` in global.css).
 * `variant="dark"` lowers the opacity for tinted bands. Pass extra wrapper
 * classes (margins, alignment) via `class`.
 */
interface Props {
  label: string;
  variant?: "light" | "dark";
  class?: string;
  // Allow arbitrary HTML attributes (data-*, aria-*, id) to be forwarded
  // to the underlying <p>, e.g. `data-about-line` for GSAP selectors.
  [key: string]: unknown;
}

const { label, variant = "light", class: className = "", ...rest } = Astro.props;

const textClasses = variant === "dark" ? "opacity-70" : "";
---

<p {...rest} class:list={["sheet-label", textClasses, className]}>
  <span aria-hidden="true" class="sheet-diamond"></span>
  <span>{label}</span>
  <span aria-hidden="true" class="sheet-leader"></span>
</p>

---
// Fourth illustration: a wide view over a mountain lake — snowy peak, the
// lake mirroring it, sun, drifting clouds and a few birds — in dots like the
// others (src/lib/lake-halftone.ts). Full width, half a screen tall.
// Decorative; still under reduced motion.
---

<div class="lake-band" aria-hidden="true">
  <canvas class="lake-dots" data-lake-dots></canvas>
</div>

<script>
  import { LAKE_VIEW, drawLakeTone } from "~/lib/lake-halftone";
  import { runDots } from "~/lib/halftone";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-lake-dots]");
  if (canvas) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let t = 6; // birds already in the sky, clouds spread out
    runDots(
      canvas,
      LAKE_VIEW,
      (tone, cols, rows, dt) => {
        t += dt;
        drawLakeTone(tone, t, cols, rows);
      },
      still,
    );
  }
</script>

<style>
  .lake-band {
    width: 100%;
    height: 50svh;
    min-height: 260px;
    max-height: 560px;
  }
  /* Phones: a shorter band, the page ends sooner. */
  @media (max-width: 767px) {
    .lake-band {
      height: 30svh;
      min-height: 180px;
    }
  }
  .lake-dots {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-accent); /* the dots' ink */
  }
</style>

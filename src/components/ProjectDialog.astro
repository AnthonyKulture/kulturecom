---
import type { Lang } from "~/i18n/ui";
import { getProjectContent } from "~/lib/project-form";
import { CONTACT } from "~/lib/facts";
import GoogleRating from "~/components/GoogleRating.astro";

// "Démarrer un projet": a guided form, one question per screen, in a modal
// dialog opened by any [data-project-open] link (nav, phone bar, About,
// service pages, blog). A service id on the attribute answers the first
// question. Sends a `project` lead to /api/lead (lead-form.ts). The links keep
// their href (/contact/ or the page's #contact block): without JS they lead to
// the classic form.
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getProjectContent(lang);

const labels = (choices: { value: string; label: string }[]) => Object.fromEntries(choices.map((ch) => [ch.value, ch.label]));
const choiceSteps = [
  { id: "need", name: "need", ...c.need },
  ...(["web", "seo", "apps", "brand"] as const).map((n) => ({ id: `detail-${n}`, name: `detail-${n}`, ...c.detail[n] })),
  { id: "when", name: "when", ...c.when },
  { id: "budget", name: "budget", ...c.budget },
];

// Strings the client script needs (recap, live sheet, errors, fallback).
const strings = {
  lang,
  count: c.count,
  next: c.next,
  skip: c.skip,
  submit: c.submit,
  sending: c.sending,
  rows: c.rows,
  edit: c.edit,
  none: c.none,
  errors: { other: c.other.error, name: c.name.error, email: c.contact.errorEmail, phone: c.contact.errorPhone },
  labels: {
    need: labels(c.need.choices),
    detail: Object.assign({}, ...Object.values(c.detail).map((d) => labels(d.choices))),
    when: labels(c.when.choices),
    budget: labels(c.budget.choices),
    channel: labels(c.contact.channels),
  },
  mailSubject: c.mailSubject,
  email: CONTACT.email,
  whatsapp: CONTACT.whatsapp,
  whatsappMessage: c.whatsappMessage,
};

// Progress: a row of square dots that ink in from the left.
const TRAME = 48;

// Success mark: a tick drawn in dots on a 13 × 10 grid. The dots along its
// two strokes are inked one after the other (it draws itself); the rest come
// in faint, in a diagonal wave.
const COLS = 13;
const ROWS = 10;
const TICK: [number, number][] = [
  [2.5, 5.2],
  [5.3, 8],
  [10.6, 2.2],
];
const toSegment = (x: number, y: number, [ax, ay]: [number, number], [bx, by]: [number, number]) => {
  const dx = bx - ax;
  const dy = by - ay;
  const t = Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy)));
  return { d: Math.hypot(x - ax - t * dx, y - ay - t * dy), t };
};
const tick = Array.from({ length: COLS * ROWS }, (_, k) => {
  const x = (k % COLS) + 0.5;
  const y = Math.floor(k / COLS) + 0.5;
  const a = toSegment(x, y, TICK[0], TICK[1]);
  const b = toSegment(x, y, TICK[1], TICK[2]);
  const ink = Math.min(a.d, b.d) < 0.75;
  const delay = ink ? 250 + (a.d < b.d ? a.t * 0.33 : 0.33 + b.t * 0.67) * 450 : ((x + y) / (COLS + ROWS)) * 300;
  return { ink, delay: Math.round(delay) };
});

const sumRows = ["need", "detail", "when", "budget", "name", "contact"] as const;
---

<dialog data-project class="pf" aria-labelledby="pf-title" data-strings={JSON.stringify(strings)}>
  {/* Desktop: the brief filling in as the visitor answers. */}
  <aside class="pf-sheet" data-surface="blue">
    <p class="sheet-label">
      <span aria-hidden="true" class="sheet-diamond"></span>
      <span>{c.sheet}</span>
      <span aria-hidden="true" class="sheet-leader"></span>
    </p>
    <p class="pf-sheet-title font-display">{c.sheetTitle}</p>
    <dl class="pf-sum" aria-hidden="true">
      {sumRows.map((key) => (
        <div data-sum-row={key}>
          <dt data-sum-label>{c.rows[key]}</dt>
          <dd data-sum={key}></dd>
        </div>
      ))}
    </dl>
    <div class="pf-sheet-foot">
      <div class="pf-band" aria-hidden="true"><i style="--s:4px"></i><i style="--s:3px"></i><i style="--s:2px"></i><i style="--s:1px"></i></div>
      <p class="pf-reply">{c.sheetReply}</p>
      <GoogleRating lang={lang} class="text-small text-[var(--color-ink)]" />
    </div>
  </aside>

  <form class="pf-main" data-pf-form novalidate>
    <div class="pf-head">
      <p id="pf-title" class="pf-title">{c.title}</p>
      <button type="button" data-pf-close class="pf-x" aria-label={c.close}><span aria-hidden="true"></span></button>
      <div class="pf-trame" data-pf-trame aria-hidden="true">
        {Array.from({ length: TRAME }, (_, i) => <i style={`--i:${i}`}></i>)}
      </div>
    </div>

    <div class="pf-body">
      <div class="pf-steps">
        {/* Honeypot: invisible to people, filled by naive bots. */}
        <div class="pf-hp" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        {choiceSteps.map((st) => (
          <fieldset class="pf-step" data-step={st.id}>
            <legend class="pf-q"><span class="sr-only" data-pf-count></span>{st.q}</legend>
            {st.hint && <p class="pf-hint pf-hint--q">{st.hint}</p>}
            <div class:list={["pf-choices", st.choices.length <= 3 && "pf-choices--few"]}>
              {st.choices.map((ch, i) => (
                <label class="pf-choice" style={`--n:${i}`}>
                  <input type="radio" name={st.name} value={ch.value} />
                  <span class="pf-face">
                    <span class="pf-key" aria-hidden="true">{i + 1}</span>
                    <span>{ch.label}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}

        <div class="pf-step" data-step="site">
          <label for="pf-site" class="pf-q"><span class="sr-only" data-pf-count></span>{c.site.q}</label>
          <input id="pf-site" name="site" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" maxlength="200" enterkeyhint="next" class="pf-input" aria-describedby="pf-site-hint" />
          <p id="pf-site-hint" class="pf-hint">{c.site.hint}</p>
        </div>

        <div class="pf-step" data-step="other">
          <label for="pf-message" class="pf-q"><span class="sr-only" data-pf-count></span>{c.other.q}</label>
          <textarea id="pf-message" name="message" rows="3" maxlength="1000" class="pf-input pf-input--area" aria-describedby="pf-message-hint pf-message-err"></textarea>
          <p id="pf-message-hint" class="pf-hint">{c.other.hint}</p>
          <p id="pf-message-err" class="pf-err" hidden></p>
        </div>

        <div class="pf-step" data-step="name">
          <label for="pf-name" class="pf-q"><span class="sr-only" data-pf-count></span>{c.name.q}</label>
          <input id="pf-name" name="name" type="text" autocomplete="given-name" maxlength="80" enterkeyhint="next" class="pf-input" aria-describedby="pf-name-hint pf-name-err" />
          <p id="pf-name-hint" class="pf-hint">{c.name.hint}</p>
          <p id="pf-name-err" class="pf-err" hidden></p>
        </div>

        <fieldset class="pf-step" data-step="contact">
          <legend class="pf-q">
            <span class="sr-only" data-pf-count></span><span class="pf-hello">{c.hello[0]}<span data-pf-name></span>{c.hello[1]}</span> {c.contact.q}
          </legend>
          <div class="pf-choices pf-choices--seg">
            {c.contact.channels.map((ch, i) => (
              <label class="pf-choice pf-choice--sm" style={`--n:${i}`}>
                <input type="radio" name="channel" value={ch.value} checked={i === 0} />
                <span class="pf-face">{ch.label}</span>
              </label>
            ))}
          </div>
          <div class="pf-field" data-pf-field="email">
            <label for="pf-email">{c.contact.email}</label>
            <input id="pf-email" name="email" type="email" autocomplete="email" maxlength="160" enterkeyhint="next" class="pf-input" aria-describedby="pf-email-err" />
            <p id="pf-email-err" class="pf-err" hidden></p>
          </div>
          <div class="pf-field" data-pf-field="phone" hidden>
            <label for="pf-phone">{c.contact.phone}</label>
            <input id="pf-phone" name="phone" type="tel" autocomplete="tel" maxlength="24" enterkeyhint="next" class="pf-input" aria-describedby="pf-phone-err" />
            <p id="pf-phone-err" class="pf-err" hidden></p>
          </div>
        </fieldset>

        <div class="pf-step" data-step="recap">
          <h2 class="pf-q" tabindex="-1" data-pf-focus>{c.recap[0]}<span data-pf-name></span>{c.recap[1]}</h2>
          <dl class="pf-recap" data-pf-recap></dl>
          <div class="pf-field" data-pf-note>
            <label for="pf-note">{c.note.q}</label>
            <textarea id="pf-note" name="note" rows="2" maxlength="1000" class="pf-input pf-input--area" aria-describedby="pf-note-hint"></textarea>
            <p id="pf-note-hint" class="pf-hint">{c.note.hint}</p>
          </div>
          <p class="pf-hint mt-6">
            {c.consent} <a href={c.privacyHref} class="underline underline-offset-2">{c.privacy}</a>
          </p>
        </div>

        <div class="pf-panel" data-pf-done hidden>
          <div class="pf-tick" aria-hidden="true">
            {tick.map((d) => <i class:list={[d.ink && "ink"]} style={`--t:${d.delay}ms`}></i>)}
          </div>
          <h2 class="pf-q" tabindex="-1" data-pf-focus>{c.done[0]}<span data-pf-name></span>{c.done[1]}</h2>
          <p class="pf-lead">{c.doneBody}</p>
          <button type="button" data-pf-close class="btn btn-secondary mt-8">{c.close}</button>
        </div>

        <div class="pf-panel" data-pf-error hidden>
          <h2 class="pf-q" tabindex="-1" data-pf-focus>{c.errorTitle}</h2>
          <p class="pf-lead">{c.errorBody}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a data-pf-mail href={`mailto:${CONTACT.email}`} class="btn btn-primary">{c.emailLabel}</a>
            <a data-pf-wa href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{c.whatsappLabel}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="pf-foot">
      <button type="button" data-pf-back class="pf-back" hidden><span aria-hidden="true">←</span> {c.back}</button>
      <span class="pf-enter" aria-hidden="true">{c.enter} ↵</span>
      <button type="submit" data-pf-next class="btn btn-primary">
        <span data-pf-next-label>{c.next}</span>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </form>
</dialog>

<style is:global>
  @property --pf-p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* Phones: the whole screen. From 640px a centred panel, and from 900px the
     blue sheet on its left. */
  .pf {
    width: 100%;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .pf[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    animation: pf-in 0.45s var(--ease-power3) both;
  }
  .pf::backdrop {
    background: rgb(16 21 29 / 0.5);
  }
  @media (min-width: 640px) {
    .pf {
      width: min(680px, calc(100vw - 48px));
      height: min(720px, calc(100dvh - 48px));
      margin: auto;
      box-shadow: 0 40px 100px -40px rgb(16 37 70 / 0.5);
    }
  }
  @media (min-width: 900px) {
    .pf {
      width: min(1080px, calc(100vw - 64px));
      height: min(700px, calc(100dvh - 64px));
    }
    .pf[open] {
      grid-template-columns: 34% minmax(0, 1fr);
    }
  }
  @keyframes pf-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* --- The sheet: what has been answered so far ----------------------- */
  .pf-sheet {
    display: none;
  }
  @media (min-width: 900px) {
    .pf-sheet {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 32px 32px 28px;
      overflow-y: auto;
      background: var(--color-bg);
      color: var(--color-ink);
    }
  }
  .pf-sheet-title {
    margin-top: 20px;
    font-size: var(--text-title);
    line-height: 1.2;
  }
  .pf-sum {
    margin: 28px 0 0;
  }
  .pf-sum > div:not([hidden]) {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 11px 0;
    background: repeating-linear-gradient(to right, var(--color-line) 0 3px, transparent 3px 7px) left bottom / 100% 1px no-repeat;
  }
  .pf-sum dt {
    font-family: var(--font-label);
    font-size: var(--text-small);
    line-height: 1.6;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
    transition: color 0.3s var(--ease-power3);
  }
  .pf-sum > div:has(dd:not(:empty)) dt {
    color: var(--color-ink-muted);
  }
  .pf-sum dd {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  /* A value comes in like ink on a press: wiped in from the left. */
  .pf-sum dd:not(:empty) {
    animation: pf-print 0.5s var(--ease-power3) both;
  }
  @keyframes pf-print {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0);
    }
  }
  .pf-sheet-foot {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: 28px;
  }
  /* Halftone strip: four rows of the same dot screen, the dots shrinking. */
  .pf-band {
    margin-bottom: 8px;
  }
  .pf-band i {
    display: block;
    height: 12px;
    background: conic-gradient(from 270deg at var(--s) var(--s), var(--color-line) 90deg, #0000 0) 0 0 / 6px 6px;
  }
  .pf-reply {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* --- Main column: head, question, foot ------------------------------ */
  .pf-main {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 0;
  }
  .pf-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 16px;
    padding: 14px 20px 0;
  }
  .pf-title {
    font-family: var(--font-label);
    font-size: var(--text-small);
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .pf-x {
    position: relative;
    width: 40px;
    height: 40px;
    margin-right: -8px;
    color: var(--color-ink);
    cursor: pointer;
  }
  .pf-x span::before,
  .pf-x span::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: currentColor;
    rotate: 45deg;
    transition: rotate 0.3s var(--ease-power3);
  }
  .pf-x span::after {
    rotate: -45deg;
  }
  .pf-x:hover span::before {
    rotate: 135deg;
  }
  .pf-x:hover span::after {
    rotate: 45deg;
  }
  /* Each dot's size and strength follow how far the ink has come (--pf-p,
     0 to 1): full behind the front, fading to a faint speck ahead of it. */
  .pf-trame {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(48, minmax(0, 1fr));
    align-items: center;
    height: 8px;
    transition: --pf-p 0.8s var(--ease-power3);
  }
  .pf-trame i {
    --d: calc(var(--pf-p) * 52 - var(--i));
    justify-self: center;
    width: 4px;
    height: 4px;
    background: var(--color-accent);
    scale: clamp(0.35, calc(0.35 + var(--d) * 0.22), 1);
    opacity: clamp(0.18, calc(0.18 + var(--d) * 0.28), 1);
  }

  .pf-body {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(24px, 5vh, 64px) 20px 32px;
  }
  .pf-steps {
    max-width: 640px;
    container-type: inline-size;
  }
  .pf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .pf-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
    background: repeating-linear-gradient(to right, var(--color-line) 0 3px, transparent 3px 7px) left top / 100% 1px no-repeat;
  }
  .pf-back {
    margin-right: auto;
    padding: 8px 0;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
  }
  .pf-back:hover {
    color: var(--color-accent);
  }
  .pf-enter {
    font-family: var(--font-label);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
  .pf-foot .btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (min-width: 640px) {
    .pf-head {
      padding: 22px 40px 0;
    }
    .pf-body {
      padding-inline: 40px;
    }
    .pf-foot {
      padding: 16px 40px;
    }
  }
  @media (hover: none) {
    .pf-enter,
    .pf-key {
      display: none !important;
    }
  }

  /* --- Steps ---------------------------------------------------------- */
  .pf-step {
    display: none;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .pf-step[data-current] {
    display: block;
  }
  .pf[data-state] .pf-step,
  .pf[data-state] .pf-foot {
    display: none;
  }
  .pf-q {
    display: block;
    width: 100%;
    margin: 0 0 24px;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .pf-q:focus {
    outline: none;
  }
  @media (min-width: 640px) {
    .pf-q {
      margin-bottom: 28px;
      font-size: var(--text-display);
      line-height: 1.05;
    }
  }
  .pf-hello {
    display: block;
    margin-bottom: 0.15em;
    color: var(--color-ink-muted);
  }
  .pf-hint {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .pf-hint--q {
    margin: -12px 0 20px;
  }
  .pf-err {
    margin-top: 8px;
    font-size: 15px;
    color: #9f2f2d;
  }
  .pf-lead {
    font-size: var(--text-body);
    color: var(--color-ink-muted);
  }

  /* A step comes in from below (from above when going back), its choices
     one after the other. */
  .pf-step[data-current] > *,
  .pf-step[data-current] .pf-choice,
  .pf-panel:not([hidden]) > * {
    animation: pf-rise 0.5s var(--ease-power3) both;
  }
  .pf-step[data-current] .pf-choice {
    animation-delay: calc(90ms + var(--n) * 45ms);
  }
  .pf-step[data-current] > .pf-choices {
    animation: none;
  }
  .pf[data-dir="back"] .pf-step[data-current] > *,
  .pf[data-dir="back"] .pf-step[data-current] .pf-choice {
    animation-name: pf-rise-back;
  }
  @keyframes pf-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes pf-rise-back {
    from {
      opacity: 0;
      translate: 0 -14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* --- Choices: picked, a choice is printed in dots, then inked solid --- */
  .pf-choices {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 8px;
  }
  @container (min-width: 520px) {
    .pf-choices:not(.pf-choices--few, .pf-choices--seg) {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pf-choice {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .pf-choice input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .pf-face {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    min-height: 56px;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    font-size: var(--text-body);
    line-height: 1.35;
    color: var(--color-ink);
    transition:
      border-color 0.2s var(--ease-power3),
      color 0.15s var(--ease-power3),
      transform 0.2s var(--ease-power3);
  }
  .pf-face::before,
  .pf-face::after {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    pointer-events: none;
  }
  .pf-face::before {
    background: conic-gradient(from 270deg at 3px 3px, var(--color-accent) 90deg, #0000 0) 0 0 / 6px 6px;
    clip-path: inset(0 100% 0 0);
  }
  .pf-face::after {
    background: var(--color-accent);
    opacity: 0;
  }
  .pf-choice:hover .pf-face {
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  .pf-choice input:checked + .pf-face {
    border-color: var(--color-accent);
    color: #ffffff;
    transition-delay: 0s, 0.12s, 0s;
  }
  .pf-choice input:checked + .pf-face::before {
    clip-path: inset(0);
    transition: clip-path 0.26s var(--ease-power2);
  }
  .pf-choice input:checked + .pf-face::after {
    opacity: 1;
    transition: opacity 0.18s var(--ease-power3) 0.16s;
  }
  .pf-choice input:focus-visible + .pf-face {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .pf-choice:active .pf-face {
    transform: scale(0.985);
  }
  .pf-key {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--color-border);
    font-family: var(--font-label);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1;
    color: var(--color-ink-muted);
    transition:
      border-color 0.2s var(--ease-power3),
      color 0.2s var(--ease-power3);
  }
  .pf-choice:hover .pf-key {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pf-choice input:checked + .pf-face .pf-key {
    border-color: rgb(255 255 255 / 0.5);
    color: #ffffff;
  }
  .pf-choices--seg {
    display: flex;
    flex-wrap: wrap;
  }
  .pf-choice--sm .pf-face {
    min-height: 44px;
    padding: 9px 18px;
  }

  /* --- Text fields ----------------------------------------------------- */
  .pf-field {
    margin-top: 28px;
  }
  .pf-field[hidden] {
    display: none;
  }
  .pf-field > label {
    display: block;
    margin-bottom: 4px;
    font-size: 15px;
    color: var(--color-ink-muted);
  }
  .pf-input {
    width: 100%;
    padding: 8px 0 10px;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    border-radius: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
    transition:
      border-color 0.2s var(--ease-power3),
      box-shadow 0.2s var(--ease-power3);
  }
  .pf-input:focus {
    border-color: var(--color-accent);
    outline: none;
    box-shadow: 0 1px 0 var(--color-accent);
  }
  .pf-input[aria-invalid="true"] {
    border-color: #9f2f2d;
    box-shadow: 0 1px 0 #9f2f2d;
  }
  .pf-input--area {
    min-height: 96px;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.55;
    resize: vertical;
  }
  .pf-input--area:focus {
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  /* --- Recap ----------------------------------------------------------- */
  .pf-recap {
    margin: 0;
  }
  .pf-recap > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pf-recap dt {
    grid-column: 1;
    font-family: var(--font-label);
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .pf-recap dd {
    grid-column: 1;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .pf-recap button {
    grid-column: 2;
    grid-row: 1 / span 2;
    padding: 8px 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  @media (min-width: 640px) {
    .pf-recap > div {
      grid-template-columns: 120px minmax(0, 1fr) auto;
      align-items: baseline;
    }
    .pf-recap dd {
      grid-column: 2;
    }
    .pf-recap button {
      grid-column: 3;
      grid-row: 1;
    }
  }

  /* --- Sent ------------------------------------------------------------ */
  .pf-tick {
    display: grid;
    grid-template-columns: repeat(13, 6px);
    gap: 4px;
    width: max-content;
    margin-bottom: 28px;
  }
  .pf-tick i {
    width: 6px;
    height: 6px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .pf-tick i.ink {
    background: var(--color-accent);
  }
  .pf-panel:not([hidden]) .pf-tick i {
    animation: pf-dot 0.4s var(--ease-power3) var(--t) both;
  }
  @keyframes pf-dot {
    from {
      opacity: 0;
      scale: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf[open],
    .pf-step[data-current] > *,
    .pf-step[data-current] .pf-choice,
    .pf-panel:not([hidden]) > *,
    .pf-panel:not([hidden]) .pf-tick i,
    .pf-sum dd:not(:empty) {
      animation: none;
    }
    .pf-trame,
    .pf-face,
    .pf-face::before,
    .pf-face::after {
      transition: none !important;
    }
  }
</style>

<script>
  import { isValidEmail, isValidPhone, sendLead, trackLead } from "~/lib/lead-form";

  type Labels = Record<string, string>;
  type Strings = {
    lang: string;
    count: [string, string];
    next: string;
    skip: string;
    submit: string;
    sending: string;
    rows: Record<"need" | "detail" | "site" | "other" | "when" | "budget" | "name" | "contact", string>;
    edit: string;
    none: string;
    errors: { other: string; name: string; email: string; phone: string };
    labels: { need: Labels; detail: Labels; when: Labels; budget: Labels; channel: Labels };
    mailSubject: string;
    email: string;
    whatsapp: string;
    whatsappMessage: string;
  };
  type Answer = { row: keyof Strings["rows"]; sheet: string; step: string; value: string };

  const dialog = document.querySelector<HTMLDialogElement>("[data-project]");
  const form = dialog?.querySelector<HTMLFormElement>("[data-pf-form]");

  if (dialog && form) {
    const s = JSON.parse(dialog.dataset.strings || "{}") as Strings;
    const q = <T extends HTMLElement>(sel: string, root: ParentNode = dialog) => root.querySelector<T>(sel)!;
    const steps = new Map([...form.querySelectorAll<HTMLElement>("[data-step]")].map((el) => [el.dataset.step!, el]));
    const next = q<HTMLButtonElement>("[data-pf-next]");
    const nextLabel = q("[data-pf-next-label]");
    const back = q<HTMLButtonElement>("[data-pf-back]");
    const trame = q("[data-pf-trame]");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const history: string[] = [];
    let current = "need";
    let editing = false;
    let startedAt = 0;
    let timer = 0;

    const val = (name: string): string =>
      (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value?.trim() ?? "";
    const need = (): string => val("need");
    const channel = (): string => val("channel") || "email";

    // The questions this visitor goes through: the detail depends on the
    // need, and the free check-up has no timeline or budget.
    const flow = (): string[] => {
      const n = need();
      if (n === "checkup") return ["need", "site", "name", "contact", "recap"];
      return ["need", n === "other" ? "other" : `detail-${n || "web"}`, "when", "budget", "name", "contact", "recap"];
    };
    const isChoice = (id: string): boolean => id === "need" || id === "when" || id === "budget" || id.startsWith("detail-");

    const answered = (id: string): boolean => {
      if (isChoice(id)) return !!val(id);
      if (id === "other") return !!val("message");
      if (id === "name") return !!val("name");
      if (id === "contact") return channel() === "email" ? isValidEmail(val("email")) : isValidPhone(val("phone"));
      return id === "site";
    };

    const answers = (): Answer[] => {
      const n = need();
      const L = s.labels;
      const list: Answer[] = [{ row: "need", sheet: "need", step: "need", value: L.need[n] ?? "" }];
      if (n === "checkup") list.push({ row: "site", sheet: "detail", step: "site", value: val("site") });
      else if (n === "other") list.push({ row: "other", sheet: "detail", step: "other", value: val("message") });
      else list.push({ row: "detail", sheet: "detail", step: `detail-${n}`, value: L.detail[val(`detail-${n}`)] ?? "" });
      if (n !== "checkup") {
        list.push({ row: "when", sheet: "when", step: "when", value: L.when[val("when")] ?? "" });
        list.push({ row: "budget", sheet: "budget", step: "budget", value: L.budget[val("budget")] ?? "" });
      }
      list.push({ row: "name", sheet: "name", step: "name", value: val("name") });
      const reach = channel() === "email" ? val("email") : val("phone");
      list.push({ row: "contact", sheet: "contact", step: "contact", value: reach && `${L.channel[channel()]} · ${reach}` });
      return list;
    };

    // Desktop sheet: each answer printed in as it is given.
    const updateSheet = (): void => {
      const list = answers();
      dialog.querySelectorAll<HTMLElement>("[data-sum-row]").forEach((row) => {
        const a = list.find((x) => x.sheet === row.dataset.sumRow);
        row.hidden = !a;
        if (!a) return;
        q("[data-sum-label]", row).textContent = s.rows[a.row];
        const dd = q("[data-sum]", row);
        if (dd.textContent !== a.value) dd.textContent = a.value;
      });
      dialog.querySelectorAll("[data-pf-name]").forEach((el) => (el.textContent = val("name")));
    };

    const buildRecap = (): void => {
      const dl = q("[data-pf-recap]");
      dl.replaceChildren(
        ...answers().map((a) => {
          const row = document.createElement("div");
          const dt = document.createElement("dt");
          const dd = document.createElement("dd");
          const edit = document.createElement("button");
          dt.textContent = s.rows[a.row];
          dd.textContent = a.value || s.none;
          edit.type = "button";
          edit.dataset.edit = a.step;
          edit.textContent = s.edit;
          const sr = document.createElement("span");
          sr.className = "sr-only";
          sr.textContent = ` : ${s.rows[a.row]}`;
          edit.append(sr);
          row.append(dt, dd, edit);
          return row;
        }),
      );
      // "Autre chose" already says it all in its own words.
      q("[data-pf-note]").hidden = need() === "other";
    };

    const sync = (): void => {
      next.disabled = isChoice(current) && !val(current);
      nextLabel.textContent = current === "recap" ? s.submit : current === "site" && !val("site") ? s.skip : s.next;
    };

    const focusStep = (id: string): void => {
      const el = steps.get(id)!;
      const target =
        id === "recap"
          ? q("[data-pf-focus]", el)
          : id === "contact"
            ? q<HTMLInputElement>(".pf-field:not([hidden]) input", el)
            : (el.querySelector<HTMLElement>("input:checked") ?? el.querySelector<HTMLElement>("input, textarea"));
      target?.focus({ preventScroll: true });
    };

    const show = (id: string, focus = true, dir: "fwd" | "back" = "fwd"): void => {
      current = id;
      dialog.dataset.dir = dir;
      if (id === "recap") {
        editing = false;
        buildRecap();
      }
      steps.forEach((el, key) => el.toggleAttribute("data-current", key === id));
      const f = flow();
      const total = f.length - 1;
      const n = f.indexOf(id);
      trame.style.setProperty("--pf-p", String(id === "recap" ? 1 : (n + 0.5) / (total + 0.5)));
      const count = steps.get(id)!.querySelector("[data-pf-count]");
      if (count) count.textContent = `${s.count[0]} ${n + 1} ${s.count[1]} ${total}. `;
      back.hidden = history.length === 0;
      q(".pf-body").scrollTop = 0;
      sync();
      updateSheet();
      if (focus) focusStep(id);
    };

    const setError = (input: string, message: string): boolean => {
      const field = form.elements.namedItem(input) as HTMLInputElement;
      const err = q(`#pf-${input}-err`);
      field.setAttribute("aria-invalid", message ? "true" : "false");
      err.textContent = message;
      err.hidden = !message;
      if (message) field.focus();
      return !message;
    };

    const validate = (id: string): boolean => {
      if (isChoice(id)) return !!val(id);
      if (id === "other") return setError("message", val("message") ? "" : s.errors.other);
      if (id === "name") return setError("name", val("name") ? "" : s.errors.name);
      if (id === "contact") {
        return channel() === "email"
          ? setError("email", isValidEmail(val("email")) ? "" : s.errors.email)
          : setError("phone", isValidPhone(val("phone")) ? "" : s.errors.phone);
      }
      return true;
    };

    // Next question; after an edit from the recap, straight back to it
    // (through any question the edit has made necessary).
    const advance = (): void => {
      if (!validate(current)) return;
      const f = flow();
      const after = f.slice(f.indexOf(current) + 1);
      const to = editing ? (after.find((id) => id !== "recap" && !answered(id)) ?? "recap") : after[0];
      history.push(current);
      show(to);
    };

    // A pointer pick moves on by itself once it has been printed.
    const advanceSoon = (): void => {
      window.clearTimeout(timer);
      const from = current;
      timer = window.setTimeout(() => {
        if (current === from && dialog.open) advance();
      }, still ? 120 : 420);
    };

    const fallback = (): void => {
      const body = answers()
        .map((a) => `${s.rows[a.row]} : ${a.value || s.none}`)
        .concat(val("note") && need() !== "other" ? ["", val("note")] : [])
        .join("\n");
      q<HTMLAnchorElement>("[data-pf-mail]").href =
        `mailto:${s.email}?subject=${encodeURIComponent(s.mailSubject)}&body=${encodeURIComponent(body)}`;
      q<HTMLAnchorElement>("[data-pf-wa]").href =
        `https://wa.me/${s.whatsapp}?text=${encodeURIComponent(`${s.whatsappMessage}\n\n${body}`)}`;
    };

    const finish = (panel: "done" | "error"): void => {
      dialog.dataset.state = panel;
      trame.style.setProperty("--pf-p", "1");
      const el = q(panel === "done" ? "[data-pf-done]" : "[data-pf-error]");
      el.hidden = false;
      q("[data-pf-focus]", el).focus({ preventScroll: true });
    };

    const send = async (): Promise<void> => {
      const n = need();
      const byEmail = channel() === "email";
      next.disabled = true;
      nextLabel.textContent = s.sending;
      const ok = await sendLead({
        type: "project",
        lang: s.lang,
        need: n,
        detail: n === "checkup" || n === "other" ? "" : val(`detail-${n}`),
        site: n === "checkup" ? val("site") : "",
        timeline: n === "checkup" ? "" : val("when"),
        budget: n === "checkup" ? "" : val("budget"),
        name: val("name"),
        channel: channel(),
        email: byEmail ? val("email") : "",
        phone: byEmail ? "" : val("phone"),
        message: n === "other" ? val("message") : val("note"),
        website: val("website"),
        elapsed: Date.now() - startedAt,
      });
      sync();
      if (ok) trackLead("project_form", n);
      else fallback();
      finish(ok ? "done" : "error");
    };

    const reset = (): void => {
      form.reset();
      history.length = 0;
      delete dialog.dataset.state;
      q("[data-pf-done]").hidden = true;
      q("[data-pf-error]").hidden = true;
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      form.querySelectorAll<HTMLElement>(".pf-err").forEach((el) => (el.hidden = true));
      showChannel();
      show("need", false);
    };

    const showChannel = (): void => {
      const byEmail = channel() === "email";
      q("[data-pf-field=email]").hidden = !byEmail;
      q("[data-pf-field=phone]").hidden = byEmail;
    };

    const open = (preset?: string): void => {
      if (dialog.dataset.state === "done") reset();
      startedAt ||= Date.now();
      const radio = preset && form.querySelector<HTMLInputElement>(`input[name=need][value="${preset}"]`);
      if (radio) {
        radio.checked = true;
        history.length = 0;
        history.push("need");
        show(flow()[1], false);
      }
      dialog.showModal();
      if (dialog.dataset.state) q("[data-pf-focus]", q(`[data-pf-${dialog.dataset.state}]`)).focus();
      else focusStep(current);
    };

    document.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>("[data-project-open]");
      const m = e as MouseEvent;
      if (!link || m.metaKey || m.ctrlKey || m.shiftKey || m.altKey) return;
      e.preventDefault();
      open(link.dataset.projectOpen || undefined);
    });
    dialog.querySelectorAll("[data-pf-close]").forEach((b) => b.addEventListener("click", () => dialog.close()));
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => window.clearTimeout(timer));

    back.addEventListener("click", () => {
      const prev = history.pop();
      if (prev) show(prev, true, "back");
    });

    form.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const edit = target.closest<HTMLElement>("[data-edit]");
      if (edit) {
        editing = true;
        history.push("recap");
        show(edit.dataset.edit!, true, "back");
        return;
      }
      // Pointer clicks on a choice move on; arrow keys move the selection
      // with synthetic clicks (detail 0) and wait for Enter.
      const radio = target.closest<HTMLInputElement>("input[type=radio]");
      if (!radio || (e as MouseEvent).detail === 0) return;
      // (The click comes before the change event: show the right field now.)
      if (radio.name === "channel") {
        showChannel();
        q<HTMLInputElement>(".pf-field:not([hidden]) input").focus();
      } else advanceSoon();
    });

    form.addEventListener("change", (e) => {
      if ((e.target as HTMLInputElement).name === "channel") showChannel();
      sync();
      updateSheet();
    });
    form.addEventListener("input", (e) => {
      const field = e.target as HTMLInputElement;
      if (field.getAttribute("aria-invalid") === "true") setError(field.name, "");
      sync();
      updateSheet();
    });

    // Keyboard: digits pick a choice, Enter goes on (from a choice too),
    // Ctrl/Cmd + Enter from a text area.
    dialog.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement;
      const typing = target.matches("input:not([type=radio]), textarea");
      if (e.key === "Enter" && (target.matches("input[type=radio]") || (typing && target.matches("textarea") && (e.metaKey || e.ctrlKey)))) {
        e.preventDefault();
        if (!next.disabled) form.requestSubmit();
        return;
      }
      if (typing || e.metaKey || e.ctrlKey || e.altKey || !/^[1-9]$/.test(e.key) || !isChoice(current)) return;
      const radio = steps.get(current)!.querySelectorAll<HTMLInputElement>("input[type=radio]")[Number(e.key) - 1];
      if (!radio) return;
      e.preventDefault();
      radio.checked = true;
      radio.focus();
      sync();
      updateSheet();
      advanceSoon();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (current === "recap") void send();
      else advance();
    });

    show("need", false);
  }
</script>

---
// Hero illustration, as a still line drawing: a hiker seen from behind on his
// ridge, the mountains around (world in src/lib/hero-scene.ts). Only for
// visitors without JS (see the noscript); otherwise the scene is drawn in
// dots, filmed over the whole hero (HeroDots.astro).
import Hiker from "~/components/Hiker.astro";
import { CX, FEET_Y, GROUND_PATH, HORIZON, LAYER_COUNT, VIEW, createScene, sceneFrame } from "~/lib/hero-scene";

const scene = createScene();
const first = sceneFrame(scene);
---

<noscript><style is:inline>.hero-line{visibility:visible!important}</style></noscript>

<svg class="scene hero-line" data-hero-scene viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} preserveAspectRatio="xMidYMid slice" focusable="false">
  {/* Sky: drifting cirrus, the sun sitting on the horizon. */}
  <path class="sc-cloud" data-clouds d={first.clouds} />
  <circle class="sc-ink" cx={CX + 150} cy={HORIZON - 4} r="27" />
  <rect x="0" y={HORIZON} width={VIEW.w} height={VIEW.h - HORIZON} fill="var(--color-bg)" />
  <path class="sc-haze" d={`M0 ${HORIZON}H${VIEW.w}`} />

  {/* Every mountain, far to near: the still far range, the two big
      mountains and the foothills (re-ordered and redrawn every frame). */}
  {Array.from({ length: LAYER_COUNT }, (_, i) => {
    const r = first.layers[i];
    return (
      <g data-ridge>
        <path class="sc-fill" d={r?.fill ?? ""} style={`opacity:${r?.fillOpacity ?? 0}`} />
        <path class="sc-line" d={r?.d ?? ""} stroke-width={r?.width ?? 1} style={`opacity:${r?.lineOpacity ?? 0}`} />
        <path class="sc-hatch" d={r?.hatch ?? ""} style={`opacity:${(r?.lineOpacity ?? 0) * 0.55}`} />
      </g>
    );
  })}

  {/* The hiker's ridge, the pebbles and tufts streaming toward us on it. */}
  <path class="sc-ground" d={GROUND_PATH} />
  <path class="sc-decal" data-decals d={first.decals} />

  {/* The hiker, walking toward the sun. */}
  <g transform={`translate(${CX} ${FEET_Y}) scale(1.12)`}>
    <Hiker />
  </g>
</svg>

<style>
  /* Fills its frame (absolute: a percentage height would not resolve inside
     the hero's flexible column on phones). */
  .scene {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The line drawing is only for visitors without JS (see the noscript). */
  .hero-line {
    visibility: hidden;
  }
  .sc-ink,
  .sc-ridge,
  .sc-ground {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .sc-fill {
    fill: var(--color-bg);
  }
  .sc-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .sc-hatch {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.6;
    stroke-linecap: round;
  }
  .sc-cloud,
  .sc-haze {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .sc-haze {
    opacity: 0.35;
  }
  .sc-decal {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sc-ground {
    stroke-width: 1.4;
  }
</style>

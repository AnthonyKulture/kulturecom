---
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import { SERVICE_PAGES } from "~/lib/service-pages";
import { getHomeContent } from "~/lib/home-content";
import { fromPrice } from "~/lib/facts";

interface Props {
  lang: Lang;
  altLangPath: string;
  altLang: Lang;
}

const { lang, altLangPath } = Astro.props;
const t = ui[lang];
const fr = lang === "fr";
const workHref = fr ? "/projets/" : "/en/work/";
const servicesHref = fr ? "/services/" : "/en/services/";
const blogHref = fr ? "/blog/" : "/en/blog/";
const aboutHref = fr ? "/a-propos/" : "/en/about/";
const homeHref = fr ? "/" : "/en/";
const contactHref = fr ? "/contact/" : "/en/contact/";
const ctaLabel = fr ? "Démarrer un projet" : "Start a project";
const guidesLabel = "Guides";
const allServices = fr ? "Tous les services" : "All services";

// Lang switcher: both languages always visible. Current lang stays on the
// current URL; the other lang switches via the `altLangPath` from the page.
const frHref = fr ? "/" : altLangPath;
const enHref = !fr ? "/en/" : altLangPath;

// Service sub-menu: the same 4 "doors" as the home hero (title, one-line
// benefit, starting price), in the same order.
const doors = getHomeContent(lang).doors;
const services = doors.map((d) => ({
  ...d,
  href: SERVICE_PAGES.find((s) => s.id === d.id)!.path[lang],
  price: fromPrice(d.id, lang),
}));

const links = [
  { label: t.nav.work, href: workHref },
  { label: guidesLabel, href: blogHref },
  { label: t.nav.about, href: aboutHref },
];

const menuLabel = fr ? "Ouvrir le menu" : "Open menu";
const closeLabel = fr ? "Fermer le menu" : "Close menu";
const email = t.footer["contact.email"];
const linkedinUrl = "https://www.linkedin.com/in/anthony-profit/";
const instagramUrl = "https://www.instagram.com/antho_profit/";
const behanceUrl = "https://www.behance.net/anthonyprofit";
const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => path === href || (href !== homeHref && path.startsWith(href));
// The name, a letter at a time: they come in one after the other on arrival
// (`c`), and all but the initials fold away once the page is scrolled (`k`,
// their place in the fold).
const letters = (word: string, from: number) => [...word].map((ch, k) => ({ ch, c: from + k, k }));
---

{/* Smart nav. At the top: transparent, the name in full. Once scrolled: a
    floating bar between the page's side guides, with crop marks, and the
    name folds into its initials (A•P), unfolding again under the pointer.
    Hides on scroll-down, comes back on scroll-up. */}
<header
  data-nav-smart
  data-hidden="false"
  data-scrolled="false"
  class="site-nav fixed inset-x-0 top-0 z-50"
>
  <nav
    data-intro-item
    style="--i:0"
    class="nav-row mx-auto h-16 w-full max-w-[var(--container-wide)] gap-4 px-4 sm:px-6 md:h-[72px] md:px-12"
    aria-label={fr ? "Navigation principale" : "Main navigation"}
  >
    <a href={homeHref} aria-label="Anthony Profit" data-intro-box="LOGO" class="brand justify-self-start text-[var(--color-ink)] no-underline">
      <span aria-hidden="true" class="font-display text-[21px] leading-none tracking-[-0.02em] max-[379px]:text-[18px] md:text-[23px]"><span class="b-ch" style="--c:0">A</span><span class="b-fold"><span>{letters("nthony", 1).map((l) => <span class="b-ch" style={`--c:${l.c};--k:${l.k}`}>{l.ch}</span>)}</span></span><span class="b-dot"></span><span class="b-ch" style="--c:7">P</span><span class="b-fold"><span>{letters("rofit", 8).map((l) => <span class="b-ch" style={`--c:${l.c};--k:${l.k}`}>{l.ch}</span>)}</span></span></span>
    </a>

    <div data-intro-box="NAV" class="hidden items-center gap-8 lg:flex">
      <div class="nav-dd" data-dd>
        <button type="button" class="nav-link nav-item inline-flex items-center gap-1.5" style="--n:0" aria-expanded="false" aria-controls="nav-services" data-dd-toggle>
          <span class="roll"><span>{t.nav.services}</span><span aria-hidden="true">{t.nav.services}</span></span>
          <svg class="dd-chevron" aria-hidden="true" viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 4.5 L6 8.5 L10 4.5" /></svg>
        </button>
        <div id="nav-services" class="nav-dd-panel" data-dd-panel>
          <ul class="grid gap-1">
            {services.map((s, i) => (
              <li style={`--n:${i}`}>
                <a href={s.href} class="dd-item">
                  <span class="flex flex-col">
                    <span class="text-[15px] font-medium">{s.title}</span>
                    <span class="text-[15px] text-[var(--color-ink-muted)]">{s.desc}</span>
                  </span>
                  {s.price && <span class="font-label text-[13px] uppercase tracking-[0.08em] whitespace-nowrap">{s.price}</span>}
                </a>
              </li>
            ))}
          </ul>
          <a href={servicesHref} class="mt-2 block px-3 py-2 font-label text-[13px] uppercase tracking-[0.06em] underline underline-offset-4 hover:text-[var(--color-accent)]">{allServices}</a>
        </div>
      </div>
      {links.map((l, i) => (
        <a href={l.href} class="nav-link nav-item" style={`--n:${i + 1}`} aria-current={isCurrent(l.href) ? "page" : undefined}>
          <span class="roll"><span>{l.label}</span><span aria-hidden="true">{l.label}</span></span>
        </a>
      ))}
    </div>

    <div class="flex items-center justify-self-end gap-4 sm:gap-5">
      <a href={contactHref} data-project-open data-intro-box="CTA" class="nav-cta nav-item hidden sm:inline-flex" style="--n:4">
        <span class="cta-label"><span class="roll"><span>{ctaLabel}</span><span aria-hidden="true">{ctaLabel}</span></span></span>
        <span class="cta-arrow" aria-hidden="true">
          {[0, 1].map(() => (
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
          ))}
        </span>
      </a>
      <span class="nav-item font-label inline-flex items-center gap-1 text-[13px] uppercase tracking-[0.06em] sm:text-[14px]" style="--n:5">
        <a href={enHref} hreflang="en" aria-current={lang === "en" ? "page" : undefined} class:list={["no-underline hover:underline underline-offset-4", lang === "en" ? "font-bold" : "opacity-60 hover:opacity-100"]}>EN</a>
        <span aria-hidden="true" class="opacity-60">/</span>
        <a href={frHref} hreflang="fr" aria-current={lang === "fr" ? "page" : undefined} class:list={["no-underline hover:underline underline-offset-4", lang === "fr" ? "font-bold" : "opacity-60 hover:opacity-100"]}>FR</a>
      </span>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={menuLabel}
        class="burger nav-item -mr-1 grid h-10 w-7 place-items-center text-[var(--color-ink)] lg:hidden"
        style="--n:5"
      >
        <span class="burger-box" aria-hidden="true">
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

{/* ===== Full-screen menu (< lg) ===== dark surface, circle reveal from the
    burger; services first (the 4 doors + prices), then the other pages. */}
<div
  id="mobile-menu"
  data-mobile-menu
  data-surface="tint"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  aria-hidden="true"
  inert
  class="mobile-menu fixed inset-0 z-[90] flex flex-col overflow-y-auto bg-[var(--color-bg)] text-[var(--color-ink)] lg:hidden"
>
  <div class="flex shrink-0 items-center justify-between px-4 py-3 sm:px-6">
    <a href={homeHref} data-menu-link aria-label="Anthony Profit" class="inline-flex items-baseline no-underline">
      <span class="font-display text-[21px] leading-none tracking-[-0.02em]">Anthony<span aria-hidden="true" class="mx-[0.2em] inline-block size-[0.22em] rounded-full bg-[var(--color-accent)] align-[0.14em]"></span>Profit</span>
    </a>
    <button type="button" data-menu-close aria-label={closeLabel} class="burger burger--close grid h-10 w-7 place-items-center">
      <span class="burger-box" aria-hidden="true">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </span>
    </button>
  </div>

  <nav class="flex flex-1 flex-col gap-8 px-4 pb-6 pt-4 sm:px-6" aria-label={fr ? "Menu principal" : "Main menu"}>
    <div class="menu-fade" style="--d:0.18s">
      <a href={servicesHref} data-menu-link class="font-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)] no-underline">{t.nav.services}</a>
      <ul class="mt-3 grid gap-1">
        {services.map((s) => (
          <li>
            <a href={s.href} data-menu-link class="flex items-baseline justify-between gap-4 border-b border-[var(--color-ink)]/15 py-3 no-underline">
              <span class="text-[18px] font-medium">{s.title}</span>
              {s.price && <span class="font-label text-[13px] uppercase tracking-[0.08em] whitespace-nowrap text-[var(--color-ink-muted)]">{s.price}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <ul class="flex flex-col gap-1">
      {[...links, { label: "Contact", href: contactHref }].map((l, i) => (
        <li>
          <a href={l.href} data-menu-link class="menu-link block no-underline" style={`--d:${(0.26 + i * 0.06).toFixed(2)}s`}>
            <span class="menu-mask">
              <span class="menu-inner font-display text-[clamp(36px,11vw,64px)] leading-[1] tracking-[-0.04em]">{l.label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="menu-fade mt-auto flex flex-col gap-3" style="--d:0.5s">
      <a href={`mailto:${email}`} data-menu-link class="font-label text-[15px] lowercase tracking-[0.05em] no-underline hover:underline underline-offset-4">{email}</a>
      <div class="flex gap-5 font-label text-[13px] uppercase tracking-[0.06em]">
        <a href={instagramUrl} target="_blank" rel="noopener" class="opacity-80 no-underline hover:opacity-100 hover:underline underline-offset-4">Instagram</a>
        <a href={linkedinUrl} target="_blank" rel="noopener" class="opacity-80 no-underline hover:opacity-100 hover:underline underline-offset-4">LinkedIn</a>
        <a href={behanceUrl} target="_blank" rel="noopener" class="opacity-80 no-underline hover:opacity-100 hover:underline underline-offset-4">Behance</a>
      </div>
    </div>
  </nav>
</div>

<style is:global>
  .site-nav {
    color: var(--color-ink);
    transition: transform 0.5s var(--ease-power3);
  }
  .site-nav[data-hidden="true"] {
    transform: translateY(-100%);
  }
  /* The row: the name, the links in the middle of the screen, the actions. */
  .nav-row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .nav-row {
      grid-template-columns: 1fr auto 1fr;
    }
  }
  /* Once scrolled, a floating bar from one side guide of the page to the
     other (global.css), crop marks just outside its corners (as `.marks`). */
  .nav-row::before,
  .nav-row::after {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-power3),
      transform 0.6s var(--ease-power3);
  }
  .nav-row::before {
    inset: 6px calc(var(--page-pad) / 2);
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    box-shadow: 0 12px 32px -20px rgb(16 37 70 / 0.35);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    transform: translateY(-6px) scale(0.99);
  }
  @media (min-width: 768px) {
    .nav-row::before {
      inset: 10px calc(var(--page-pad) / 2);
    }
    .nav-row::after {
      --m: var(--color-line);
      inset: 0 calc(var(--page-pad) / 2 - 10px);
      background:
        linear-gradient(var(--m), var(--m)) left 0 top 10px / 6px 1px no-repeat,
        linear-gradient(var(--m), var(--m)) left 10px top 0 / 1px 6px no-repeat,
        linear-gradient(var(--m), var(--m)) right 0 top 10px / 6px 1px no-repeat,
        linear-gradient(var(--m), var(--m)) right 10px top 0 / 1px 6px no-repeat,
        linear-gradient(var(--m), var(--m)) left 0 bottom 10px / 6px 1px no-repeat,
        linear-gradient(var(--m), var(--m)) left 10px bottom 0 / 1px 6px no-repeat,
        linear-gradient(var(--m), var(--m)) right 0 bottom 10px / 6px 1px no-repeat,
        linear-gradient(var(--m), var(--m)) right 10px bottom 0 / 1px 6px no-repeat;
    }
  }
  .site-nav[data-scrolled="true"] .nav-row::before,
  .site-nav[data-scrolled="true"] .nav-row::after {
    opacity: 1;
    transform: none;
  }

  /* ===== The name ===== Its letters come in one after the other on arrival,
     the dot last. Scrolled, all but the initials fold away (A•P), and come
     back under the pointer. */
  .brand {
    display: inline-flex;
    align-items: baseline;
  }
  .b-ch {
    display: inline-block;
    animation: b-in 0.8s var(--ease-power3) backwards;
    animation-delay: calc(0.12s + var(--c) * 35ms);
  }
  .b-dot {
    display: inline-block;
    width: 0.22em;
    height: 0.22em;
    margin-inline: 0.2em;
    border-radius: 50%;
    background: var(--color-accent);
    vertical-align: 0.14em;
    animation: b-dot 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.68s backwards;
  }
  @keyframes b-in {
    from {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(4px);
    }
  }
  @keyframes b-dot {
    from {
      transform: scale(0);
    }
  }
  .b-fold {
    display: inline-grid;
    grid-template-columns: 1fr;
    transition: grid-template-columns 0.7s var(--ease-power3);
  }
  .b-fold > span {
    min-width: 0;
    white-space: nowrap;
    /* Clipped sideways only, so the y keeps its tail. */
    clip-path: inset(-0.4em 0 -0.4em 0);
  }
  .b-fold .b-ch {
    transition:
      opacity 0.35s var(--ease-power3),
      transform 0.5s var(--ease-power3);
    transition-delay: calc(var(--k) * 25ms);
  }
  .site-nav[data-scrolled="true"] .b-fold {
    grid-template-columns: 0fr;
  }
  .site-nav[data-scrolled="true"] .b-fold .b-ch {
    opacity: 0;
    transform: translateX(-0.25em);
    transition-delay: 0s;
  }
  @media (hover: hover) {
    .site-nav[data-scrolled="true"] .brand:hover .b-fold {
      grid-template-columns: 1fr;
    }
    .site-nav[data-scrolled="true"] .brand:hover .b-fold .b-ch {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--k) * 25ms);
    }
  }
  .site-nav[data-scrolled="true"] .brand:focus-visible .b-fold {
    grid-template-columns: 1fr;
  }
  .site-nav[data-scrolled="true"] .brand:focus-visible .b-fold .b-ch {
    opacity: 1;
    transform: none;
  }

  /* The rest of the bar comes in after the name. */
  .nav-item {
    animation: nav-in 0.7s var(--ease-power3) backwards;
    animation-delay: calc(0.5s + var(--n, 0) * 60ms);
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  /* Under the home's entry animation, all of it waits for the page to be
     revealed (IntroBlueprint.astro). */
  html.intro-on:not(.intro-reveal) .site-nav :is(.b-ch, .b-dot, .nav-item) {
    animation-play-state: paused;
  }

  /* ===== Links ===== The label rolls up to a copy of itself; the page shown
     (and the one pointed at) gets the name's dot under it. */
  .nav-link {
    position: relative;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .roll {
    display: inline-grid;
    overflow: hidden;
  }
  .roll > span {
    grid-area: 1 / 1;
    transition: transform 0.5s var(--ease-power3);
  }
  .roll > span + span {
    transform: translateY(105%);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--color-accent);
    transform: scale(0);
    transition: transform 0.4s var(--ease-power3);
  }
  .nav-dd .nav-link::after {
    margin-left: -9px; /* under the word, not the chevron */
  }
  .nav-link[aria-current="page"]::after,
  .nav-link[aria-expanded="true"]::after,
  .nav-link:focus-visible::after {
    transform: none;
  }
  .nav-link:focus-visible .roll > span,
  .nav-cta:focus-visible .roll > span {
    transform: translateY(-105%);
  }
  .nav-link:focus-visible .roll > span + span,
  .nav-cta:focus-visible .roll > span + span {
    transform: none;
  }
  @media (hover: hover) {
    .nav-link:hover::after {
      transform: none;
    }
    .nav-link:hover .roll > span,
    .nav-cta:hover .roll > span {
      transform: translateY(-105%);
    }
    .nav-link:hover .roll > span + span,
    .nav-cta:hover .roll > span + span {
      transform: none;
    }
  }
  .dd-chevron {
    transition: transform 0.4s var(--ease-power3);
  }
  .nav-dd[data-open] .dd-chevron {
    transform: rotate(180deg);
  }

  /* ===== "Démarrer un projet" ===== A darker blue rises through it, the
     label rolls, the arrow in its own cell goes out and comes back in. */
  .nav-cta {
    position: relative;
    isolation: isolate;
    align-items: stretch;
    overflow: hidden;
    background: var(--color-accent);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.3s var(--ease-power3),
      opacity 0.4s var(--ease-power3),
      visibility 0.4s;
  }
  .nav-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-accent-strong);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-power3);
  }
  .cta-label {
    padding: 10px 16px 10px 18px;
  }
  .cta-arrow {
    display: grid;
    place-items: center;
    width: 38px;
    border-left: 1px solid rgb(255 255 255 / 0.22);
    overflow: hidden;
  }
  .cta-arrow svg {
    grid-area: 1 / 1;
    transition: transform 0.5s var(--ease-power3);
  }
  .cta-arrow svg + svg {
    transform: translateX(-200%);
  }
  .nav-cta:focus-visible::before {
    transform: none;
  }
  .nav-cta:focus-visible .cta-arrow svg {
    transform: translateX(200%);
  }
  .nav-cta:focus-visible .cta-arrow svg + svg {
    transform: none;
  }
  @media (hover: hover) {
    .nav-cta:hover::before {
      transform: none;
    }
    .nav-cta:hover .cta-arrow svg {
      transform: translateX(200%);
    }
    .nav-cta:hover .cta-arrow svg + svg {
      transform: none;
      transition-delay: 0.08s;
    }
  }
  .nav-cta:active {
    transform: scale(0.98);
  }
  /* On the home it steps aside while the hero's own is there to be clicked:
     no two of them on screen (HomeHero.astro marks the page once that one
     is gone), and drops back in once that one is gone. */
  html:has([data-hero-cta]):not([data-hero-cta-gone]) .nav-cta {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
  }

  /* Services dropdown — opens on hover (pointer) or click/keyboard. */
  .nav-dd {
    position: relative;
  }
  .nav-dd-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: -16px;
    width: 440px;
    padding: 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: 0 18px 40px -18px rgb(16 37 70 / 0.25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.2s var(--ease-power3),
      transform 0.25s var(--ease-power3),
      visibility 0s linear 0.25s;
  }
  /* Hover bridge so the pointer can travel from the button to the panel. */
  .nav-dd-panel::before {
    content: "";
    position: absolute;
    inset: -16px 0 auto;
    height: 16px;
  }
  .nav-dd[data-open] .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (hover: hover) {
    .nav-dd:hover .nav-dd-panel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }
  .dd-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-radius: 0;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 0.2s var(--ease-power3);
  }
  .dd-item:hover,
  .dd-item:focus-visible {
    background: var(--color-bg-shade);
  }
  /* A blue rule rises on the left of the service pointed at; the four come
     in one after the other as the panel opens. */
  .dd-item {
    position: relative;
  }
  .dd-item::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 0;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-power3);
  }
  .dd-item:hover::before,
  .dd-item:focus-visible::before {
    transform: none;
  }
  .nav-dd-panel li {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s var(--ease-power3),
      transform 0.45s var(--ease-power3);
  }
  .nav-dd[data-open] .nav-dd-panel li {
    opacity: 1;
    transform: none;
    transition-delay: calc(60ms + var(--n) * 45ms);
  }
  @media (hover: hover) {
    .nav-dd:hover .nav-dd-panel li {
      opacity: 1;
      transform: none;
      transition-delay: calc(60ms + var(--n) * 45ms);
    }
    .nav-dd:hover .dd-chevron {
      transform: rotate(180deg);
    }
  }

  /* Burger — two lines; the overlay's close button is locked to an ✕. */
  .burger-box {
    position: relative;
    display: block;
    width: 26px;
    height: 12px;
  }
  .burger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 0.4s var(--ease-power3);
  }
  .burger-line:nth-child(1) { top: 0; }
  .burger-line:nth-child(2) { bottom: 0; }
  .burger--close .burger-line:nth-child(1) { top: 50%; transform: translateY(-50%) rotate(45deg); }
  .burger--close .burger-line:nth-child(2) { bottom: 50%; transform: translateY(50%) rotate(-45deg); }

  /* Overlay — circle reveal from the burger (top-right). */
  .mobile-menu {
    clip-path: circle(0% at calc(100% - 32px) 32px);
    pointer-events: none;
    transition: clip-path 0.55s cubic-bezier(0.7, 0, 0.84, 0);
  }
  html[data-menu-open="true"] .mobile-menu {
    clip-path: circle(150% at calc(100% - 32px) 32px);
    pointer-events: auto;
    transition: clip-path 0.7s var(--ease-power3);
  }
  .menu-mask { display: block; overflow: hidden; padding-block: 0.06em; }
  .menu-inner {
    display: block;
    transform: translateY(115%);
    transition: transform 0.8s var(--ease-power3);
  }
  .menu-fade {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease-out, transform 0.5s var(--ease-power3);
  }
  html[data-menu-open="true"] .menu-inner { transform: none; transition-delay: var(--d); }
  html[data-menu-open="true"] .menu-fade { opacity: 1; transform: none; transition-delay: var(--d); }
  html[data-menu-open="true"] body { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .nav-dd-panel,
    .mobile-menu,
    .menu-inner,
    .menu-fade,
    .burger-line { transition: none; }
    .menu-inner,
    .menu-fade { transform: none; opacity: 1; }
    .site-nav :is(.b-ch, .b-dot, .nav-item) { animation: none; }
    .nav-row::before,
    .nav-row::after,
    .b-fold,
    .b-fold .b-ch,
    .roll > span,
    .nav-link::after,
    .nav-cta,
    .nav-cta::before,
    .cta-arrow svg,
    .nav-dd-panel li { transition: none; }
  }
</style>

<script>
  // Smart nav: the floating bar and the folded name once scrolled; hide on
  // scroll-down, show on scroll-up.
  (() => {
    const nav = document.querySelector<HTMLElement>("[data-nav-smart]");
    if (!nav) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const HIDE_AFTER = 120;
    const DELTA = 6;
    let lastY = window.scrollY;
    let ticking = false;
    // The home's scroll sequences (home-seq.ts) mark the page: the nav stays
    // while they hold the screen, and has its background over any of their
    // scenes but the hero's (one played back at the very top).
    const root = document.documentElement;
    const pinned = () => root.dataset.seqHold === "on";

    const update = () => {
      const y = window.scrollY;
      nav.dataset.scrolled = String(y > 8 || (root.dataset.seqLayer ?? "hero") !== "hero");
      if (!reduce) {
        const delta = y - lastY;
        if (y < HIDE_AFTER || delta < -DELTA || pinned()) nav.dataset.hidden = "false";
        else if (delta > DELTA && !nav.querySelector("[data-dd][data-open]")) nav.dataset.hidden = "true";
      }
      lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    // (In the same frame as the sequences change them.)
    new MutationObserver(update).observe(root, { attributes: true, attributeFilter: ["data-seq-hold", "data-seq-layer"] });
    // They also give back the room they kept below them by moving the page
    // up under the reader, scroll and all: not a scroll up.
    window.addEventListener("seq:reclaim", () => (lastY = window.scrollY));
  })();

  // Services dropdown — click / Enter toggles, Esc or outside click closes.
  (() => {
    const dd = document.querySelector<HTMLElement>("[data-dd]");
    const btn = dd?.querySelector<HTMLButtonElement>("[data-dd-toggle]");
    if (!dd || !btn) return;
    const set = (open: boolean) => {
      dd.toggleAttribute("data-open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", () => set(!dd.hasAttribute("data-open")));
    document.addEventListener("click", (e) => {
      if (!dd.contains(e.target as Node)) set(false);
    });
    dd.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        set(false);
        btn.focus();
      }
    });
    dd.addEventListener("focusout", (e) => {
      if (!dd.contains(e.relatedTarget as Node)) set(false);
    });
  })();

  // Full-screen menu — open/close, focus trap, Esc, close on link tap.
  (() => {
    const root = document.documentElement;
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!toggle || !menu) return;
    const closeBtn = menu.querySelector<HTMLButtonElement>("[data-menu-close]");
    const focusables = (): HTMLElement[] =>
      Array.from(menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));

    let open = false;
    const setOpen = (v: boolean): void => {
      if (v === open) return;
      open = v;
      root.dataset.menuOpen = v ? "true" : "false";
      toggle.setAttribute("aria-expanded", String(v));
      menu.setAttribute("aria-hidden", String(!v));
      menu.toggleAttribute("inert", !v);
      if (v) (closeBtn ?? focusables()[0])?.focus();
      else toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(true));
    closeBtn?.addEventListener("click", () => setOpen(false));
    menu.querySelectorAll<HTMLElement>("[data-menu-link]").forEach((a) =>
      a.addEventListener("click", () => setOpen(false))
    );
    document.addEventListener("keydown", (e) => {
      if (!open) return;
      if (e.key === "Escape") {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key === "Tab") {
        const f = focusables();
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (m) => {
      if (m.matches) setOpen(false);
    });
  })();
</script>

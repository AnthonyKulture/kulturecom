---
import type { Lang } from "~/i18n/ui";
import { getHomeContent } from "~/lib/home-content";
import { caseStudyPath } from "~/lib/case-studies";
import Eyebrow from "~/components/Eyebrow.astro";
import ClimbScene from "~/components/ClimbScene.astro";
import WorkCards from "~/components/WorkCards.astro";
import GearScene from "~/components/GearScene.astro";
import WaterfallDots from "~/components/WaterfallDots.astro";
import WaterfallScene from "~/components/WaterfallScene.astro";
import { GOOGLE_PROFILE } from "~/lib/facts";

// Home body between the hero and the contact block:
// "Conçu. Codé. Cité." (+ freelance / agency / platform table) → 3 recent
// case studies → Google reviews → FAQ. One layout family per section.
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getHomeContent(lang);
const workHref = lang === "fr" ? "/projets/" : "/en/work/";
// The comparison's answers start in lower case (they used to follow "Agence :").
const cap = (text: string): string => text.charAt(0).toUpperCase() + text.slice(1);
const sheet = (n: string, fr: string, en: string): string => (lang === "fr" ? `Planche ${n} · ${fr}` : `Sheet ${n} · ${en}`);
// Phones show the first questions, the others one tap away (still in the
// page, for search engines and AI answers; FAQPage data covers them all).
const FAQ_FIRST = 4;
const rating = GOOGLE_PROFILE.rating.toLocaleString(lang === "fr" ? "fr-FR" : "en-GB", { minimumFractionDigits: 1 });


const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": lang === "fr" ? "fr-FR" : "en-US",
  "mainEntity": c.faq.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

{/* Conçu. Codé. Cité. — the waterfall drawing on the right, the manifesto
    rows on the left (each word facing its line). A scroll sequence
    (WaterfallDots.astro): pinned, it opens inside the hiker's backpack where
    the hero's dive ended, pulls back to the waterfall, then the text comes
    in; last, still pinned, the water rises from the bottom in dots and
    fills the screen with the blue of the projects below. The spacer gives it the
    scroll it needs (only with the sequence). */}
<div data-approach-seq>
<section class="relative px-4 py-20 sm:px-6 md:px-12 md:py-32" data-approach>
  <WaterfallDots />
  <canvas class="flood" data-flood aria-hidden="true"></canvas>
  <div class="relative z-[1] mx-auto w-full max-w-[var(--container-wide)]" data-approach-content>
    <div data-seq-item>
      <Eyebrow label={sheet("01", "Approche", "Approach")} class="mb-6 md:mb-8" />
    </div>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <figure class="approach-visual lg:order-2" aria-hidden="true">
        <WaterfallScene />
      </figure>
      <div>
        <h2 data-seq-item class="max-w-[24ch] font-display text-title">{c.pillarsTitle}</h2>
        <ol class="pillars mt-8 md:mt-12">
          {c.pillars.map((p) => (
            <li data-seq-item class="grid grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] items-center gap-5 border-t border-[var(--color-ink)]/15 py-5 md:gap-8 md:py-7">
              <span class="pillar-word inline-block font-display text-[var(--color-accent)]" data-vapor>{p.word}</span>
              <p class="text-body text-[var(--color-ink-muted)]">{p.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
<div data-seq-spacer class="seq-spacer" aria-hidden="true"></div>
</div>

{/* Recent work — the case studies as cards, images always in view
    (WorkCards.astro), beside the title and the hiker walking up a slope, on
    the blue the approach's water filled the screen with: text and drawing in
    white. With the approach's sequence it is pulled up over its last screen,
    so it pins the moment the water has filled it, and its entrance follows
    the scroll, quickly: the title word by word coming clear (as React Bits'
    Scroll Reveal), the label and the link, the cards rising one after the
    other, and the drawing condensing out of vapor (ClimbScene.astro). The
    spacer gives it the little scroll it needs (only with the sequence). */}
<div data-work-seq>
<section data-surface="blue" class="work bg-[var(--color-bg)] px-4 py-20 text-[var(--color-ink)] sm:px-6 md:px-12 md:py-32" data-work>
  <div class="work-inner mx-auto grid w-full max-w-[var(--container-wide)] gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="work-side flex min-w-0 flex-col lg:col-span-4">
      <div data-in-item>
        <Eyebrow label={sheet("02", "Projets", "Work")} class="mb-6 md:mb-8" />
      </div>
      <h2 class="font-display text-title" data-in-tilt>
        {c.workTitle.split(" ").map((w, i) => (
          <>{i > 0 && " "}<span class="work-word" data-in-word>{w}</span></>
        ))}
      </h2>
      <a href={workHref} data-in-item class="mt-4 self-start font-label text-small uppercase tracking-[0.06em] text-[var(--color-ink)] underline underline-offset-4">{c.workAll}</a>
      <figure class="climb-visual" aria-hidden="true">
        <ClimbScene />
      </figure>
    </div>
    <div class="work-cards min-w-0 lg:col-span-8">
      <WorkCards lang={lang} />
    </div>
  </div>
</section>
<div data-seq-spacer class="seq-spacer" aria-hidden="true"></div>
</div>

{/* Freelance, agency or platform. */}
<section class="px-4 py-20 sm:px-6 md:px-12 md:py-32" data-reveal>
  <div class="mx-auto w-full max-w-[var(--container-wide)]">
    <Eyebrow label={sheet("03", "Comparatif", "Comparison")} class="mb-6 md:mb-8" />
    {/* Freelance / agency / platform (same 4/8 split as the reviews and the
        FAQ): a real table, one row per criterion, one column per option, my
        column tinted blue so it reads at a glance. On phones each criterion
        becomes a small card: my answer first, then the agency and the
        platform, each under its name. */}
    <div class="grid gap-8 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4 md:flex md:flex-col">
        <h3 class="max-w-[22ch] font-display text-title">{c.compare.title[0]} <span class="text-[var(--color-accent)]">{c.compare.title[1]}</span></h3>
        <p class="mt-4 max-w-[40ch] text-body text-[var(--color-ink-muted)]">{c.compare.lead}</p>
        {/* His camp, in the white space under the title, level with the end
            of the list (wide screens). */}
        <div class="hidden max-w-[440px] pt-12 md:mt-auto md:block" aria-hidden="true">
          <GearScene />
        </div>
      </div>
      <table class="compare text-body md:col-span-8">
        <caption class="sr-only">{c.compare.title[0]} {c.compare.title[1]}</caption>
        <colgroup>
          <col class="compare-col-label" />
          <col class="compare-col-me" />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr class="font-display text-title">
            <td></td>
            <th scope="col" class="is-me">{c.compare.me}</th>
            <th scope="col">{c.compare.agency}</th>
            <th scope="col">{c.compare.platform}</th>
          </tr>
        </thead>
        <tbody>
          {c.compare.rows.map((r) => (
            <tr>
              <th scope="row" class="font-label text-small uppercase tracking-[0.06em]">{r.label}</th>
              <td class="is-me" data-label={c.compare.me}>{cap(r.me)}</td>
              <td data-label={c.compare.agency}>{cap(r.agency)}</td>
              <td data-label={c.compare.platform}>{cap(r.platform)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {/* Phones: the same comparison as three cards to swipe through, one
          per option, mine first (in blue); every criterion on each card, so
          an option reads at a glance. Replaces the table there. */}
      <div class="compare-swipe md:hidden" data-compare-swipe>
        <div class="cs-track" data-cs-track>
          {([["me", c.compare.me], ["agency", c.compare.agency], ["platform", c.compare.platform]] as const).map(([key, name], i) => (
            <section class:list={["cs-card", key === "me" && "is-me"]} aria-label={name}>
              <p class="cs-head">
                <span class="cs-num font-label text-small">{`0${i + 1} / 03`}</span>
                <span class="cs-name font-display">{name}</span>
              </p>
              <dl class="cs-rows">
                {c.compare.rows.map((r) => (
                  <div class="cs-row">
                    <dt class="font-label text-small uppercase tracking-[0.06em]">{r.label}</dt>
                    <dd>{cap(r[key])}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>
        <div class="cs-foot">
          <span class="cs-dots" aria-hidden="true">
            <span data-cs-dot data-on></span><span data-cs-dot></span><span data-cs-dot></span>
          </span>
          <span class="font-label text-small uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">{lang === "fr" ? "Glissez pour comparer →" : "Swipe to compare →"}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{/* Google reviews: rating + four quotes (businesses first), linked to the profile. Visible
    text only, no AggregateRating markup: Google ignores a business's ratings
    of itself and reviews taken from another site. The quotes glide slowly in
    a loop (script), at a steady pace; they stop on
    hover, on keyboard focus or with the pause button. With reduced motion:
    a plain row to swipe. */}
<section class="px-4 pb-20 sm:px-6 md:px-12 md:pb-32" data-reveal data-reviews>
  <div class="mx-auto w-full max-w-[var(--container-wide)]">
    <Eyebrow label={sheet("04", "Avis", "Reviews")} class="mb-6 md:mb-8" />
  </div>
  <div class="mx-auto grid w-full max-w-[var(--container-wide)] gap-8 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-4">
      <h2 class="font-display text-title">{c.reviewsTitle}</h2>
      <p class="mt-6 flex items-center gap-4" aria-label={lang === "fr" ? `Note moyenne ${rating} sur 5` : `Average rating ${rating} out of 5`}>
        <span class="font-display text-display leading-none" aria-hidden="true">{rating}</span>
        <span class="stars" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => (
            <svg viewBox="0 0 20 20" width="20" height="20"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3.1-5.4 3.1 1.2-6L1.3 7.8l6.1-.7z" /></svg>
          ))}
        </span>
      </p>
      <p class="mt-2 text-body text-[var(--color-ink-muted)]">{GOOGLE_PROFILE.reviewCount} {c.reviewsCount}</p>
      <a href={GOOGLE_PROFILE.url} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 text-body font-medium text-[var(--color-accent)] underline underline-offset-4 hover:text-[var(--color-accent-strong)]">
        {c.reviewsLink} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="reviews-loop min-w-0 md:col-span-8">
      <div class="reviews-viewport">
        <ul class="reviews-track" data-reviews-track>
          {[...c.reviews, ...c.reviews].map((r, i) => {
            const copy = i >= c.reviews.length;
            return (
              <li class="review" style={`--i:${i % c.reviews.length}`} aria-hidden={copy ? "true" : undefined} data-copy={copy ? "" : undefined}>
                <figure>
                  <blockquote class="text-body text-[var(--color-ink)]">
                    <p>{lang === "fr" ? `« ${r.quote} »` : `“${r.quote}”`}</p>
                  </blockquote>
                  <figcaption class="mt-5 text-small">
                    <span class="font-medium">{r.author}</span>
                    <span class="text-[var(--color-ink-muted)]"> · {lang === "fr" ? "Avis Google" : "Google review"}</span>
                  </figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
      <div class="mt-5 flex items-center justify-between gap-4">
        {c.reviewsNote ? <p class="text-small text-[var(--color-ink-muted)]">{c.reviewsNote}</p> : <span />}
        <button type="button" class="loop-pause font-label text-small uppercase tracking-[0.06em]" data-reviews-pause aria-pressed="false" data-label-pause={lang === "fr" ? "Pause" : "Pause"} data-label-play={lang === "fr" ? "Lecture" : "Play"}>
          {lang === "fr" ? "Pause" : "Pause"}
        </button>
      </div>
    </div>
  </div>
</section>

{/* FAQ — question list on the right, heading + aside on the left. The
    questions rise in one after the other; an answer unfolds smoothly. */}
<section class="px-4 py-20 sm:px-6 md:px-12 md:py-32" data-reveal data-faq>
  <div class="mx-auto w-full max-w-[var(--container-wide)]">
    <Eyebrow label={sheet("05", "Questions", "Questions")} class="mb-6 md:mb-8" />
  </div>
  <div class="mx-auto grid w-full max-w-[var(--container-wide)] gap-8 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-4">
      <h2 class="font-display text-title">{c.faqTitle}</h2>
      <p class="mt-4 max-w-[30ch] text-body text-[var(--color-ink-muted)]">
        <a href="#contact" class="text-[var(--color-ink)] underline underline-offset-4 hover:text-[var(--color-accent)]">{c.faqAside}</a>
      </p>
    </div>
    <div class="faq-list md:col-span-8" data-faq-list>
      {c.faq.map((f, i) => (
        <details class:list={["faq group", i >= FAQ_FIRST && "faq-more"]} style={`--i:${i}`}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-body">
            <h3 class="font-[inherit] text-[inherit]">{f.q}</h3>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer pb-6">
            <p class="max-w-[64ch] text-body text-[var(--color-ink-muted)]">{f.a}</p>
            {f.link && (
              <a href={f.link.href} class="mt-3 inline-flex items-center gap-2 text-body text-[var(--color-accent)] underline underline-offset-4 hover:text-[var(--color-accent-strong)]">
                {f.link.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </details>
      ))}
      {c.faq.length > FAQ_FIRST && (
        <button type="button" class="faq-all font-label text-small uppercase tracking-[0.06em] md:hidden" data-faq-all aria-expanded="false">
          {lang === "fr" ? `Voir les ${c.faq.length - FAQ_FIRST} autres questions` : `See the ${c.faq.length - FAQ_FIRST} other questions`} <span aria-hidden="true">+</span>
        </button>
      )}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />
</section>

<style>
  /* ===== Approche: scroll sequence ===== Pinned while the spacer scrolls by
     (WaterfallDots.astro sets data-seq="on"). */
  [data-approach-seq][data-seq="on"] > [data-approach] {
    position: sticky;
    top: 0;
  }
  /* Wide screens: while it plays, the section holds in one screen, its
     content centred, the drawing no taller than the screen allows. */
  @media (min-width: 1024px) {
    [data-approach-seq][data-seq="on"] > [data-approach] {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      padding-top: 80px;
      padding-bottom: 48px;
    }
    [data-approach-seq][data-seq="on"] .approach-visual {
      max-width: calc((100svh - 200px) * 600 / 680);
    }
  }
  /* Pulled up over the hero's last screen (WaterfallDots.astro): on top of
     it, and opaque, so the hero leaving underneath never shows. */
  [data-approach-seq][data-overlap="on"] {
    position: relative;
    z-index: 2;
  }
  [data-approach-seq][data-overlap="on"] > [data-approach] {
    background: var(--color-bg);
  }
  .seq-spacer {
    display: none;
  }
  [data-approach-seq][data-seq="on"] > .seq-spacer {
    display: block;
    height: 162vh;
  }
  @media (max-width: 767px) {
    [data-approach-seq][data-seq="on"] > .seq-spacer {
      height: 122vh;
    }
  }
  /* The water rising at the end of the pin, in dots (WaterfallDots.astro
     draws it): over everything in the section, in the projects' blue. */
  .flood {
    display: none;
  }
  [data-approach-seq][data-seq="on"] .flood {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-accent);
    pointer-events: none;
  }
  /* On phones the drawing sits above the text, not too tall. */
  .approach-visual {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .approach-visual {
      max-width: none;
    }
  }
  /* The three words share the hero title's display size. */
  .pillars :global(.pillar-word) {
    font-size: var(--text-display);
    line-height: 1;
  }
  /* ===== Projets ===== Wide screens: one screen tall, the cards taking
     the height the section gives them; the drawing at the foot of the side
     column, as tall as what is left there. */
  @media (min-width: 1024px) {
    .work {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
    }
    .work-inner {
      height: clamp(520px, calc(100svh - 190px), 900px);
    }
  }
  .climb-visual {
    display: flex;
    max-width: 420px;
    justify-content: center;
    margin-top: 32px;
  }
  .climb-visual :global(.climb-dots) {
    max-height: 42svh;
  }
  /* Phones: the title and the drawing stay at the top (under the nav, the
     script sets the offsets) while the project cards slide up under them
     and stack (WorkCards.astro). */
  @media (max-width: 767px) {
    .work-inner {
      gap: 0;
    }
    .work-side {
      position: sticky;
      top: var(--nav-h, 56px);
      z-index: 2;
      margin-inline: -16px;
      padding: 8px 16px 16px;
      background: var(--color-bg);
    }
    .climb-visual {
      max-height: 20svh;
      margin-top: 8px;
      overflow: hidden;
      transition:
        max-height 0.6s var(--ease-power3),
        margin 0.6s var(--ease-power3),
        opacity 0.4s var(--ease-power3);
    }
    .climb-visual :global(.climb-dots) {
      max-height: 17svh;
    }
    /* Once the first card is in, the drawing gives its room to the
       projects (the cards rise with it, see the script). */
    .work-side[data-compact] .climb-visual {
      max-height: 0;
      margin-top: 0;
      opacity: 0;
    }
  }
  @media (min-width: 1024px) {
    .climb-visual {
      min-height: 0;
      max-width: none;
      flex: 1 1 0;
      align-items: flex-end;
    }
    .climb-visual :global(.climb-dots) {
      width: auto;
      max-width: 100%;
      height: 100%;
      max-height: none;
    }
  }
  .work-word {
    display: inline-block;
  }
  [data-work-seq][data-seq="on"] [data-in-tilt] {
    transform-origin: 0 50%;
  }
  /* Its scroll sequence (script below): pulled up over the approach's last
     screen, pinned while the spacer scrolls by. */
  [data-work-seq][data-seq="on"] {
    position: relative;
    z-index: 3;
  }
  [data-work-seq][data-seq="on"] > [data-work] {
    position: sticky;
    top: 0;
    padding-top: 88px;
    padding-bottom: 40px;
  }
  [data-work-seq][data-seq="on"] > .seq-spacer {
    display: block;
    height: 45vh;
  }
  /* Phones: not pinned as a whole (the cards' stack is the sequence there),
     so no spacer. */
  @media (max-width: 767px) {
    [data-work-seq][data-seq="on"] > [data-work] {
      position: relative;
      padding-top: 72px;
    }
    [data-work-seq][data-seq="on"] > .seq-spacer {
      display: none;
    }
  }
  /* ===== Freelance / agency / platform ===== */
  .compare {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .compare-col-label {
    width: 22%;
  }
  .compare-col-me {
    width: 30%;
  }
  .compare thead th {
    padding: 0 16px 16px;
    text-align: left;
    font-weight: 600; /* as .font-display, over the th's own bold */
    color: var(--color-ink);
    vertical-align: bottom;
  }
  /* My column: solid blue all the way down, white text, its name after the
     site's small square (white here). */
  .compare .is-me {
    background: var(--color-accent);
    color: #ffffff;
  }
  .compare thead th.is-me {
    padding-top: 18px;
    color: #ffffff;
  }
  .compare thead th.is-me::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin: 0 10px 0.18em 0;
    background: #ffffff;
  }
  /* Between two rows, a faint white line inside the blue. */
  .compare tbody td.is-me {
    border-top: 1px solid color-mix(in srgb, #ffffff 22%, transparent);
  }
  .compare tbody tr {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .compare tbody tr:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .compare tbody th {
    padding: 20px 16px 20px 0;
    text-align: left;
    font-weight: 400;
    color: var(--color-ink-muted);
    vertical-align: top;
  }
  .compare td {
    padding: 18px 16px;
    vertical-align: top;
    color: var(--color-ink-muted);
  }
  .compare td.is-me {
    color: #ffffff;
    font-weight: 500;
  }
  /* Phones: the swipe cards instead of the table. */
  @media (max-width: 767px) {
    .compare {
      display: none;
    }
  }
  .compare-swipe {
    min-width: 0;
  }
  .cs-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    margin-inline: -16px;
    padding: 4px 16px 8px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }
  .cs-track::-webkit-scrollbar {
    display: none;
  }
  .cs-card {
    scroll-snap-align: start;
    padding: 20px 18px 8px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    background: var(--color-bg);
  }
  .cs-card.is-me {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #ffffff;
  }
  .cs-head {
    display: grid;
    gap: 6px;
    padding-bottom: 14px;
  }
  .cs-num {
    color: var(--color-ink-muted);
  }
  .is-me .cs-num {
    color: color-mix(in srgb, #ffffff 70%, transparent);
  }
  .cs-name {
    font-size: var(--text-title);
    line-height: 1.1;
  }
  .is-me .cs-name::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin: 0 10px 0.2em 0;
    background: #ffffff;
  }
  .cs-row {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }
  .is-me .cs-row {
    border-top-color: color-mix(in srgb, #ffffff 22%, transparent);
  }
  .cs-row dt {
    color: var(--color-ink-muted);
  }
  .is-me .cs-row dt {
    color: color-mix(in srgb, #ffffff 72%, transparent);
  }
  .cs-row dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .is-me .cs-row dd {
    color: #ffffff;
    font-weight: 500;
  }
  .cs-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }
  .cs-dots {
    display: inline-flex;
    gap: 6px;
  }
  .cs-dots > span {
    width: 18px;
    height: 2px;
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
    transition:
      width 0.35s var(--ease-power3),
      background 0.35s var(--ease-power3);
  }
  .cs-dots > span[data-on] {
    width: 34px;
    background: var(--color-accent);
  }

  .loop-pause {
    padding: 6px 0;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .loop-pause:hover,
  .loop-pause:focus-visible {
    color: var(--color-accent);
  }
  /* Reduced motion: no loop, a row to swipe. */
  @media (prefers-reduced-motion: reduce) {
    .loop-pause {
      display: none;
    }
  }

  .stars {
    display: inline-flex;
    gap: 3px;
    color: var(--color-accent);
  }
  .stars svg {
    fill: currentColor;
  }
  /* ===== Reviews: a slow loop of quotes ===== */
  .reviews-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 82%, transparent);
    mask-image: linear-gradient(90deg, #000 0, #000 82%, transparent);
  }
  /* Phones: no loop of quotes (too heavy there), just the rating and the
     link to the reviews. */
  @media (max-width: 767px) {
    .reviews-loop {
      display: none;
    }
  }
  .reviews-track {
    display: flex;
    align-items: flex-start;
    width: max-content;
    will-change: transform;
  }
  .review {
    flex: 0 0 auto;
    width: clamp(260px, 26vw, 360px);
    margin-right: clamp(28px, 3vw, 48px);
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .review blockquote {
    margin: 0;
  }
  /* Entry: the quotes rise in one after the other. */
  .reveal-on [data-reviews] .review {
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 0.8s var(--ease-power3) calc(var(--i) * 110ms + 150ms),
      translate 0.8s var(--ease-power3) calc(var(--i) * 110ms + 150ms);
  }
  .reveal-on [data-reviews][data-revealed] .review {
    opacity: 1;
    translate: 0 0;
  }
  /* Reduced motion: no loop, a row to swipe. */
  @media (prefers-reduced-motion: reduce) {
    .reviews-viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .review {
      scroll-snap-align: start;
    }
    .review[data-copy] {
      display: none;
    }
  }

  /* ===== FAQ ===== Phones: the first questions, then a button for the rest. */
  @media (max-width: 767px) {
    .faq-list:not([data-all]) .faq-more {
      display: none;
    }
  }
  .faq-all {
    display: inline-flex;
    gap: 8px;
    margin-top: 18px;
    padding: 6px 0;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  /* ===== FAQ ===== */
  .faq-list {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .faq {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    interpolate-size: allow-keywords;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary {
    transition: color 0.3s var(--ease-power3);
  }
  .faq summary:hover,
  .faq[open] summary {
    color: var(--color-accent);
  }
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-top: 7px;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-power3);
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }
  /* Smooth unfold where the browser supports animating <details>; elsewhere
     it simply opens. */
  .faq::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease-power3),
      content-visibility 0.5s allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
  }
  .faq-answer {
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.4s var(--ease-power3),
      translate 0.4s var(--ease-power3);
  }
  .faq[open] .faq-answer {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.08s;
  }
  /* Entry: the questions rise in one after the other. */
  .reveal-on [data-faq] .faq {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 0.7s var(--ease-power3) calc(var(--i) * 80ms + 150ms),
      translate 0.7s var(--ease-power3) calc(var(--i) * 80ms + 150ms);
  }
  .reveal-on [data-faq][data-revealed] .faq {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq summary,
    .faq-answer,
    .faq::details-content,
    .faq-icon::before,
    .faq-icon::after {
      transition: none;
    }
    .faq-answer {
      opacity: 1;
      translate: none;
    }
  }
</style>

<script>
  import { Hold, follow } from "~/lib/camera";
  import { initMarquee } from "~/lib/marquee";

  // Projets on the blue: once the approach's sequence is on (its script has
  // run by the first frame), pin this section too, pulled up over the
  // approach's last screen so it is there the moment the water has filled
  // it, and play its entrance with the scroll through the pin (eased a
  // little), so scrolling back and forth runs it back and forth at once.
  const workSeq = document.querySelector<HTMLElement>("[data-work-seq]");
  const work = workSeq?.querySelector<HTMLElement>("[data-work]");
  const workSpacer = workSeq?.querySelector<HTMLElement>("[data-seq-spacer]");
  if (workSeq && work && workSpacer && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    requestAnimationFrame(() => {
      const prev = document.querySelector<HTMLElement>("[data-approach-seq]");
      const prevStage = prev?.querySelector<HTMLElement>("[data-approach]");
      if (prev?.dataset.seq !== "on" || !prevStage) return;
      workSeq.dataset.seq = "on";
      work.dataset.wait = "";
      const lift = (): void => {
        workSeq.style.marginTop = `${-prevStage.offsetHeight}px`;
      };

      // What comes in, and when (shares of the pin): [element, from, to, kind].
      // All of it in by the end. The words start faint and
      // blurred and come clear one after the other while the title levels
      // out of a slight tilt; the cards rise and wipe up one after another.
      type Kind = "fade" | "word" | "tilt" | "card";
      const steps: [HTMLElement, number, number, Kind][] = [];
      const items = [...work.querySelectorAll<HTMLElement>("[data-in-item]")];
      steps.push([items[0], 0, 0.25, "fade"]);
      const tilt = work.querySelector<HTMLElement>("[data-in-tilt]");
      if (tilt) steps.push([tilt, 0, 0.45, "tilt"]);
      work.querySelectorAll<HTMLElement>("[data-in-word]").forEach((el, i) => steps.push([el, i * 0.1, 0.3 + i * 0.1, "word"]));
      if (items[1]) steps.push([items[1], 0.2, 0.45, "fade"]);
      // (Phones: the cards come in with the scroll, stacking; not here.)
      const phone = window.innerWidth < 768;
      if (!phone) work.querySelectorAll<HTMLElement>("[data-card]").forEach((card, i) => steps.push([card, 0.12 + i * 0.1, 0.55 + i * 0.1, "card"]));
      const ease = (v: number): number => 1 - (1 - v) ** 3;
      const last = new Map<HTMLElement, number>();
      const apply = (p: number): void => {
        for (const [el, from, to, kind] of steps) {
          const e = ease(Math.min(1, Math.max(0, (p - from) / (to - from))));
          const key = Math.round(e * 1000);
          if (last.get(el) === key) continue;
          last.set(el, key);
          const done = e >= 1;
          if (kind === "tilt") {
            el.style.rotate = done ? "" : `${(3 * (1 - e)).toFixed(3)}deg`;
          } else if (kind === "word") {
            el.style.opacity = done ? "" : (0.1 + 0.9 * e).toFixed(3);
            el.style.filter = done ? "" : `blur(${(4 * (1 - e)).toFixed(2)}px)`;
          } else if (kind === "fade") {
            el.style.opacity = done ? "" : e.toFixed(3);
            el.style.translate = done ? "" : `0 ${(10 * (1 - e)).toFixed(2)}px`;
            el.style.filter = done ? "" : `blur(${(4 * (1 - e)).toFixed(2)}px)`;
          } else {
            // A card: it rises, its image wipes up out of a zoom, its
            // caption follows.
            el.style.translate = done ? "" : `0 ${(36 * (1 - e)).toFixed(2)}px`;
            const media = el.querySelector<HTMLElement>("[data-card-media]");
            const img = media?.querySelector<HTMLElement>("img");
            const text = el.querySelector<HTMLElement>("[data-card-text]");
            if (media) media.style.clipPath = done ? "" : `inset(${((1 - e) * 100).toFixed(2)}% 0 0 0)`;
            if (img) img.style.scale = done ? "" : (1 + 0.18 * (1 - e)).toFixed(4);
            if (text) text.style.opacity = done ? "" : Math.max(0, e * 1.6 - 0.6).toFixed(3);
          }
        }
        // The drawing's vapor reads it (ClimbScene.astro).
        work.dataset.in = p.toFixed(4);
      };

      // Once the scroll reaches it (it pins, the water has filled the
      // screen), the entrance plays through to the end at its own pace, never
      // left half done; it plays back the same way once the scroll goes back
      // above it. Held on screen while it falls well behind the scroll.
      const ENTER_TIME = 2; // unhurried: each card is seen arriving
      const LAG = 0.12;
      const hold = new Hold(work, workSeq);
      let r = 0;
      let raf = 0;
      let then = 0;
      let shown: boolean | null = null;
      const tick = (now: number): void => {
        const dt = then ? Math.min(0.05, (now - then) / 1000) : 1 / 60;
        then = now;
        const filled = prev.dataset.filled === "on";
        const up = hold.holdingUp();
        const pinned = hold.natural() <= 0.5;
        const waiting = !filled && !up;
        const target = !waiting && pinned ? 1 : 0;
        r = follow(r, target, dt, 0.12, 1 / ENTER_TIME);
        // (Phones: the section is not pinned, nothing to hold.)
        const behind = hold.threshold(LAG);
        if (hold.update(dt, !phone && r < target - behind, !phone && r > target + behind)) r = target;
        // Hidden until it pins over the approach and the water has filled it.
        const on = hold.holdingUp() || (pinned && filled);
        if (on !== shown) {
          shown = on;
          work.style.visibility = on ? "" : "hidden";
          workSeq.dataset.shown = on ? "on" : "";
          cardsIn();
        }
        apply(on ? r : 0);
        const busy = r !== target || hold.active() || (pinned && !filled);
        raf = busy ? requestAnimationFrame(tick) : 0;
        if (!raf) then = 0;
      };
      const kick = (): void => {
        if (!raf) raf = requestAnimationFrame(tick);
      };
      // Phones: each card comes in as it slides onto the screen (WorkCards'
      // data-in), once the section itself is there; back out below it.
      const cardList = work.querySelector<HTMLElement>("[data-cards]");
      const cards = cardList ? [...cardList.querySelectorAll<HTMLElement>("[data-card]")] : [];
      let sideFull = 0; // the title block's height with its drawing
      const cardsIn = (): void => {
        if (!phone || !cardList) return;
        cardList.dataset.wait = "";
        const vh = window.innerHeight;
        // The drawing folds away once the first card has reached its place
        // under the title (and comes back above it).
        if (side) {
          if (!side.hasAttribute("data-compact")) sideFull = side.offsetHeight;
          // (Once it has risen a little past where it rests at first.)
          const reached = cardList.getBoundingClientRect().top < (nav?.offsetHeight ?? 56) + sideFull - 60;
          side.toggleAttribute("data-compact", reached);
        }
        cards.forEach((card) => {
          const r = card.getBoundingClientRect();
          card.toggleAttribute("data-in", workSeq.dataset.shown === "on" && r.top < vh * 0.9);
        });
      };
      window.addEventListener("scroll", cardsIn, { passive: true });
      // Phones: the title block sticks under the nav, the cards stack under it.
      const nav = document.querySelector<HTMLElement>("[data-nav-smart]");
      const side = work.querySelector<HTMLElement>(".work-side");
      const stack = (): void => {
        if (!side) return;
        const navH = nav?.offsetHeight ?? 56;
        work.style.setProperty("--nav-h", `${navH}px`);
        work.style.setProperty("--stack-top", `${navH + side.offsetHeight + 12}px`);
      };
      // The cards' place follows the title block as the drawing folds.
      if (side) new ResizeObserver(stack).observe(side);
      lift();
      stack();
      document.fonts?.ready.then(stack);
      kick();
      window.addEventListener("resize", () => {
        lift();
        stack();
        kick();
      });
      window.addEventListener("scroll", kick, { passive: true });
    });
  }

  // The comparison's swipe cards (phones): the dots follow the card in view.
  const csTrack = document.querySelector<HTMLElement>("[data-cs-track]");
  const csDots = [...document.querySelectorAll<HTMLElement>("[data-cs-dot]")];
  if (csTrack && csDots.length) {
    const sync = (): void => {
      const first = csTrack.firstElementChild as HTMLElement | null;
      const step = first ? first.offsetWidth + 12 : csTrack.clientWidth;
      const i = Math.round(csTrack.scrollLeft / step);
      csDots.forEach((d, j) => d.toggleAttribute("data-on", j === i));
    };
    csTrack.addEventListener("scroll", sync, { passive: true });
  }

  // FAQ on phones: the rest of the questions on demand.
  const faqAll = document.querySelector<HTMLButtonElement>("[data-faq-all]");
  faqAll?.addEventListener("click", () => {
    faqAll.closest("[data-faq-list]")?.setAttribute("data-all", "");
    faqAll.setAttribute("aria-expanded", "true");
    faqAll.hidden = true;
  });

  // The reviews' slow loop (see marquee.ts).
  const reviews = document.querySelector<HTMLElement>("[data-reviews]");
  const reviewsTrack = reviews?.querySelector<HTMLElement>("[data-reviews-track]");
  const reviewsPause = reviews?.querySelector<HTMLButtonElement>("[data-reviews-pause]");
  if (reviews && reviewsTrack && reviewsPause && window.innerWidth >= 768) initMarquee(reviews, reviewsTrack, reviewsPause);
</script>

---
import Nav from "~/components/Nav.astro";
import HomeHero from "~/components/HomeHero.astro";
import Approach from "~/components/Approach.astro";
import HomeSections from "~/components/HomeSections.astro";
import CTA from "~/components/CTA.astro";
import IntroBlueprint from "~/components/IntroBlueprint.astro";
import type { Lang } from "~/i18n/ui";

// Shared body of the home page, rendered identically for both locales. Only
// the language + the alternate-language link differ — passed in by the thin
// index.astro / en/index.astro page wrappers (which own the BaseLayout shell).
interface Props {
  lang: Lang;
  altLang: Lang;
  altLangPath: string;
}

const { lang, altLang, altLangPath } = Astro.props;
const fr = lang === "fr";
---

  <IntroBlueprint />
  <Nav lang={lang} altLang={altLang} altLangPath={altLangPath} />
  <main id="main-content">
    {/* The theatre: the scroll sequences (the hero's dive, then section 2)
        play as layers of one screen that stays stuck while the spacer
        scrolls by, one layer shown at a time (home-seq.ts directs them).
        Without the sequences (no JS, reduced motion) the two sections
        simply follow each other. */}
    <div data-theatre-wrap>
      <div data-theatre>
        <HomeHero lang={lang} />
        <Approach lang={lang} />
        {/* The hint to scroll on, where the sequences wait on the scroll. */}
        <div class="seq-hint" data-seq-hint aria-hidden="true">
          <span class="seq-hint-track"></span>
          <span data-label="hero">{fr ? "Faites défiler" : "Scroll down"}</span>
          <span data-label="approach">{fr ? "Continuez à défiler" : "Keep scrolling"}</span>
        </div>
      </div>
      <div data-theatre-spacer aria-hidden="true"></div>
    </div>
    <HomeSections lang={lang} />
    <CTA lang={lang} />
  </main>

  <script>
    import { startHome } from "~/lib/home-seq";
    import { initReveal } from "~/lib/reveal";
    initReveal();
    startHome();
  </script>

<style is:global>
  /* ===== The theatre ===== Only once the sequences are on (data-seq="on"
     on the wrapper). One box as tall as the screen at its tallest (100lvh:
     the phone toolbars coming and going don't resize it), stuck for the
     whole spacer: the browser keeps it on screen by itself, however fast
     the page scrolls, so a late frame only ever shows a slightly old frame
     of the right scene, never the page under it. The layers sit on top of
     each other in it; only the one marked data-on is shown. */
  [data-theatre-spacer] {
    display: none;
  }
  [data-theatre-wrap][data-seq="on"] {
    overflow-anchor: none; /* the spacer changes size: the page must not follow it */
  }
  [data-theatre-wrap][data-seq="on"] > [data-theatre-spacer] {
    display: block;
  }
  [data-theatre-wrap][data-seq="on"] > [data-theatre] {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    overflow: clip;
  }
  [data-theatre-wrap][data-seq="on"] [data-theatre] > section {
    position: absolute;
    inset: 0;
  }
  /* (At the sequences' end, data-seq-rest, the layer shown hides the others
     by itself: they stay visible under it, in the page for assistive tech.) */
  [data-theatre-wrap][data-seq="on"]:not([data-seq-rest]) [data-theatre] > section:not([data-on]) {
    visibility: hidden;
  }
  /* The hero: down to the foot of the screen with its toolbars showing
     (100svh), so its logos are never under them; its dots cover the rest
     (HeroDots.astro). */
  [data-theatre-wrap][data-seq="on"] [data-theatre] > [data-home-hero] {
    z-index: 0;
    inset: 0 0 auto;
    height: 100svh;
  }
  /* Section 2: the whole box; on phones its content slides up inside it.
     Opaque: at the end the hero is left visible under it. */
  [data-theatre-wrap][data-seq="on"] [data-theatre] > [data-approach] {
    z-index: 1;
    overflow: hidden;
    overflow: clip;
    background: var(--color-bg);
  }
  /* Projets, on wide screens where it holds in one screen (moved in here by
     the sequence): its content centred as in the page (.work), clear of the
     nav. */
  [data-theatre-wrap][data-seq="on"] [data-theatre] > [data-work] {
    z-index: 2;
    padding-top: 88px;
    padding-bottom: 40px;
  }
  /* The hint to scroll on (home-seq.ts shows it once the reader has been
     still where the sequences wait on the scroll): centred at the foot of
     the screen with its toolbars showing, under the hero's logos, on a wash
     of the page that keeps it clear of the dots. Only with the theatre. */
  .seq-hint {
    display: none;
  }
  [data-theatre-wrap][data-seq="on"] .seq-hint {
    position: absolute;
    z-index: 3;
    top: calc(100svh - 48px);
    left: 50%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    opacity: 0;
    transform: translate(-50%, 6px);
    transition:
      opacity 0.25s,
      transform 0.25s;
    pointer-events: none;
  }
  [data-theatre-wrap][data-seq="on"] .seq-hint[data-show] {
    opacity: 1;
    transform: translate(-50%, 0);
    transition-duration: 0.8s;
    transition-timing-function: var(--ease-power3);
  }
  .seq-hint[data-step="approach"] [data-label="hero"],
  .seq-hint:not([data-step="approach"]) [data-label="approach"] {
    display: none;
  }
  /* Its sign: a dot running down a short line, as the page will. */
  .seq-hint-track {
    position: relative;
    width: 1px;
    height: 22px;
    background: color-mix(in srgb, currentColor 30%, transparent);
  }
  .seq-hint-track::after {
    content: "";
    position: absolute;
    top: 0;
    left: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: seq-hint 1.8s var(--ease-power3) infinite;
  }
  @keyframes seq-hint {
    0% {
      opacity: 0;
      transform: translateY(-2px);
    }
    20% {
      opacity: 1;
    }
    70% {
      opacity: 1;
      transform: translateY(19px);
    }
    100% {
      opacity: 0;
      transform: translateY(19px);
    }
  }
  /* On phones closer to the foot (the hero's logos are lower there), and
     above the action bar once it is up (MobileBar.astro). */
  @media (max-width: 767px) {
    [data-theatre-wrap][data-seq="on"] .seq-hint {
      top: calc(100svh - 38px);
    }
    :root:has([data-mobile-bar][data-visible="true"]) [data-theatre-wrap][data-seq="on"] .seq-hint {
      top: calc(100svh - 38px - 72px - env(safe-area-inset-bottom));
    }
  }
</style>

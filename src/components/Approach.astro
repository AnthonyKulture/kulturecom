---
// Section 2 of the home, the four services: the theatre's second layer
// (HomeContent.astro), right after the hero's dive.
import type { Lang } from "~/i18n/ui";
import { getHomeContent } from "~/lib/home-content";
import { servicePagePath } from "~/lib/service-pages";
import { fromPrice } from "~/lib/facts";
import Eyebrow from "~/components/Eyebrow.astro";
import WaterfallDots from "~/components/WaterfallDots.astro";
import WaterfallScene from "~/components/WaterfallScene.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getHomeContent(lang);
const sheet = (n: string, fr: string, en: string): string => (lang === "fr" ? `Planche ${n} · ${fr}` : `Sheet ${n} · ${en}`);
---

{/* The four services — the waterfall drawing on the right, one row per
    service on the left (its word facing its line, its starting price and a
    button to its page; the whole row is the link). A scroll sequence
    (WaterfallDots.astro), played in the theatre where the hero's dive ended:
    it opens inside the hiker's backpack, pulls back to the waterfall, then
    the text comes in, each of the three words condensing out of vapor as
    it does (data-vapor-seq: the sequence starts them, not VaporTitles; on
    phones they are plain words);
    last the water rises from the bottom in dots and fills the screen with
    the blue of the projects below. Without the sequence it is a plain
    section in the page. */}
<section class="relative px-4 py-20 sm:px-6 md:px-12 md:py-32" data-approach>
  <WaterfallDots />
  <canvas class="flood" data-flood aria-hidden="true"></canvas>
  <div class="relative z-[1] mx-auto w-full max-w-[var(--container-wide)]" data-approach-content>
    <div data-seq-item>
      <Eyebrow label={sheet("01", "Services", "Services")} class="mb-6 md:mb-8" />
    </div>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <figure class="approach-visual lg:order-2" aria-hidden="true">
        <WaterfallScene />
      </figure>
      <div>
        <h2 data-seq-item class="max-w-[24ch] font-display text-title">{c.servicesTitle}</h2>
        <ol class="services mt-8 md:mt-10">
          {c.services.map((sv) => (
            <li data-seq-item>
              <a href={servicePagePath(sv.id, lang)} class="service">
                <span class="service-head">
                  <span class="service-word font-display text-[var(--color-accent)]" data-vapor-seq>{sv.word}</span>
                  <span class="service-price">{fromPrice(sv.id, lang)}</span>
                </span>
                <span class="service-body text-body text-[var(--color-ink-muted)]">{sv.body}</span>
                <span class="service-btn">{c.servicesCta}<span aria-hidden="true" class="service-arrow">→</span></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* ===== Scroll sequence ===== A layer of the theatre while it plays
     (HomeContent.astro; data-seq="on" on its wrapper). Wide screens: the
     section holds in one screen, its content centred, the drawing no taller
     than the screen allows. */
  @media (min-width: 1024px) {
    :global([data-theatre-wrap][data-seq="on"]) [data-approach] {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      padding-top: 80px;
      padding-bottom: 48px;
    }
    :global([data-theatre-wrap][data-seq="on"]) .approach-visual {
      max-width: calc((100svh - 200px) * 600 / 680);
    }
  }
  /* The water rising at the end of the sequence, in dots (WaterfallDots.astro
     draws it): over everything in the section, in the projects' blue. The
     screen's size, as the theatre (a height in % comes out short of it in
     Safari, the section's padding off). */
  .flood {
    display: none;
  }
  :global([data-theatre-wrap][data-seq="on"]) .flood {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    color: var(--color-accent);
    pointer-events: none;
  }
  /* On phones the drawing sits above the text, not too tall. */
  .approach-visual {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .approach-visual {
      max-width: none;
    }
  }
  /* ===== The services ===== One row per service, the whole row a link:
     the word (the hero title's display size) facing its line, its starting
     price and its button. Phones: the word above the rest. */
  .service {
    position: relative;
    display: grid;
    grid-template-areas: "head" "body" "btn";
    justify-items: start;
    gap: 10px;
    padding: 18px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    color: inherit;
    text-decoration: none;
    isolation: isolate;
  }
  .services li:last-child .service {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  /* Tablets: the word and its price facing the line and the button. */
  @media (min-width: 640px) {
    .service {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-areas: "head body" "head btn";
      align-items: center;
      column-gap: 32px;
      row-gap: 12px;
      padding: 20px 0;
    }
  }
  /* Wide screens (half the page): all on one row, the button at its end. */
  @media (min-width: 1024px) {
    .service {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) auto;
      grid-template-areas: "head body btn";
      column-gap: 24px;
      padding: 18px 0;
    }
  }
  .service-head {
    grid-area: head;
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
  }
  @media (min-width: 640px) {
    .service-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .service-body {
    grid-area: body;
  }
  .service-btn {
    grid-area: btn;
  }
  /* A wash of the accent sweeping in under the row on hover. */
  .service::before {
    content: "";
    position: absolute;
    inset: 0 -16px;
    z-index: -1;
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-power3);
  }
  .service :global(.service-word) {
    display: inline-block;
    font-size: var(--text-display);
    line-height: 1;
    transition: transform 0.5s var(--ease-power3);
  }
  .service-price {
    font-family: var(--font-label);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .service-btn {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 14px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    font-size: 14px;
    font-weight: 500;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      color 0.3s;
  }
  .service-arrow {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    transition: transform 0.4s var(--ease-power3);
  }
  .service:hover::before,
  .service:focus-visible::before {
    transform: scaleX(1);
  }
  .service:hover :global(.service-word),
  .service:focus-visible :global(.service-word) {
    transform: translateX(8px);
  }
  .service:hover .service-btn,
  .service:focus-visible .service-btn {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #ffffff;
  }
  .service:hover .service-arrow,
  .service:focus-visible .service-arrow {
    transform: translateX(3px);
  }
  .service:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .service::before,
    .service :global(.service-word),
    .service-arrow {
      transition: none;
    }
  }
</style>

---
// Arrow cursor that turns toward where it moves (native take on React Bits'
// Gyroscope Cursor). The tip sits exactly on the pointer; only the heading is
// eased. Mouse-only and off under prefers-reduced-motion: the native cursor
// stays in every other case.
---

<div class="gyro-cursor" data-gyro-cursor aria-hidden="true">
  {/* Points along +x, tip at the origin, so rotate(angle) = heading. */}
  <svg width="26" height="26" viewBox="-24 -13 26 26">
    <path d="M0 0 L-20 -10 L-15 0 L-20 10 Z" />
  </svg>
</div>

<style>
  .gyro-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2147483647;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: transform;
  }
  .gyro-cursor svg {
    display: block;
    /* Put the arrow tip (viewBox origin) on the element's origin. */
    transform: rotate(-135deg) translate(-24px, -13px);
    transform-origin: 0 0;
    overflow: visible;
  }
  .gyro-cursor path {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .gyro-cursor[data-visible="true"] {
    opacity: 1;
  }
  :global(html.has-gyro-cursor),
  :global(html.has-gyro-cursor *) {
    cursor: none !important;
  }
  /* Text fields keep the native text cursor (the arrow hides meanwhile). */
  :global(html.has-gyro-cursor :is(input, textarea, select)) {
    cursor: auto !important;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>("[data-gyro-cursor]");
  const enabled =
    matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && enabled) {
    const svg = el.querySelector("svg")!;
    const REST = (-135 * Math.PI) / 180; // classic up-left cursor
    let x = 0;
    let y = 0;
    let angle = REST;
    let target = REST;
    let raf = 0;

    const render = () => {
      // Shortest way round, eased.
      let delta = target - angle;
      delta = Math.atan2(Math.sin(delta), Math.cos(delta));
      angle += delta * 0.18;
      el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      svg.style.transform = `rotate(${angle}rad) translate(-24px, -13px)`;
      raf = Math.abs(delta) > 0.001 ? requestAnimationFrame(render) : 0;
    };

    addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        const dx = e.clientX - x;
        const dy = e.clientY - y;
        // Ignore sub-pixel jitter so the heading doesn't flicker.
        if (el.dataset.visible === "true" && dx * dx + dy * dy > 4) target = Math.atan2(dy, dx);
        x = e.clientX;
        y = e.clientY;
        el.dataset.visible = (e.target as Element).closest?.("input, textarea, select") ? "false" : "true";
        if (!raf) raf = requestAnimationFrame(render);
      },
      { passive: true },
    );
    document.documentElement.addEventListener("mouseleave", () => {
      el.dataset.visible = "false";
    });

    document.documentElement.classList.add("has-gyro-cursor");
  }
</script>

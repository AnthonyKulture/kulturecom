---
// RGPD/CNIL consent banner. Shown until the visitor accepts or declines; the
// choice is stored in localStorage ('ap-consent-2': 'ap-consent' only covered
// audience measurement, so earlier visitors are asked again). "Accept" calls
// Consent Mode v2 update → audience and ad measurement granted (GA4 and the
// Google Ads click cookie), ad personalization stays denied; "Decline" keeps
// it all denied (GA4 stays cookieless). Pairs with Analytics.astro.
// On the home it waits for the first scroll (or a few seconds): the first
// screen, its client logos included, is seen clear, and the banner comes as
// the hero clears away. Nothing is measured with cookies before a choice
// either way, and refusing stays as easy as accepting (CNIL).
import type { Lang } from "~/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t =
  lang === "fr"
    ? {
        text: "Ce site utilise des cookies (Google Analytics, Google Ads) pour mesurer son audience et ses publicités.",
        accept: "Accepter",
        decline: "Refuser",
        privacy: "En savoir plus",
        privacyHref: "/confidentialite/",
        aria: "Consentement aux cookies",
      }
    : {
        text: "This site uses cookies (Google Analytics, Google Ads) to measure its traffic and its ads.",
        accept: "Accept",
        decline: "Decline",
        privacy: "Learn more",
        privacyHref: "/en/privacy/",
        aria: "Cookie consent",
      };
---

<div
  data-consent-banner
  hidden
  role="region"
  aria-label={t.aria}
  class="consent fixed bottom-[calc(10px+env(safe-area-inset-bottom))] left-[10px] right-[10px] z-[90] mx-auto max-w-[var(--container-wide)] border border-[var(--color-ink)]/15 bg-[var(--color-bg)] px-4 py-3 text-[var(--color-ink)] shadow-[0_12px_32px_-12px_rgba(13,27,22,0.22)] sm:bottom-5 sm:left-auto sm:right-5 sm:max-w-[420px] sm:px-5 sm:py-5 sm:shadow-[0_8px_40px_rgba(0,0,0,0.12)]"
>
  {/* Mobile: a compact card floating just above the bottom edge (~105 px),
      like the action bar it stands in for, so it doesn't cover the service
      pages' above-the-fold CTA. ≥ 640px keeps the corner card. */}
  <p class="text-[13px] leading-[1.45] text-[var(--color-ink)]/85 sm:text-[14px] sm:leading-[1.5]">
    {t.text}{" "}
    <a
      href={t.privacyHref}
      class="underline underline-offset-2 hover:text-[var(--color-accent)]"
      >{t.privacy}</a
    >
  </p>
  <div class="mt-2.5 flex items-center gap-3 sm:mt-4">
    <button
      type="button"
      data-consent-accept
      class="btn btn-primary btn-sm"
      >{t.accept}</button
    >
    <button
      type="button"
      data-consent-decline
      class="font-label inline-flex items-center px-2 py-2.5 text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink)]/70 underline underline-offset-4 transition-colors duration-200 hover:text-[var(--color-ink)]"
      >{t.decline}</button
    >
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "ap-consent-2";
    var el = document.querySelector("[data-consent-banner]");
    if (!el) return;
    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}
    if (stored !== "granted" && stored !== "denied") {
      if (document.querySelector("[data-home-hero]") && window.scrollY < 40) {
        var timer = 0;
        var show = function () {
          if (window.scrollY < 40 && timer) return;
          clearTimeout(timer);
          window.removeEventListener("scroll", show);
          el.hidden = false;
        };
        window.addEventListener("scroll", show, { passive: true });
        timer = setTimeout(function () {
          timer = 0;
          show();
        }, 8000);
      } else el.hidden = false;
    }

    function choose(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
      if (value === "granted" && typeof window.gtag === "function") {
        window.gtag("consent", "update", { analytics_storage: "granted", ad_storage: "granted", ad_user_data: "granted" });
      }
      el.hidden = true;
    }

    var accept = el.querySelector("[data-consent-accept]");
    var decline = el.querySelector("[data-consent-decline]");
    if (accept) accept.addEventListener("click", function () { choose("granted"); });
    if (decline) decline.addEventListener("click", function () { choose("denied"); });
  })();
</script>

<style>
  .consent:not([hidden]) {
    animation: consent-in 0.5s var(--ease-power3) both;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent:not([hidden]) {
      animation: none;
    }
  }
</style>

---
// Google Analytics 4 (gtag.js) with Consent Mode v2 — loaded site-wide from
// BaseLayout <head>.
//
// RGPD/CNIL: consent defaults to `denied`, so NO analytics cookies are set
// until the visitor accepts via the banner (Consent.astro). Until then GA4
// runs in cookieless mode. A prior "granted" choice (localStorage) is restored
// before the first hit. The banner calls gtag('consent','update',…).
//
// is:inline keeps Astro from bundling/hoisting these — gtag must run as-is.
---
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W64W3JKY43" is:inline></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  // Consent Mode v2 — deny by default (RGPD/CNIL).
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500,
  });
  // Restore a previously granted choice before the first measurement hit.
  try {
    if (localStorage.getItem('ap-consent') === 'granted') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
  } catch (e) {}
  // Measure the live site only: localhost (dev, astro preview) and other
  // hosts polluted the GA4 data.
  if (location.hostname !== 'anthonyprofit.com') window['ga-disable-G-W64W3JKY43'] = true;
  gtag('js', new Date());
  gtag('config', 'G-W64W3JKY43');

  // First-touch campaign data for this session, sent along with each form /
  // callback lead (src/lib/lead-form.ts) so a lead can be traced to ChatGPT
  // Ads (utm_*, oppref), ChatGPT search (utm_source=chatgpt.com), Google…
  try {
    if (!sessionStorage.getItem('ap-attrib')) {
      var q = new URLSearchParams(location.search);
      var attrib = { landing: location.pathname };
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'oppref', 'gclid'].forEach(function (k) {
        var v = q.get(k);
        if (v) attrib[k] = v.slice(0, 120);
      });
      if (document.referrer && document.referrer.indexOf(location.origin) !== 0) {
        attrib.referrer = document.referrer.slice(0, 200);
      }
      sessionStorage.setItem('ap-attrib', JSON.stringify(attrib));
    }
  } catch (e) {}

  // Lead conversions. A sent form or callback request fires `generate_lead`
  // from lead-form.ts; a click on an e-mail, WhatsApp or phone link counts too.
  // GA4's recommended event (mark it as a key event) so it is attributed to its
  // campaign, e.g. ChatGPT Ads with utm_source=chatgpt. Only the channel is
  // sent, never the address/number (no PII in GA4). Clicks on the home
  // "doors" are tracked as `select_door` to see which needs dominate.
  document.addEventListener('click', function (e) {
    var door = e.target && e.target.closest ? e.target.closest('[data-door]') : null;
    if (door) gtag('event', 'select_door', { door: door.getAttribute('data-door') });
    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
    if (!a) return;
    var href = a.getAttribute('href') || '';
    // Cloudflare "Email Address Obfuscation" rewrites mailto: links to
    // /cdn-cgi/l/email-protection#… — count those as e-mail too.
    var method =
      href.indexOf('mailto:') === 0 || href.indexOf('/cdn-cgi/l/email-protection') === 0 ? 'email'
      : href.indexOf('https://wa.me/') === 0 ? 'whatsapp'
      : href.indexOf('tel:') === 0 ? 'phone'
      : '';
    if (method) gtag('event', 'generate_lead', { method: method });
  });
</script>

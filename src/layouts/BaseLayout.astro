---
import "~/styles/global.css";
import Footer from "~/components/Footer.astro";
import Analytics from "~/components/Analytics.astro";
import Consent from "~/components/Consent.astro";
import MobileBar from "~/components/MobileBar.astro";
import CallbackDialog from "~/components/CallbackDialog.astro";
import GyroscopeCursor from "~/components/GyroscopeCursor.astro";
import VaporTitles from "~/components/VaporTitles.astro";
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import { getRoute } from "~/i18n/routes";
import { SERVICE_PAGES } from "~/lib/service-pages";
import { GOOGLE_PROFILE, PRICE, STARTING_PRICE, formatPrice } from "~/lib/facts";
import { caseStudyPath } from "~/lib/case-studies";
import { AREA_SERVED } from "~/lib/schema";

interface Props {
  lang: Lang;
  pathname?: string;
  // Per-page overrides. When omitted, they resolve from the central route map
  // (src/i18n/routes.ts) and fall back to the site-wide i18n defaults.
  title?: string;
  description?: string;
  // hreflang counterpart URL. Resolved from routes.ts by `pathname`; the
  // prefix-swap default below is only a last resort for unlisted routes.
  // Pass `null` to declare NO counterpart (e.g. an untranslated blog post or a
  // tag archive) — the alt-lang hreflang line is then omitted entirely.
  altPath?: string | null;
  // Per-page social image (og:image / twitter:image). Defaults to /og.png.
  // Blog posts pass their cover here so shares use the article image.
  ogImage?: string;
  // Emit <meta name="robots" content="noindex"> (used by the 404 pages).
  noindex?: boolean;
}

const {
  lang,
  pathname = "/",
  title,
  description,
  altPath: altPathProp,
  ogImage: ogImageProp,
  noindex = false,
} = Astro.props;
const dict = ui[lang];
const route = getRoute(pathname);

const pageTitle = title ?? route?.title ?? dict.meta.title;
const pageDescription =
  description ?? route?.description ?? dict.meta.description;

const altLang: Lang = lang === "fr" ? "en" : "fr";
// `altPath === null` means the page has no localized counterpart → skip the
// alt-lang hreflang link below (only self + x-default are emitted).
const hasCounterpart = altPathProp !== null;
const altPath =
  altPathProp ??
  route?.alt ??
  (altLang === "fr"
    ? pathname.replace(/^\/en/, "") || "/"
    : `/en${pathname === "/" ? "" : pathname}`);

const canonical = new URL(pathname, Astro.site).toString();
// x-default → the FR (default locale) version of this page; an EN page with no
// FR counterpart is its own default.
const xDefault =
  lang === "fr" || !hasCounterpart ? canonical : new URL(altPath, Astro.site).toString();
// 1200×630 PNG — renders on every platform (Facebook + LinkedIn included; SVG
// OG images don't). Rasterized from og.svg; see public/og.png.
const ogImage = new URL("/og.png", Astro.site).toString();
// Social/share image — a per-page override (e.g. a blog post cover) falls back
// to the site OG banner. The schema brand images keep using `ogImage`.
const socialImage = new URL(ogImageProp ?? "/og.png", Astro.site).toString();

// External profile URLs (also referenced in Footer.astro). These power the
// JSON-LD `sameAs` array for the Knowledge Graph.
const linkedinUrl = "https://www.linkedin.com/in/anthony-profit/";
const instagramUrl = "https://www.instagram.com/antho_profit/";
const behanceUrl = "https://www.behance.net/anthonyprofit";
// Google Business Profile (canonical CID URL) — powers the local entity link.
const gbpUrl = GOOGLE_PROFILE.url;

// Structured data — site entity graph (Person + ProfessionalService +
// WebSite) plus a per-route WebPage / BreadcrumbList (and an ItemList of real
// cases on the work page). One JSON-LD `@graph` so nodes cross-reference by @id.
const personId = `${Astro.site}#person`;
const serviceId = `${Astro.site}#service`;
const websiteId = `${Astro.site}#website`;
const homeUrl = new URL("/", Astro.site).toString();
const enHomeUrl = new URL("/en/", Astro.site).toString();
const githubUrl = "https://github.com/AnthonyKulture";

// Real client case studies — on the work page the ItemList points to OUR
// localized case-study pages (crawlable, citable); the client site lives in
// each case study's own schema. Names are stable across locales.
const PROJECT_CASES = [
  { name: "Surly", slug: "surly" },
  { name: "Eden Rock Yacht Rental", slug: "eden-rock-yacht-rental" },
  { name: "Sun Beach House", slug: "sun-beach-house" },
  { name: "Royal Yacht International", slug: "royal-yacht-international" },
  { name: "Vaulk", slug: "vaulk" },
];

const graph: Record<string, any>[] = [
  {
    "@type": "Person",
    "@id": personId,
    "name": "Anthony Profit",
    "url": Astro.site?.toString(),
    "image": new URL("/about/anthony-portrait.webp", Astro.site).toString(),
    "jobTitle": lang === "fr"
      ? "Freelance développeur web, apps & IA, SEO & brand designer"
      : "Freelance web developer, apps & AI, SEO & brand designer",
    "description": dict.meta.description,
    "knowsLanguage": ["fr", "en"],
    "knowsAbout": [
      "Web development",
      "Frontend engineering",
      "SEO",
      "Technical SEO",
      "Generative Engine Optimization",
      "Brand design",
      "Web and mobile applications",
      "AI integration",
      "Workflow automation",
      "ChatGPT Ads",
      "Astro",
      "React",
      "TypeScript",
    ],
    "sameAs": [linkedinUrl, instagramUrl, behanceUrl, githubUrl],
    "worksFor": { "@id": serviceId },
  },
  {
    // THE business entity (one node, not a separate Organization): it is the
    // publisher of the site and the blog, and the provider of the 4 services.
    // ProfessionalService is an Organization subtype, so it qualifies as an
    // Article publisher with its logo. Registry facts (SIREN, registration
    // date) are those already published on the legal notice page.
    "@type": "ProfessionalService",
    "@id": serviceId,
    "name": "Anthony Profit",
    "alternateName": "Kulturecom",
    "url": Astro.site?.toString(),
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/logo-512.png", Astro.site).toString(),
      "width": 512,
      "height": 512,
    },
    "image": ogImage,
    "description": dict.meta.description,
    "founder": { "@id": personId },
    "foundingDate": "2019-05-12",
    "identifier": { "@type": "PropertyValue", "propertyID": "SIREN", "value": "850723552" },
    "email": "contact@kulturecom.fr",
    "telephone": "+33 6 60 50 16 82",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "contact@kulturecom.fr",
      "telephone": "+33 6 60 50 16 82",
      "availableLanguage": ["fr", "en"],
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "2 rue Pierre Pietri",
      "addressLocality": "Nice",
      "postalCode": "06000",
      "addressRegion": "Provence-Alpes-Côte d'Azur",
      "addressCountry": "FR",
    },
    // Pin of the Google Business Profile.
    "geo": { "@type": "GeoCoordinates", "latitude": 43.7072786, "longitude": 7.2591778 },
    // Same hours as the Google Business Profile; change both together.
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "20:00",
    },
    // City-level areaServed sharpens relevance for "Nice"/"Côte d'Azur" queries
    // (LLMs + local pack score city entities higher than a bare Country).
    "areaServed": AREA_SERVED,
    // The 4 services, by the @id each service page gives its Service node
    // (localized URLs), so the business ↔ service link exists both ways.
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Services",
      "itemListElement": SERVICE_PAGES.map((s) => ({
        "@type": "Offer",
        "itemOffered": { "@id": `${new URL(s.path[lang], Astro.site)}#service` },
        // Entry price of the service ("dès X €"), same source as the pages.
        ...(STARTING_PRICE[s.id] !== undefined && {
          "priceSpecification": { "@type": "PriceSpecification", "minPrice": STARTING_PRICE[s.id], "priceCurrency": "EUR" },
        }),
      })),
    },
    // Real span of the published prices (entry offers), not a symbol.
    "priceRange": `${formatPrice(Math.min(...Object.values(PRICE)), lang)} – ${formatPrice(Math.max(...Object.values(PRICE)), lang)}`,
    "hasMap": gbpUrl,
    "sameAs": [gbpUrl, linkedinUrl, instagramUrl, behanceUrl, githubUrl],
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    "url": Astro.site?.toString(),
    "name": "Anthony Profit",
    "alternateName": "Kulturecom",
    "inLanguage": ["fr-FR", "en-US"],
    "publisher": { "@id": serviceId },
  },
];

// Per-route page node (+ breadcrumb, + project ItemList on the work page).
if (route?.pageType) {
  const webPageId = `${canonical}#webpage`;
  const webPage: Record<string, any> = {
    "@type": route.pageType,
    "@id": webPageId,
    "url": canonical,
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": { "@id": websiteId },
    "about": { "@id": personId },
    "inLanguage": lang === "fr" ? "fr-FR" : "en-US",
  };

  if (route.crumb) {
    const breadcrumbId = `${canonical}#breadcrumb`;
    graph.push({
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": lang === "fr" ? "Accueil" : "Home",
          "item": lang === "fr" ? homeUrl : enHomeUrl,
        },
        { "@type": "ListItem", "position": 2, "name": route.crumb, "item": canonical },
      ],
    });
    webPage.breadcrumb = { "@id": breadcrumbId };
  }

  if (route.pageType === "CollectionPage") {
    const itemListId = `${canonical}#projects`;
    graph.push({
      "@type": "ItemList",
      "@id": itemListId,
      "itemListElement": PROJECT_CASES.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": p.name,
        "url": new URL(caseStudyPath(p.slug, lang), Astro.site).toString(),
      })),
    });
    webPage.mainEntity = { "@id": itemListId };
  }

  graph.push(webPage);
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Favicons + brand theme color. `?v=` busts the 1-year immutable cache
         set on *.svg / *.png in public/_headers — bump it when the icons change. -->
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Google Analytics 4 -->
    <Analytics />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="author" content="Anthony Profit" />

    <link rel="canonical" href={canonical} />
    {/* hreflang: self + other lang + x-default. Google accepts just other+default,
        but emitting self too is the safer pattern for SERP signal consistency. */}
    <link rel="alternate" hreflang={lang} href={canonical} />
    {hasCounterpart && (
      <link rel="alternate" hreflang={altLang} href={new URL(altPath, Astro.site).toString()} />
    )}
    {/* x-default = the FR (default-locale) version of THIS page, not the home:
        it must stay inside the page's own hreflang cluster. */}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    {/* RSS autodiscovery — locale feed for the blog (src/pages/[en/]rss.xml.ts). */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Anthony Profit — Journal"
      href={new URL(lang === "fr" ? "/rss.xml" : "/en/rss.xml", Astro.site).toString()}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={dict.meta.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "fr" ? "en_US" : "fr_FR"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={dict.meta.ogImageAlt} />

    <!-- Structured data (JSON-LD) — Person + ProfessionalService + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/* Fonts are self-hosted (@font-face in global.css). Preload both faces
        (Urbanist headings, Geist text) so the first paint uses them without a
        third-party round trip. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/urbanist-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/geist-latin.woff2" />
  </head>
  <body>
    {/* Keyboard skip link (WCAG 2.4.1). Hidden until the user tabs to it.
        The visible `<main id="main-content">` target lives in each page. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-[var(--color-ink)] focus:px-4 focus:py-3 focus:font-label focus:text-[13px] focus:uppercase focus:tracking-[0.06em] focus:text-[var(--color-bg)] focus:no-underline focus:outline-2 focus:outline-offset-2 focus:outline-[var(--color-accent)]"
    >
      {lang === "en" ? "Skip to content" : "Aller au contenu"}
    </a>
    <slot />
    <Footer lang={lang} />
    <MobileBar lang={lang} />
    <CallbackDialog lang={lang} />
    <Consent lang={lang} />
    <GyroscopeCursor />
    <VaporTitles />
  </body>
</html>

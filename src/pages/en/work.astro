---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import Projects from "~/components/Projects.astro";
import ProjectsMobile from "~/components/ProjectsMobile.astro";
import CTA from "~/components/CTA.astro";

const lang = "en" as const;
---

<BaseLayout lang={lang} pathname="/en/work/" altPath="/projets/">
  <Nav lang={lang} altLang="fr" altLangPath="/projets/" />
  <main id="main-content" class="bg-[var(--color-bg)] text-[var(--color-ink)]">

    {/* ========== PAGE HERO ========== */}
    <section class="relative px-4 pt-32 pb-12 sm:px-6 sm:pt-40 sm:pb-16 md:px-12 md:pt-48 md:pb-20">
      <div class="mx-auto w-full max-w-[var(--container-wide)]">
        <p class="font-label mb-4 sheet-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
          <span class="sheet-diamond" aria-hidden="true"></span>
          <span>Work</span>
          <span class="sheet-leader" aria-hidden="true"></span>
        </p>
        <h1 data-vapor class="font-display text-[clamp(34px,4.4vw,60px)] leading-[1.08] tracking-[-0.04em] text-[var(--color-ink)]">
          <span class="block">Proof,</span>
          <span class="block text-[var(--color-ink)]/70">not promises.</span>
        </h1>
        <p class="font-lead mt-8 max-w-[44ch] text-[clamp(18px,1.5vw,21px)] leading-[1.5] text-[var(--color-ink)]">
          Seven projects taken end to end — design, code and SEO, from the first audit to ranking.
        </p>
      </div>
    </section>

    {/* ========== PROJECTS — the selection removed from the homepage screen-stack.
        Desktop = pinned gallery scrolled sideways (Projects.astro). Mobile =
        stacked detail list with fade-up reveal (ProjectsMobile.astro). One renders
        per breakpoint via hidden/sm:hidden, matching the homepage's split. ========== */}
    <div class="hidden sm:block">
      <Projects lang={lang} />
    </div>
    <div class="sm:hidden">
      <ProjectsMobile lang={lang} />
    </div>

    <CTA lang={lang} />
  </main>
</BaseLayout>

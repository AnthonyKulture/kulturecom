---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import type { Lang } from "~/i18n/ui";

const lang: Lang = "en";
---

<BaseLayout lang={lang} pathname="/en/404" noindex>
  <Nav lang={lang} altLang="fr" altLangPath="/" />
  <main
    id="main-content"
    class="relative flex min-h-[100dvh] flex-col items-start justify-center bg-[var(--color-bg)] px-4 py-24 text-[var(--color-ink)] sm:px-6 md:px-12"
  >
    <div class="mx-auto w-full max-w-[var(--container-wide)]">
      <p
        class="font-label mb-8 sheet-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]"
      >
          <span class="sheet-diamond" aria-hidden="true"></span>
          <span>Error · 404</span>
          <span class="sheet-leader" aria-hidden="true"></span>
        </p>

      <h1
        class="font-display text-[clamp(80px,18vw,260px)] leading-[0.85] tracking-[-0.04em] text-[var(--color-ink)]"
      >
        404
      </h1>

      <p
        class="font-lead mt-6 max-w-[44ch] text-[clamp(20px,3vw,36px)] leading-[1.25] text-[var(--color-ink)] sm:mt-10"
      >
        Page not found.
      </p>
      <p
        class="mt-3 max-w-[60ch] text-[clamp(17px,1.2vw,18px)] leading-[1.55] text-[var(--color-ink-muted)] sm:mt-5"
      >
        The link is broken, the page has moved, or it never existed. No worries —
        here's where to head next.
      </p>

      <ul class="mt-10 flex flex-col gap-2 sm:mt-14 sm:flex-row sm:gap-6">
        <li>
          <a
            href="/en/"
            class="btn btn-primary"
          >
            Back to home
            <span aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a
            href="/en/about/"
            class="btn btn-secondary"
          >
            About
            <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import BlogIndex from "~/components/blog/BlogIndex.astro";
import { getPosts } from "~/lib/blog";

const lang = "fr" as const;
const pathname = "/blog/";
const altPath = "/en/blog/";

const posts = await getPosts(lang);

const site = Astro.site;
const blogUrl = new URL(pathname, site).toString();

// Blog + nested BlogPosting list (ids match each post's own #article node).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": `${blogUrl}#blog`,
      name: "Guides SEO & GEO : Nice, Cannes, Monaco",
      url: blogUrl,
      inLanguage: "fr-FR",
      publisher: { "@id": `${site}#service` },
      blogPost: posts.map((p) => {
        const url = new URL(`/blog/${p.data.slug}/`, site).toString();
        return {
          "@type": "BlogPosting",
          "@id": `${url}#article`,
          headline: p.data.title,
          url,
          datePublished: p.data.pubDate.toISOString(),
        };
      }),
    },
  ],
};
---

<BaseLayout lang={lang} pathname={pathname} altPath={altPath}>
  <Nav lang={lang} altLang="en" altLangPath={altPath} />

  <BlogIndex lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>

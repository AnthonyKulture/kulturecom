---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Nav from "~/components/Nav.astro";
import CTA from "~/components/CTA.astro";
import AboutHero from "~/components/AboutHero.astro";
import IntroBlueprint from "~/components/IntroBlueprint.astro";

const lang = "fr" as const;

const stack = [
  {
    label: "01",
    title: "Design",
    href: "/identite-de-marque/",
    items: [
      "Figma + Design tokens",
      "Direction artistique éditoriale",
      "Identité visuelle + brand systems",
      "Typographie + grilles",
    ],
  },
  {
    label: "02",
    title: "Code",
    href: "/creation-site-internet/",
    items: [
      "Astro, React, TypeScript",
      "Tailwind CSS v4",
      "GSAP + ScrollTrigger",
      "Headless CMS (Sanity, Storyblok)",
      "Vercel, Cloudflare",
    ],
  },
  {
    label: "03",
    title: "SEO",
    href: "/seo-geo/",
    items: [
      "Search Console + Ahrefs",
      "Audit technique + Core Web Vitals",
      "Schema.org + AI search readiness",
      "Content cluster + on-page",
      "GA4 + tracking server-side",
      "ChatGPT Ads + suivi des conversions",
    ],
  },
  {
    label: "04",
    title: "Apps & IA",
    href: "/outils-applications-ia/",
    items: [
      "API Claude / OpenAI (LLM, RAG)",
      "Next.js, React, Node",
      "Supabase / PostgreSQL",
      "n8n, Make, Zapier",
      "Apps mobiles iOS / Android",
    ],
  },
];

const process = [
  {
    n: "01",
    title: "Audit",
    body: "Une semaine pour comprendre votre marché, votre site actuel, vos signaux SEO et votre vraie cible. Pas de devis sans cette étape.",
  },
  {
    n: "02",
    title: "Stratégie",
    body: "Cadrage écrit : positionnement, hiérarchie des pages, mots-clés ciblés, KPIs à 3/6/12 mois. Vous validez avant qu'une ligne soit dessinée.",
  },
  {
    n: "03",
    title: "Design",
    body: "Maquettes haute-fidélité Figma. Itérations rapides sur Loom. Pas de wireframes basse-fi qui retardent la décision.",
  },
  {
    n: "04",
    title: "Build",
    body: "Astro + React, performance-first. Lighthouse ≥ 95, accessibilité WCAG AA. Tout le code vous appartient à la livraison.",
  },
  {
    n: "05",
    title: "Ship & mesure",
    body: "Mise en ligne, Search Console branchée, tracking validé. Suivi 30 jours inclus. Optimisation continue en option (retainer mensuel).",
  },
];

const refuse = [
  "Templates Webflow recyclés vendus comme du sur-mesure.",
  "SEO black-hat, link farms, content scraping.",
  "« Refonte » sans audit préalable.",
  "Sites lourds qui chargent en 4 secondes.",
  "Devis chiffrés sans brief écrit.",
  "Engagement long sans phase d'essai.",
];
---

<BaseLayout lang={lang} pathname="/a-propos/">
  <IntroBlueprint />
  <Nav lang={lang} altLang="en" altLangPath="/en/about/" />
  <main id="main-content" class="bg-[var(--color-bg)] text-[var(--color-ink)]">

    <AboutHero lang={lang} />

    <!-- ========== STORY (dark band) ========== -->
    <section data-surface="tint" class="relative bg-[var(--color-bg)] text-[var(--color-ink)] px-4 py-24 sm:px-6 sm:py-32 md:px-12 md:py-40">
      <div class="mx-auto w-full max-w-[68ch]">
        <p class="font-label mb-6 sheet-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
          <span class="sheet-diamond" aria-hidden="true"></span>
          <span>Parcours</span>
          <span class="sheet-leader" aria-hidden="true"></span>
        </p>
        <div class="font-sans space-y-6 text-[clamp(16px,1.3vw,20px)] leading-[1.7] text-[var(--color-ink)]">
          <p>
            J'ai commencé en agence digitale, j'ai vu trop de projets sortir cassés parce que trois équipes (brand, dev, SEO) se passaient des fichiers sans jamais se parler. En 2018, j'ai décidé de faire les trois moi-même. Pas pour être polyvalent — pour <em class="font-lead">supprimer les friction points</em> entre les disciplines.
          </p>
          <p>
            Depuis, je travaille en solo avec un objectif simple : <strong class="font-medium text-[var(--color-ink)]">votre marque doit être trouvée, comprise, et préférée</strong>. La forme (design), la mécanique (code) et la visibilité (SEO) sont trois faces d'un même problème. Je les traite ensemble parce que les séparer coûte plus cher au client qu'à moi.
          </p>
          <p>
            Je travaille avec des <strong class="font-medium text-[var(--color-ink)]">PME en croissance, des marques B2B techniques, et des fondateurs qui prennent l'image au sérieux</strong>. Je ne prends pas de projets « refonte cosmétique » sans repenser la structure SEO. Je n'ai jamais utilisé un template Webflow et je n'ai pas l'intention de commencer.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== STACK (3 columns) ========== -->
    <section class="relative bg-[var(--color-bg)] px-4 py-24 sm:px-6 sm:py-32 md:px-12 md:py-40">
      <div class="mx-auto w-full max-w-[var(--container-wide)]">
        <header class="mb-12 sm:mb-16">
          <p class="font-label mb-3 sheet-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
          <span class="sheet-diamond" aria-hidden="true"></span>
          <span>Stack</span>
          <span class="sheet-leader" aria-hidden="true"></span>
        </p>
          <h2 class="font-display text-[clamp(26px,2.8vw,40px)] leading-[1.15] tracking-[-0.04em] text-[var(--color-ink)]">
            Quatre axes, <br />outils alignés.
          </h2>
        </header>

        <div class="grid gap-10 md:grid-cols-2 md:gap-12 lg:grid-cols-4">
          {
            stack.map((s) => (
              <article class="border-t border-[var(--color-border)] pt-6">
                <span class="font-label block text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-subtle)]">
                  {s.label}
                </span>
                <h3 class="font-sans mt-2 text-[clamp(22px,2.5vw,32px)] font-medium tracking-normal text-[var(--color-ink)]">
                  <a href={s.href} class="no-underline hover:text-[var(--color-accent)]">{s.title}</a>
                </h3>
                <ul class="mt-6 space-y-2 text-[clamp(17px,1.1vw,18px)] text-[var(--color-ink-muted)]">
                  {s.items.map((item) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="font-label shrink-0 pt-0.5 text-[13px] text-[var(--color-accent)]">→</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== PROCESS (numbered narrative) ========== -->
    <section data-surface="tint" class="relative bg-[var(--color-bg)] text-[var(--color-ink)] px-4 py-24 sm:px-6 sm:py-32 md:px-12 md:py-40">
      <div class="mx-auto w-full max-w-[var(--container-wide)]">
        <header class="mb-16 sm:mb-20">
          <p class="font-label mb-3 sheet-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
          <span class="sheet-diamond" aria-hidden="true"></span>
          <span>Process</span>
          <span class="sheet-leader" aria-hidden="true"></span>
        </p>
          <h2 class="font-display text-[clamp(26px,2.8vw,40px)] leading-[1.15] tracking-[-0.04em] text-[var(--color-ink)]">
            Cinq étapes, <br />zéro surprise.
          </h2>
        </header>

        <ol class="flex flex-col gap-12 sm:gap-16">
          {
            process.map((step) => (
              <li class="grid grid-cols-1 gap-4 border-t border-[var(--color-border)] pt-8 sm:grid-cols-[140px_1fr] sm:gap-12">
                <span class="font-display text-[clamp(48px,5vw,80px)] leading-none tracking-[-0.04em] text-[var(--color-accent)]">
                  {step.n}
                </span>
                <div>
                  <h3 class="font-sans text-[clamp(20px,2.2vw,28px)] font-medium tracking-normal text-[var(--color-ink)]">
                    {step.title}
                  </h3>
                  <p class="mt-3 max-w-[60ch] text-[clamp(17px,1.2vw,18px)] leading-[1.65] text-[var(--color-ink-muted)]">
                    {step.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ========== REFUS / ANTI-CREDO ========== -->
    <section class="relative bg-[var(--color-bg)] px-4 py-24 sm:px-6 sm:py-32 md:px-12 md:py-40">
      <div class="mx-auto w-full max-w-[var(--container-wide)]">
        <header class="mb-12 sm:mb-16">
          <p class="font-label mb-3 sheet-label text-[13px] uppercase tracking-[0.06em] text-[var(--color-ink-muted)]">
          <span class="sheet-diamond" aria-hidden="true"></span>
          <span>Ce que je refuse</span>
          <span class="sheet-leader" aria-hidden="true"></span>
        </p>
          <h2 class="font-display text-[clamp(26px,2.8vw,40px)] leading-[1.15] tracking-[-0.04em] text-[var(--color-ink)]">
            Six lignes <br />à ne pas franchir.
          </h2>
        </header>

        <ul class="font-display flex flex-col">
          {
            refuse.map((line, i) => (
              <li class="flex items-start gap-4 border-t border-[var(--color-border)] py-6 font-display text-[clamp(20px,2.4vw,36px)] font-medium leading-[1.2] text-[var(--color-ink)] sm:gap-8 sm:py-8">
                <span class="font-label shrink-0 pt-2 text-[13px] tracking-[0.06em] text-[var(--color-ink-subtle)]">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Contact — the same section as the home / contact page, for a consistent
        text + visual treatment across the site (replaces the old mini-CTA). */}
    <CTA lang={lang} />

  </main>
</BaseLayout>
